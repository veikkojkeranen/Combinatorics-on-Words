Cell[TextData[{
 "Windows ",
 StyleBox["TDR",
  FontWeight->"Bold"],
 " (Timeout Detection and Recovery) is a feature that detects when your \
graphics card hangs during intensive tasks (like gaming or rendering) and \
resets the driver instead of crashing the whole system. \nGemini 3: (*Drop \
batch size to 500 to protect against Windows TDR*)"
}], "Text",
 CellChangeTimes->{{3.9930347804389877`*^9, 3.9930347865164146`*^9}, {
  3.9930348237839813`*^9, 
  3.99303483985845*^9}},ExpressionUUID->"fb77ce1f-02c7-4d45-a367-\
8f7d8575ac6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Isolate", " ", "the", " ", "undecided", " ", "words", " ", 
    "from", " ", "your", " ", "previous", " ", "run"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"undecidedWords", "=", 
     RowBox[{"finalReport", "[", "\"\<GlobalUndecided\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Set", " ", "up", " ", "a", " ", "dedicated", " ", "output", " ",
      "folder", " ", "for", " ", "this", " ", "cleanup", " ", "phase"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "cleanupOutputDir", 
     "=", "\"\<D:\\\\ExtremeMathMmaComputations\\\\aa2fr_3let_len40_ex60ms10M_\
Extendable_Nex_Und\\\\aa2fr_3let_len40_ex30_CLEANUP\>\""}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Run", " ", "with", " ", "high", " ", "maxSteps", " ", 
     RowBox[{"(", 
      RowBox[{"2", " ", "Million"}], ")"}], " ", "and", " ", "small", " ", 
     "batchSize", " ", 
     RowBox[{"(", "500", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  LAUNCHING TARGETED CLEANUP FOR UNDECIDED WORDS\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Processing: \>\"", ",", 
      RowBox[{"Length", "[", "undecidedWords", "]"}], 
      ",", "\"\< stubborn words\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"cleanupTime", ",", "cleanupReport"}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"aa2fSolveInBatches", "[", 
       RowBox[{"undecidedWords", ",", "30", ",", 
        RowBox[{"(*", 
         RowBox[{
         "Keep", " ", "extension", " ", "bound", " ", "at", " ", "30", " ", 
          "to", " ", "finish", " ", "the", " ", "job"}], "*)"}], "2000000", ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Crank", " ", "maxSteps", " ", "up", " ", "to", " ", "2"}], 
          ",", "000", ",", "000"}], "*)"}], "4531", ",", "cleanupOutputDir"}],
        "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nCleanup phase completed in \>\"", ",", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"cleanupTime", "/", "60.0"}], ",", "0.1"}], "]"}], 
      ",", "\"\< minutes.\>\""}], "]"}], ";"}], "\n", 
   "cleanupReport"}]}]], "Input",
 CellChangeTimes->{{3.992941692264597*^9, 3.992941692264597*^9}, 
