   RowBox[{"2.", " ", "Verify", " ", "the", " ", "compiler", " ", "exists"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "nvccExe", "]"}]}], ",", 
