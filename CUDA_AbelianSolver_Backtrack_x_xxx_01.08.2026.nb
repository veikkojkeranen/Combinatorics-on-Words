Cell[TextData[{
 "In the ",
 StyleBox["4th",
  FontWeight->"Bold"],
 " case, we used Complement[...]. Indeed, the 4th case was the first one to \
deal with all the length 40 extension reductions. It says this there :"
}], "Text",
 CellChangeTimes->{{3.9805658099314785`*^9, 3.980565842929302*^9}, {
  3.9805658760878334`*^9, 3.980565956286932*^9}, {3.9805660301576195`*^9, 
  3.980566033667465*^9}, {3.9805660887970295`*^9, 3.9805661889773026`*^9}, {
  3.98057532499596*^9, 
  3.980575328742241*^9}},ExpressionUUID->"2eb0469d-d43d-0742-8405-\
98cd0010d538"],

Cell[TextData[{
 "In spite of \[OpenCurlyQuote]Und\[CloseCurlyQuote] in \
\[OpenCurlyQuote]AllxyzUndEX50MS1M\[CloseCurlyQuote] suffix of the variable \
name, the following Complement[...] contains all the possible 3-let SFSG aa2f \
RED words  (in the ",
 StyleBox["4th",
  FontWeight->"Bold"],
 " case) of length ",
 StyleBox["32",
  FontWeight->"Bold"],
 " :\n(Well, the suffix should actually read UndEX50MS1MUndEX50MS100MNonExt.)"
}], "Text",
 CellChangeTimes->{{3.9805644301175156`*^9, 3.980564563400839*^9}, {
  3.9805645979637375`*^9, 3.980564692916197*^9}, {3.9805647378567715`*^9, 
  3.98056476303232*^9}, {3.9805651936033344`*^9, 3.9805652192535686`*^9}, {
  3.9805893036143627`*^9, 3.9805893039889736`*^9}},
 Background->RGBColor[
  0.98, 0.56, 0.17, 
   0.33],ExpressionUUID->"cc125f82-847a-9c4d-9f3a-81842a6bf33e"],

