    ";"}], "\n", 
   RowBox[{
    RowBox[{"dllFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"workDir", ",", "\"\<solveAbelian.dll\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"cuFile", ",", "cudaSource", ",", "\"\<String\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "RUN", " ", "NVCC", " ", "COMPILER", " ", "DIRECTLY"}],
     "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"UPDATED", ":", 
     RowBox[{"Added", " ", "sm_", "100", " ", "and", " ", "sm_", "120", " ", 
      RowBox[{"(", "Blackwell", ")"}], " ", "targets"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cmd", "=", 
     RowBox[{"{", 
      RowBox[{
      "nvccExe", ",", "\"\<-shared\>\"", ",", "\"\<-O3\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_80,code=sm_80\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_89,code=sm_89\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_90,code=sm_90\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_100,code=sm_100\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_120,code=sm_120\>\"", 
       ",", "\"\<-I\>\"", ",", "mathIncPath", ",", "\"\<-o\>\"", ",", 
       "dllFile", ",", "cuFile"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Running NVCC...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"proc", "=", 
     RowBox[{"RunProcess", "[", "cmd", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"proc", "[", "\"\<ExitCode\>\"", "]"}], "=!=", "0"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<COMPILATION FAILED!\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"proc", "[", "\"\<StandardError\>\"", "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<COMPILATION SUCCESSFUL! DLL created at: \>\"", ",", 
         "dllFile"}], "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", "STEP"}]}], " ", "4"}], "-", "6"}], ":", "LOAD"}], ",", 
     RowBox[{"DEFINE", " ", "WRAPPERS"}], ",", 
     RowBox[{
      RowBox[{"AND", " ", 
       RowBox[{"TEST", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "LOAD", " ", "LIBRARY"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ValueQ", "[", "dllFile", "]"}]}], "||", 
       RowBox[{"!", 
        RowBox[{"FileExistsQ", "[", "dllFile", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{
       "Print", 
        "[", "\"\<ERROR: 'dllFile' is not defined. Run Step 2 first.\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Quiet", "[", 
     RowBox[{"LibraryFunctionUnload", "[", "cudaLibFun", "]"}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"cudaLibFun", "=", 
     RowBox[{"LibraryFunctionLoad", "[", 
      RowBox[{"dllFile", ",", "\"\<solve_entrypoint\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Shared\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         "Integer", ",", "Integer", ",", "Integer"}], "}"}], ",", "Integer"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "HELPER", " ", "FUNCTIONS"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"valMap", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<b\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<c\>\"", "->", "65536"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"reverseValMap", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0", "->", "\"\<a\>\""}], ",", 
       RowBox[{"1", "->", "\"\<b\>\""}], ",", 
       RowBox[{"65536", "->", "\"\<c\>\""}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"stringToCudaInts", "[", "str_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"chars", ",", "vars", ",", "varRules"}], "}"}], ",", 
       RowBox[{
        RowBox[{"chars", "=", 
         RowBox[{"Characters", "[", "str", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vars", "=", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"chars", ",", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], 
                 "}"}], ",", "#"}], "]"}]}], "&"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"varRules", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{"vars", "->", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", 
              RowBox[{"Length", "[", "vars", "]"}]}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Replace", "[", 
         RowBox[{"chars", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{"valMap", ",", "varRules", ",", 
             RowBox[{"_", "->", 
              RowBox[{"-", "99"}]}]}], "}"}], "]"}], ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "MAIN", " ", "EXECUTION", " ", "FUNCTION"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fInt32MakeFreeWordCUDA", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fInt32MakeFreeWordCUDA", "[", 
      RowBox[{"strList_List", ",", 
       RowBox[{"startOfInfix_Integer", ":", "4"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numWords", ",", "stride", ",", "wordLengths", ",", "flatInput", ",", 
         "flatOutput", ",", "processedList", ",", "partitionedRes", ",", 
         "solvedStrings", ",", "wordInts", ",", "errCode"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "cudaLibFun", "]"}], "=!=", 
           "LibraryFunction"}], ",", 
          RowBox[{
          "Return", "[", "\"\<Error: CUDA Library function not loaded.\>\"", 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"numWords", "=", 
         RowBox[{"Length", "[", "strList", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numWords", "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"stride", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"StringLength", "/@", "strList"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"processedList", "=", 
         RowBox[{"stringToCudaInts", "/@", "strList"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wordLengths", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Length", "/@", "processedList"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"flatInput", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"processedList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"stride", "-", 
                  RowBox[{"wordLengths", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "numWords"}], "}"}]}], "]"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"flatOutput", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"Length", "[", "flatInput", "]"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"errCode", "=", 
         RowBox[{"cudaLibFun", "[", 
          RowBox[{
          "flatInput", ",", "flatOutput", ",", "wordLengths", ",", "numWords",
            ",", "stride", ",", "startOfInfix"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"errCode", "=!=", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"StringForm", "[", 
            RowBox[{"\"\<CUDA Error Code: ``\>\"", ",", "errCode"}], "]"}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"partitionedRes", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"flatOutput", ",", "stride"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"solvedStrings", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"wordInts", "=", 
             RowBox[{"partitionedRes", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", 
                RowBox[{"1", ";;", 
                 RowBox[{"wordLengths", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"AnyTrue", "[", 
               RowBox[{"wordInts", ",", "Negative"}], "]"}], 
              ",", "\"\<$FAILED\>\"", ",", 
              RowBox[{"StringJoin", "[", 
               RowBox[{"wordInts", "/.", " ", "reverseValMap"}], "]"}]}], 
             "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "numWords"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "solvedStrings"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "7"}], ":", 
     RowBox[{
      RowBox[{"EXTENSION", " ", "SEARCH", " ", "UTILITIES", " ", 
       RowBox[{
        RowBox[{"(", "NEW", ")"}], "--"}]}], "-"}]}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "aa2fFindNonExtendableWords", " ", "Takes", " ", "a", " ", "list", " ", 
      "of", " ", "base", " ", "words"}], ",", 
     RowBox[{
     "adds", " ", "variables", " ", "to", " ", "left", " ", "and", " ", 
      "right"}], ",", 
     RowBox[{"runs", " ", "the", " ", "solver"}], ",", 
     RowBox[{
     "and", " ", "returns", " ", "ONLY", " ", "the", " ", "original", " ", 
      "words", " ", "that", " ", "FAILED", " ", "to", " ", 
      RowBox[{"extend", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fFindNonExtendableWords", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fFindNonExtendableWords", "[", 
      RowBox[{"words_List", ",", "leftLen_Integer", ",", "rightLen_Integer"}],
       "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "leftVars", ",", "rightVars", ",", "templateStrings", ",", "results", 
         ",", "nonExtendableIndices", ",", "nonExtendableWords"}], "}"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Processing \>\"", ",", 
          RowBox[{"Length", "[", "words", "]"}], 
          ",", "\"\< words. Extensions: Left=\>\"", ",", "leftLen", 
          ",", "\"\<, Right=\>\"", ",", "rightLen"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"1.", " ", "Generate", " ", "Template", " ", "Strings"}], 
         "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
            "We", " ", "use", " ", "unique", " ", "variables", " ", "chars", " ",
              "D"}], ".."}], "Z", " ", "to", " ", "avoid", " ", "clashing", " ",
            "with", " ", "a"}], ",", "b", ",", "c"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"varChars", "=", 
         RowBox[{"CharacterRange", "[", 
          RowBox[{"\"\<D\>\"", ",", "\"\<Z\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"leftVars", "=", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"Take", "[", 
           RowBox[{"varChars", ",", "leftLen"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rightVars", "=", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"Take", "[", 
           RowBox[{"varChars", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"leftLen", "+", "1"}], ",", 
              RowBox[{"leftLen", "+", "rightLen"}]}], "}"}]}], "]"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"templateStrings", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"leftVars", "<>", "w", "<>", "rightVars"}], ",", 
           RowBox[{"{", 
            RowBox[{"w", ",", "words"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"2.", " ", "Run", " ", "CUDA", " ", "Solver"}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"We", " ", "use", " ", "startOfInfix"}], "=", 
          RowBox[{
          "1", " ", "because", " ", "we", " ", "added", " ", "new", " ", 
           "variables", " ", "at", " ", "the", " ", "start", " ", 
           RowBox[{"(", 
            RowBox[{"Index", " ", "0"}], ")"}]}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"results", "=", 
         RowBox[{"aa2fInt32MakeFreeWordCUDA", "[", 
          RowBox[{"templateStrings", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Check", " ", "for", " ", "Execution", " ", "Errors", " ", 
          RowBox[{"(", 
           RowBox[{
           "Modified", " ", "to", " ", "catch", " ", "Error", " ", "209", " ",
             "etc"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"ListQ", "[", "results", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Solver Error: \>\"", ",", "results"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"3.", " ", "Filter", " ", "Results"}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"If", " ", "result", " ", "is", " ", "\"\<$FAILED\>\""}], ",", 
          RowBox[{
           RowBox[{
           "it", " ", "means", " ", "no", " ", "solution", " ", "was", " ", 
            "found"}], "->", 
           RowBox[{"Non", "-", "Extendable"}]}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
         "We", " ", "return", " ", "the", " ", "ORIGINAL", " ", "base", " ", 
          "words", " ", "corresponding", " ", "to", " ", "these", " ", 
          "failures"}], "*)"}], 
        RowBox[{"nonExtendableIndices", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{"results", ",", "\"\<$FAILED\>\""}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nonExtendableWords", "=", 
         RowBox[{"words", "[", 
          RowBox[{"[", "nonExtendableIndices", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Found \>\"", ",", 
          RowBox[{"Length", "[", "nonExtendableWords", "]"}], 
          ",", "\"\< non-extendable words.\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", "nonExtendableWords"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
