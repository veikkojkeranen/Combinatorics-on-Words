Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "testSuffVisThree", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"testSuffVisThree", "[", "x_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sl", "=", 
       RowBox[{"StringLength", "[", "x", "]"}]}], ",", 
      RowBox[{"i", "=", "1"}], ",", "res"}], "}"}], ",", "\n", "\t\t", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"i", "<", 
         RowBox[{"Floor", "[", 
          RowBox[{"sl", "/", "2"}], "]"}]}], " ", "&&", 
        RowBox[{"(", "\n", "\t\t", 
         RowBox[{"res", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "[", 
             RowBox[{"StringTake", "[", 
              RowBox[{"x", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"sl", "-", "1", "-", 
                  RowBox[{"2", "i"}]}], ",", 
                 RowBox[{"sl", "-", "1", "-", "i"}]}], "}"}]}], "]"}], " ", 
             "]"}], "===", 
            RowBox[{"s", "[", 
             RowBox[{"StringTake", "[", 
              RowBox[{"x", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"sl", "-", "i"}], ",", "sl"}], "}"}]}], "]"}], " ", 
             "]"}]}], "//", "Not"}]}], ")"}]}], ",", 
       RowBox[{"i", "++"}]}], "]"}], ";", "\n", "\t", 
     RowBox[{"If", "[", 
      RowBox[{"res", ",", "True", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"StringTake", "[", 
          RowBox[{"x", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"sl", "-", "1", "-", 
              RowBox[{"2", "i"}]}], ",", 
             RowBox[{"sl", "-", "1", "-", "i"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"StringTake", "[", 
          RowBox[{"x", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"sl", "-", "i"}], ",", "sl"}], "}"}]}], "]"}], ",", 
         RowBox[{"2", 
          RowBox[{"(", 
           RowBox[{"i", "+", "1"}], ")"}]}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]}], "Code",
 CellLabel->
  "In[172]:=",ExpressionUUID->"21469dbe-e086-1f4e-b272-2d02b6b8acbd"],

