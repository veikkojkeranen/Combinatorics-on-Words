 RowBox[{
  RowBox[{
   RowBox[{"aa2fMakeFreeWordUsingList3let", "[", 
    RowBox[{"str_String", ",", 
     RowBox[{"startingPointer_Integer", ":", "4"}]}], "]"}], ":=", "\n", "\t", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"myL", ",", " ", "myV", ",", " ", "myRes"}], "}"}], ",", "\n", 
     "\t\t", 
     RowBox[{
      RowBox[{"myL", "=", 
       RowBox[{"Union", "[", 
        RowBox[{"aa2fCreateList3let", "[", 
         RowBox[{"str", ",", "startingPointer"}], "]"}], "]"}]}], ";", " ", 
      "\n", "\t\t", 
      RowBox[{"myV", "=", 
       RowBox[{"aa2fPickVariables3let", "[", "str", "]"}]}], ";", "\n", 
      "\t\t", 
      RowBox[{"myRes", "=", 
       RowBox[{"aa2fTestList3let", "[", 
        RowBox[{"myL", ",", "myV", ",", "1"}], "]"}]}], ";", "\n", "\t\t", 
      RowBox[{
       RowBox[{
        RowBox[{"StringReplace", "[", 
         RowBox[{"str", ",", " ", "#"}], "]"}], "&"}], "/@", "myRes"}]}]}], 
    "\n", "\t", "]"}]}], ";"}]}], "Input",
