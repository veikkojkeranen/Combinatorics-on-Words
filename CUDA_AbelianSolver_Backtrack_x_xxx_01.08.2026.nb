                 GridBox[{{
                    RowBox[{
                    RowBox[{"testSuffThree", "[", "x_", "]"}], ":=", 
                    RowBox[{"Block", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"sl", "=", 
                    RowBox[{"StringLength", "[", "x", "]"}]}], ",", 
                    RowBox[{"i", "=", "1"}], ",", 
                    RowBox[{"res", "=", "True"}]}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"While", "[", 
