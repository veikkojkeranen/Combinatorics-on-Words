Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "aa2fSolveInBatches", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"aa2fSolveInBatches", "[", 
    RowBox[{"allWords_List", ",", "extBound_Integer", ",", 
     RowBox[{"maxSteps_Integer", ":", "50000"}], ",", 
     RowBox[{"batchSize_Integer", ":", "20000"}], ",", 
     RowBox[{"mainOutputDir_String", ":", 
      RowBox[{"Directory", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"wordBatches", ",", "numBatches", ",", 
       RowBox[{"globalExtendable", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"globalUndecided", "=", 
        RowBox[{"{", "}"}]}], ",", "batchWords", ",", "batchResult", ",", 
       "tStart", ",", "tEnd"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "1.", " ", "Partition", " ", "the", " ", "massive", " ", "list", " ", 
       "into", " ", "manageable", " ", "chunks"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"wordBatches", "=", 
       RowBox[{"Partition", "[", 
        RowBox[{"allWords", ",", 
         RowBox[{"UpTo", "[", "batchSize", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"numBatches", "=", 
       RowBox[{"Length", "[", "wordBatches", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<==================================================\>\
\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<  LAUNCHING BATCHED SOLVER\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  Total Words: \>\"", ",", 
        RowBox[{"Length", "[", "allWords", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  Batch Size:  \>\"", ",", "batchSize"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  Total Chunks: \>\"", ",", "numBatches"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<==================================================\>\
\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"DirectoryQ", "[", "mainOutputDir", "]"}]}], ",", 
        RowBox[{"CreateDirectory", "[", "mainOutputDir", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "2.", " ", "Process", " ", "each", " ", "batch", " ", "sequentially"}],
        "*)"}], 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<\\n>>> PROCESSING CHUNK \>\"", ",", "b", 
           ",", "\"\< OF \>\"", ",", "numBatches", ",", "\"\< (Size: \>\"", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"wordBatches", "[", 
             RowBox[{"[", "b", "]"}], "]"}], "]"}], ",", "\"\<) <<<\>\""}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"batchWords", "=", 
          RowBox[{"wordBatches", "[", 
           RowBox[{"[", "b", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Run", " ", "the", " ", "full", " ", "6"}], "-", 
           RowBox[{
           "phase", " ", "rotational", " ", "attack", " ", "on", " ", "this", 
            " ", "specific", " ", "chunk"}]}], "*)"}], 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"timeSpent", ",", "batchResult"}], "}"}], "=", 
          RowBox[{"AbsoluteTiming", "[", 
           RowBox[{"aa2fSolveRotational", "[", 
            RowBox[{
            "batchWords", ",", "extBound", ",", "maxSteps", ",", 
             "mainOutputDir"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Chunk \>\"", ",", "b", ",", "\"\< complete in \>\"", ",", 
           RowBox[{"Round", "[", 
            RowBox[{"timeSpent", ",", "0.01"}], "]"}], 
           ",", "\"\< seconds.\>\""}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Accumulate", " ", "successful", " ", "extensions", " ", "and", " ",
            "unresolvable", " ", "timeouts", " ", "globally"}], "*)"}], 
         RowBox[{"globalExtendable", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"globalExtendable", ",", 
            RowBox[{"batchResult", "[", "\"\<Extendable\>\"", "]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"globalUndecided", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"globalUndecided", ",", 
            RowBox[{"batchResult", "[", "\"\<Undecided\>\"", "]"}]}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Free", " ", "up", " ", "memory", " ", "inside", " ", 
           RowBox[{"Mathematica", "'"}], "s", " ", "kernel", " ", "loop"}], 
          "*)"}], 
         RowBox[{"Clear", "[", 
          RowBox[{"batchResult", ",", "batchWords"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         StyleBox[
          RowBox[{"ClearSystemCache", "[", "]"}],
          FontWeight->"Bold"], 
         StyleBox[";",
          FontWeight->"Bold"]}], 
        StyleBox[" ",
         FontWeight->"Bold"], 
        RowBox[{"(*", 
         RowBox[{
         "Force", " ", "garbage", " ", "collection", " ", "indicators", " ", 
          "if", " ", "needed"}], "*)"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "1", ",", "numBatches"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"3.", " ", "Export", " ", "Global", " ", "Summaries"}], "*)"}], 
      RowBox[{
      "Print", "[", \
"\"\<\\n==================================================\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<  ALL BATCHES COMPLETE\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  Global Extendable Found: \>\"", ",", 
        RowBox[{"Length", "[", "globalExtendable", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  Global Remaining Undecided: \>\"", ",", 
        RowBox[{"Length", "[", "globalUndecided", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<==================================================\>\
\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
          "mainOutputDir", ",", "\"\<GLOBAL_EXTENDABLE_SUMMARY.txt\>\""}], 
          "}"}], "]"}], ",", "globalExtendable", ",", "\"\<Table\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
          "mainOutputDir", ",", "\"\<GLOBAL_UNDECIDED_SUMMARY.txt\>\""}], 
          "}"}], "]"}], ",", "globalUndecided", ",", "\"\<Table\>\""}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<GlobalExtendable\>\"", "->", "globalExtendable"}], ",", 
        RowBox[{"\"\<GlobalUndecided\>\"", "->", "globalUndecided"}]}], 
       "|>"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9929288651736813`*^9, 3.9929288651736813`*^9}, {
  3.9929290101202183`*^9, 3.9929290176643143`*^9}, {3.993038827878748*^9, 
  3.993038837364937*^9}},
 CellLabel->
  "In[235]:=",ExpressionUUID->"6a7f0835-a52f-8c44-a88a-51080a9c1979"],

Cell[TextData[{
 "You are completely right, and thank you for catching that. I hallucinated \
the usage of Subdivide[] as a memory management tool there. In Mathematica, \
Subdivide is used to generate a list of equally spaced values (like \
Subdivide[0, 1, 10]) and has absolutely nothing to do with garbage \
collection!\n\nTo properly keep the kernel memory clean during massive batch \
iterations, you can simply delete that line. The Clear[batchResult, \
batchWords]; is usually sufficient for Mathematica\[CloseCurlyQuote]s \
automatic garbage collector.\n\nIf you do find the RAM ballooning over time \
during the heavy runs, the actual command to clear cached memory overhead in \
Mathematica is:\n\n",
 StyleBox["ClearSystemCache[];",
  FontWeight->"Bold"],
 "\nYou can swap that in right where the erroneous Subdivide[]; was."
}], "Text",
 CellChangeTimes->{3.993038725667309*^9, 
  3.993038782073492*^9},ExpressionUUID->"0133067d-b0fa-4346-9cc1-\
61d1bc8cc84d"],

