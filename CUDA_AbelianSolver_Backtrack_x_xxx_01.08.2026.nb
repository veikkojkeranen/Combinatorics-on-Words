         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<\\n--- Phase \>\"", ",", "i", ",", "\"\<: Order \>\"", 
           ",", "pStr", ",", "\"\< ---\>\""}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Processing \>\"", ",", 
           RowBox[{"Length", "[", "currentWords", "]"}], 
           ",", "\"\< Undecided words...\>\""}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Run", " ", "Core", " ", "Solver", " ", "with", " ", "current", " ",
            "permutation"}], "*)"}], 
         RowBox[{"results", "=", 
          RowBox[{"aa2fCheckExtendability", "[", 
           RowBox[{
           "currentWords", ",", "extBound", ",", "maxSteps", ",", "pStr"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Collect", " ", "Finished", " ", "Results"}], "*)"}], 
         RowBox[{"totalExtendable", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"totalExtendable", ",", 
            RowBox[{"results", "[", "\"\<Extendable\>\"", "]"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"totalNonExtendable", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"totalNonExtendable", ",", 
            RowBox[{"results", "[", "\"\<NonExtendable\>\"", "]"}]}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<\[NonBreakingSpace] -> Extendable_\>\"", ",", "pStr", 
           ",", "\"\< (Good): \>\"", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"results", "[", "\"\<Extendable\>\"", "]"}], "]"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<\[NonBreakingSpace] -> NonExtendable_\>\"", ",", 
           "pStr", ",", "\"\< (Bad): \>\"", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"results", "[", "\"\<NonExtendable\>\"", "]"}], "]"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<\[NonBreakingSpace] -> Undecided_\>\"", ",", "pStr", 
           ",", "\"\< (Timeout): \>\"", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"results", "[", "\"\<Undecided\>\"", "]"}], "]"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"SAVE", " ", "INTERMEDIATE", " ", "FILES"}], "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"results", "[", "\"\<Extendable\>\"", "]"}], "]"}], ">", 
            "0"}], ",", 
           RowBox[{"Export", "[", 
            RowBox[{
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", 
               RowBox[{"outputDir", ",", 
                
                RowBox[{"\"\<Extendable_\>\"", "<>", "pStr", 
                 "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", 
             RowBox[{"results", "[", "\"\<Extendable\>\"", "]"}], 
             ",", "\"\<Table\>\""}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"results", "[", "\"\<NonExtendable\>\"", "]"}], "]"}], ">",
             "0"}], ",", 
           RowBox[{"Export", "[", 
            RowBox[{
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", 
               RowBox[{"outputDir", ",", 
                
                RowBox[{"\"\<Non_Extendable_\>\"", "<>", "pStr", 
                 "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", 
             RowBox[{"results", "[", "\"\<NonExtendable\>\"", "]"}], 
             ",", "\"\<Table\>\""}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"results", "[", "\"\<Undecided\>\"", "]"}], "]"}], ">", 
            "0"}], ",", 
           RowBox[{"Export", "[", 
            RowBox[{
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", 
               RowBox[{"outputDir", ",", 
                
                RowBox[{"\"\<Undecided_\>\"", "<>", "pStr", 
                 "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", 
             RowBox[{"results", "[", "\"\<Undecided\>\"", "]"}], 
             ",", "\"\<Table\>\""}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Prepare", " ", "for", " ", "next", " ", "pass"}], "*)"}], 
         RowBox[{"currentWords", "=", 
          RowBox[{"results", "[", "\"\<Undecided\>\"", "]"}]}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "permutations", "]"}]}], "}"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Final", " ", "Report"}], "*)"}], 
      RowBox[{
      "Print", "[", "\"\<\\n=== FINAL RESULTS AFTER 6 PHASES ===\>\"", "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Total Extendable: \>\"", ",", 
        RowBox[{"Length", "[", "totalExtendable", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Total NonExtendable: \>\"", ",", 
        RowBox[{"Length", "[", "totalNonExtendable", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Remaining Undecided (Hardest): \>\"", ",", 
        RowBox[{"Length", "[", "currentWords", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Extendable\>\"", "->", "totalExtendable"}], ",", 
        RowBox[{"\"\<NonExtendable\>\"", "->", "totalNonExtendable"}], ",", 
        RowBox[{"\"\<Undecided\>\"", "->", "currentWords"}]}], "|>"}]}]}], 
    "]"}]}], ";"}]}], "Input",
