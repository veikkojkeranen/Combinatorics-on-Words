    "2.", " ", "Set", " ", "an", " ", "output", " ", "directory", " ", 
     "where", " ", "you", " ", "can", " ", "easily", " ", "check", " ", "the",
      " ", "text", " ", "files"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "testOutputDir", 
     "=", "\"\<D:\\\\ExtremeMathMmaComputations\\\\aa2fr_3let_len40_ex60ms10M_\
Extendable_Nex_Und\\\\test\>\""}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "the", " ", "directory", " ", "if", " ", "it", " ", 
     RowBox[{"doesn", "'"}], "t", " ", "exist"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"DirectoryQ", "[", "testOutputDir", "]"}]}], ",", 
      RowBox[{"CreateDirectory", "[", "testOutputDir", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Run", " ", "the", " ", "solver", " ", "with", " ", "a", " ", 
     "low", " ", "extension", " ", "bound", " ", 
     RowBox[{"(", "2", ")"}], " ", "and", " ", "low", " ", "max", " ", 
     "steps", " ", 
     RowBox[{"(", "5000", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Starting quick dry-run test...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"testResults", "=", 
     RowBox[{"aa2fSolveRotational", "[", 
      RowBox[{"testWords", ",", "2", ",", "5000", ",", "testOutputDir"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Display", " ", "the", " ", "results", " ", "directly", " ", 
