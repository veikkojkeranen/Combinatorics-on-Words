Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "STEP"}]}], " ", "0"}], ":", 
    RowBox[{
     RowBox[{"MANUAL", " ", "CONFIGURATION", " ", "FOR", " ", "CUDA", " ", 
      RowBox[{"13.1", "--"}]}], "-"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Since", " ", "Mathematica", " ", "does", " ", "not", " ", "yet", " ", 
      "auto"}], "-", 
     RowBox[{"detect", " ", "CUDA", " ", "13.1"}]}], ",", 
    RowBox[{"we", " ", "must", " ", "set", " ", "paths", " ", 
     RowBox[{"manually", "."}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "path", " ", "to", " ", "your", " ", 
    "toolkit", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Base", " ", "directory"}], ",", 
      RowBox[{"not", " ", "bin"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "cudaBaseDir", 
     "=", "\"\<C:\\\\Program Files\\\\NVIDIA GPU Computing \
Toolkit\\\\CUDA\\\\v13.1\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nvccExe", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"cudaBaseDir", ",", "\"\<bin\>\"", ",", "\"\<nvcc.exe\>\""}], 
       "}"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Verify", " ", "the", " ", "compiler", " ", "exists"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "nvccExe", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<ERROR: nvcc.exe not found at: \>\"", ",", "nvccExe"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", 
        "[", "\"\<Please verify the folder path in 'cudaBaseDir' above.\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}]}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<FOUND: nvcc.exe at \>\"", ",", "nvccExe"}], "]"}]}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Manually", " ", "set", " ", "Environment", " ", "Variables", " ",
      "for", " ", "this", " ", "session"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetEnvironment", "[", 
     RowBox[{"\"\<CUDA_PATH\>\"", "->", "cudaBaseDir"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SetEnvironment", "[", 
     RowBox[{"\"\<CUDA_BIN_PATH\>\"", "->", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"cudaBaseDir", ",", "\"\<bin\>\""}], "}"}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"SetEnvironment", "[", 
     RowBox[{"\"\<CUDA_LIB_PATH\>\"", "->", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"cudaBaseDir", ",", "\"\<lib\>\"", ",", "\"\<x64\>\""}], 
        "}"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SetEnvironment", "[", 
     RowBox[{"\"\<CUDA_INC_PATH\>\"", "->", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"cudaBaseDir", ",", "\"\<include\>\""}], "}"}], "]"}]}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Load", " ", "Packages"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<CUDALink`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Check", " ", "Host", " ", "Compiler", " ", 
     RowBox[{"(", 
      RowBox[{"Visual", " ", "Studio"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"NVCC", " ", "requires", " ", "a", " ", 
      RowBox[{"C", "++"}], " ", "host", " ", 
      RowBox[{"compiler", ".", "If"}], " ", "this", " ", "list", " ", "is", " ",
       "empty"}], ",", 
     RowBox[{"CUDA", " ", "will", " ", 
      RowBox[{"fail", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"compilers", "=", 
     RowBox[{"CCompilers", "[", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "compilers", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{
       "Print", 
        "[", "\"\<CRITICAL WARNING: No C++ compiler found (e.g., Visual \
Studio).\>\"", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<NVCC needs Visual Studio's 'cl.exe' to work.\>\"", 
        "]"}], ";"}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Using Host C Compiler: \>\"", ",", 
        RowBox[{
         RowBox[{"First", "[", "compilers", "]"}], "[", "\"\<Name\>\"", 
         "]"}]}], "]"}]}], "]"}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9758237330466976`*^9, 3.975823760686922*^9}, {
  3.9758239157677364`*^9, 3.975823938465147*^9}, {3.975824404493248*^9, 
  3.9758244352399635`*^9}},ExpressionUUID->"e0c84261-9564-954d-8cbd-\
1db3f515ce40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<CUDALink`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], ";"}]}], "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"5612be3b-d595-9546-9fa7-25907877771e"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"2.", " ", "PREPARE", " ", "COMPILATION", " ", "ENVIRONMENT"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NVCC", " ", 
    RowBox[{"needs", "'"}], 
    RowBox[{"cl", ".", 
     RowBox[{"exe", "'"}]}], " ", 
    RowBox[{"(", 
     RowBox[{"Visual", " ", "Studio"}], ")"}], " ", "in", " ", "the", " ", 
    RowBox[{"path", "."}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"We", " ", "specifically", " ", "want", " ", "the", " ", "64"}], 
     "-", 
     RowBox[{"bit", " ", "host"}]}], ",", 
    RowBox[{"64", "-", 
     RowBox[{"bit", " ", "target", " ", 
      RowBox[{"compiler", ":", 
       RowBox[{"Hostx64", "\\", "x64"}]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clPath", "=", "None"}], ";", "\n", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "compilers", "]"}], ">", "0"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Get", " ", "VS", " ", "Root"}], ",", 
        RowBox[{"e", ".", "g", ".", 
         RowBox[{"C", ":", 
          RowBox[{
           RowBox[{"\\", "Program"}], " ", 
           RowBox[{"Files", "\\", "Microsoft"}], " ", "Visual", " ", 
           RowBox[{"Studio\\2022", "\\", "Community"}]}]}]}]}], "*)"}], 
      RowBox[{
       RowBox[{"vsRoot", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"compilers", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<CompilerInstallation\>\"",
           ",", 
          RowBox[{
           RowBox[{"compilers", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           "[", "\"\<CompilerInstallation\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Manually", " ", "construct", " ", "the", " ", "path", " ", "to", " ", 
         RowBox[{"Hostx64", "\\", "x64"}], " ", "to", " ", "ensure", " ", 
         "we", " ", "get", " ", "the", " ", "right", " ", "one"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"We", " ", "search", " ", "for", " ", 
         RowBox[{"cl", ".", "exe"}], " ", "inside", " ", "the", " ", "VC", " ",
          "folder"}], "*)"}], 
       RowBox[{"candidates", "=", 
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<cl.exe\>\"", ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"vsRoot", ",", "\"\<VC\>\""}], "}"}], "]"}], ",", 
          "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Filter", " ", "for", " ", "the", " ", "specific", " ", 
         "architecture", " ", "path"}], "*)"}], 
       RowBox[{"selected", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"candidates", ",", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"#", ",", "\"\<Hostx64\\\\x64\>\""}], "]"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "selected", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"clPath", "=", 
           RowBox[{"DirectoryName", "[", 
            RowBox[{"First", "[", "selected", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Found 64-bit cl.exe at: \>\"", ",", "clPath"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"originalPath", "=", 
           RowBox[{"Environment", "[", "\"\<PATH\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"SetEnvironment", "[", 
           RowBox[{"\"\<PATH\>\"", "->", 
            RowBox[{"clPath", "<>", "\"\<;\>\"", "<>", "originalPath"}]}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<WARNING: Could not automatically find \
Hostx64\\\\x64\\\\cl.exe.\>\"", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
          "Print", 
           "[", "\"\<Please manually set 'clPath' to the directory containing \
the 64-bit cl.exe.\>\"", "]"}], ";"}]}], "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "*)"}]}]], "Input",
 CellChangeTimes->{
  3.9758240836482334`*^9, {3.9758241502171726`*^9, 3.975824159068735*^9}, 
   3.9758242524264565`*^9, {3.9758249749796276`*^9, 
   3.975825014626396*^9}},ExpressionUUID->"fbabe822-befe-be47-ba06-\
32baf3d0eb4f"],

