  3.9940349913524494`*^9}},ExpressionUUID->"50c85036-0286-1946-b58a-\
0f05c4316efc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Assuming", " ", "word2000", " ", "is", " ", "your", " ", "2000"}], "-", 
    RowBox[{"letter", " ", "string"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"word2000", " ", "=", " ", "aa2fr2000"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Paste", " ", "your", " ", "actual", " ", "string", " ", "here"}],
     " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "the", " ", "parameters", " ", "based", " ", "on", " ", 
     "your", " ", "strategy"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"leftMargin", " ", "=", " ", "160"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rightMargin", " ", "=", " ", "160"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"factorLength", " ", "=", " ", "40"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "1.", " ", "Extract", " ", "the", " ", "safe", " ", "middle", " ", 
     "section"}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"In", " ", "Mathematica"}], ",", " ", 
     RowBox[{
     "negative", " ", "indices", " ", "count", " ", "backwards", " ", "from", 
      " ", "the", " ", "end", " ", "of", " ", "the", " ", "string"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"middleSection", " ", "=", " ", 
     RowBox[{"StringTake", "[", 
      RowBox[{"word2000", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"leftMargin", " ", "+", " ", "1"}], ",", " ", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"rightMargin", " ", "+", " ", "1"}], ")"}]}]}], "}"}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "2.", " ", "Generate", " ", "all", " ", "sliding", " ", "length"}], "-", 
     RowBox[{"40", " ", "windows", " ", 
      RowBox[{"(", 
       RowBox[{"step", " ", "size", " ", "of", " ", "1"}], ")"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"middleFactors", " ", "=", " ", 
     RowBox[{"StringPartition", "[", 
      RowBox[{"middleSection", ",", " ", "factorLength", ",", " ", "1"}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "3.", " ", "Remove", " ", "duplicates", " ", "to", " ", "keep", " ", 
     "the", " ", "seed", " ", "list", " ", "lean"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"uniqueFactors2000", " ", "=", " ", 
     RowBox[{"Union", "[", "middleFactors", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Output", " ", "the", " ", "diagnostics"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total characters in middle section: \>\"", ",", " ", 
      RowBox[{"StringLength", "[", "middleSection", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Unique length-40 seeds extracted: \>\"", ",", " ", 
      RowBox[{"Length", "[", "uniqueFactors2000", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9940339443859005`*^9, 3.994033976460045*^9}, {
   3.994035004524395*^9, 3.994035048733177*^9}, {3.9940351283876743`*^9, 
