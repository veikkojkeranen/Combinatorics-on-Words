       RowBox[{
        RowBox[{"finalBossTime", "/", "3600.0"}], ",", "0.01"}], "]"}], 
      ",", "\"\< hours.\>\""}], "]"}], ";"}], "\n", 
   "finalBossReport"}]}]], "Input",
