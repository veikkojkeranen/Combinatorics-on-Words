Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "STEP"}]}], " ", "0"}], ":", 
    RowBox[{
     RowBox[{"MANUAL", " ", "CONFIGURATION", " ", "FOR", " ", "CUDA", " ", 
      RowBox[{"13.1", "--"}]}], "-"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Since", " ", "Mathematica", " ", "does", " ", "not", " ", "yet", " ", 
      "auto"}], "-", 
     RowBox[{"detect", " ", "CUDA", " ", "13.1"}]}], ",", 
    RowBox[{"we", " ", "must", " ", "set", " ", "paths", " ", 
     RowBox[{"manually", "."}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "path", " ", "to", " ", "your", " ", 
    "toolkit", " ", 
    RowBox[{"(", 
