      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"result", "[", "\"\<Extendable\>\"", "]"}], "]"}], ">", "0"}],
       ",", 
      RowBox[{
      "Print", "[", "\"\<SUCCESS: Some words could be extended.\>\"", "]"}]}],
      "]"}], ";"}]}]}]], "Input",
