           ",", 
          RowBox[{
           RowBox[{"compilers", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           "[", "\"\<CompilerInstallation\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"candidates", "=", 
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<cl.exe\>\"", ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"vsRoot", ",", "\"\<VC\>\""}], "}"}], "]"}], ",", 
          "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"selected", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"candidates", ",", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"#", ",", "\"\<Hostx64\\\\x64\>\""}], "]"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "selected", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"clPath", "=", 
           RowBox[{"DirectoryName", "[", 
            RowBox[{"First", "[", "selected", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Found 64-bit cl.exe at: \>\"", ",", "clPath"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"originalPath", "=", 
           RowBox[{"Environment", "[", "\"\<PATH\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"SetEnvironment", "[", 
           RowBox[{"\"\<PATH\>\"", "->", 
            RowBox[{"clPath", "<>", "\"\<;\>\"", "<>", "originalPath"}]}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<WARNING: Could not automatically find \
Hostx64\\\\x64\\\\cl.exe.\>\"", "]"}], ";"}]}], "]"}]}]}], "]"}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "file", " ", "paths"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"workDir", "=", 
     RowBox[{"CreateDirectory", "[", "]"}]}], ";"}], "\n", 
