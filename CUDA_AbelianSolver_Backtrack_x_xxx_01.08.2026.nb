Cell[TextData[{
 "\n",
 StyleBox["14.02.2026",
  FontSize->36],
 " ",
 StyleBox["For Linux :",
  FontSize->36],
 "\n"
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.9793650551445007`*^9, 3.979365058436777*^9}, {
   3.9793805411419563`*^9, 3.979380568314766*^9}, {3.9793806620120087`*^9, 
   3.9793806625864315`*^9}, {3.980066302336046*^9, 3.98006630361611*^9}, 
   3.992873054717972*^9},
 FontSize->36,
 Background->RGBColor[
  0.95, 0.43, 0.96, 
   0.33],ExpressionUUID->"f28df75c-da31-4d46-a0de-9b0f21cadf5e"],

Cell["\<\
#include <iostream>
#include <fstream>
#include <vector>
#include <string>
#include <algorithm>
#include <cuda_runtime.h>

// --- CONFIGURATION ---
#define VAL_A 0
#define VAL_B 1
#define VAL_C 65536

// Buffer sizes
#define MAX_WORD_LEN 256
#define MAX_TOTAL_LEN 512 
#define MAX_GEN_DEPTH 64   // Max expansion (e.g. adding 32 chars)
#define MAX_CHECK_DEPTH 128 // Max lookahead depth

// Max output capacity (e.g., 5 million words). Adjust based on VRAM.
// 5,000,000 * 64 bytes ~= 320 MB. Trivial for B200.
#define MAX_OUTPUT_COUNT 50000000 

// Error Check Macro
#define gpuErrchk(ans) { gpuAssert((ans), __FILE__, __LINE__); }
inline void gpuAssert(cudaError_t code, const char *file, int line, bool \
abort=true) {
   if (code != cudaSuccess) {
      fprintf(stderr,\[CloseCurlyDoubleQuote]GPUassert: %s %s %d\\n\
\[CloseCurlyDoubleQuote], cudaGetErrorString(code), file, line);
      if (abort) exit(code);
   }
}

// --- HELPER DEVICE FUNCTIONS ---

__device__ bool check_left_edge(long long* buf, int start, int end) {
    int len = end - start + 1;
    int max_k = len / 2;
    // k=2 to allow \[OpenCurlyQuote]aa\[CloseCurlyQuote] but forbid \
\[OpenCurlyQuote]abab\[CloseCurlyQuote]
    for (int k = 2; k <= max_k; k++) {
        long long sum_u = 0;
        long long sum_v = 0;
        for (int i = 0; i < k; i++) sum_u += buf[start + i];
        for (int i = 0; i < k; i++) sum_v += buf[start + k + i];
        if (sum_u == sum_v) return false;
    }
    return true;
}

__device__ bool check_right_edge(long long* buf, int start, int end) {
    int len = end - start + 1;
    int max_k = len / 2;
    for (int k = 2; k <= max_k; k++) {
        long long sum_u = 0;
        long long sum_v = 0;
        for (int i = 0; i < k; i++) sum_v += buf[end - i];
        for (int i = 0; i < k; i++) sum_u += buf[end - k - i];
        if (sum_u == sum_v) return false;
    }
    return true;
}

// --- THE LOOKAHEAD SOLVER ---
// Returns: 
// 0 = Extendable (Good)
// 1 = Non-Extendable (Bad)
// 2 = Undecided (Timeout)
__device__ int check_viability(
    long long* base_buf, int base_start, int base_end, 
    int current_side, // 0=Left, 1=Right (Direction of last addition)
    int check_bound, long long max_steps
) {
    // Local copy for the lookahead simulation
    long long buffer[MAX_TOTAL_LEN];
    int stack_val[MAX_CHECK_DEPTH]; 

    int start_ptr = MAX_TOTAL_LEN / 2; 
    int end_ptr = start_ptr + (base_end - base_start);
    
    // Copy current state
    for(int i=0; i <= (base_end - base_start); i++) {
        buffer[start_ptr + i] = base_buf[base_start + i];
    }

    // Initialize DFS
    int depth = 0;
    stack_val[0] = -1;
    long long steps = 0;
    int status = 1; // Assume Bad until proven Good or Timeout

    // Optimization: Continue alternating based on where the generator left \
off?
    // Or just start standard alternating. Let\[CloseCurlyQuote]s do standard \
alternating for robustness.
    // If the generator just added Left, the lookahead starts adding Left \
(depth 0).
    
    while (depth >= 0) {
        steps++;
        if (steps > max_steps) {
            status = 2; // Timeout -> Keep it
            break;
        }

        // Cleanup
        int current_val = stack_val[depth];
        if (current_val != -1) {
             if (depth % 2 == 0) start_ptr++; 
             else end_ptr--;              
        }

        // Next val
        stack_val[depth]++;
        int val_code = stack_val[depth];

        if (val_code > 2) {
            stack_val[depth] = -1;
            depth--;
            continue;
        }

        long long actual_val = (val_code == 0) ? VAL_A : ((val_code == 1) ? \
VAL_B : VAL_C);
        bool valid = false;

        // Standard Alternating Logic
        if (depth % 2 == 0) {
            start_ptr--;
            buffer[start_ptr] = actual_val;
            valid = check_left_edge(buffer, start_ptr, end_ptr);
        } else {
            end_ptr++;
            buffer[end_ptr] = actual_val;
            valid = check_right_edge(buffer, start_ptr, end_ptr);
        }

        if (valid) {
            if (depth >= (2 * check_bound - 1)) {
                status = 0; // Good
                break;
            }
            depth++;
            if (depth >= MAX_CHECK_DEPTH) { status = 2; break; } // Safety
            stack_val[depth] = -1;
        }
    }
    return status;
}

// --- GENERATOR KERNEL ---
__global__ void generateKernel(
    long long* input_flat, long long* output_flat, long long* output_lengths, \
unsigned long long* global_counter,
    long long* word_lengths, int num_words, int stride, 
    int gen_bound, // How many pairs to add (e.g. 4 => +4L, +4R)
    int check_bound, long long check_steps // Lookahead params
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= num_words) return;

    // Buffer for GENERATION
    long long buffer[MAX_TOTAL_LEN];
    int stack_val[MAX_GEN_DEPTH]; 

    int base_len = (int)word_lengths[idx];
    
    // Position word in center
    int start_ptr = MAX_TOTAL_LEN / 2 - base_len / 2;
    int end_ptr = start_ptr + base_len - 1;

    long long input_offset = (long long)idx * stride;
    for (int i = 0; i < base_len; i++) {
        buffer[start_ptr + i] = input_flat[input_offset + i];
    }

    int depth = 0;
    stack_val[0] = -1; 

    // Generation DFS Loop
    while (depth >= 0) {
        
        // Cleanup previous attempt
        int current_val = stack_val[depth];
        if (current_val != -1) {
             if (depth % 2 == 0) start_ptr++; 
             else end_ptr--;              
        }

        // Try next letter
        stack_val[depth]++;
        int val_code = stack_val[depth];

        if (val_code > 2) {
            stack_val[depth] = -1; 
            depth--;
            continue; 
        }

        long long actual_val = (val_code == 0) ? VAL_A : ((val_code == 1) ? \
VAL_B : VAL_C);
        bool valid = false;

        // Apply Move (Alternating)
        if (depth % 2 == 0) {
            start_ptr--;
            buffer[start_ptr] = actual_val;
            valid = check_left_edge(buffer, start_ptr, end_ptr);
        } else {
            end_ptr++;
            buffer[end_ptr] = actual_val;
            valid = check_right_edge(buffer, start_ptr, end_ptr);
        }

        if (valid) {
            // *** CRITICAL STEP: LOOKAHEAD FILTER ***
            // Before descending, check if this new partial word is viable.
            // Only check if we are NOT at the final depth (optimization)
            int lookahead_status = 0; 
            
            // We run lookahead with the specified small bounds
            lookahead_status = check_viability(
                buffer, start_ptr, end_ptr, 
                depth % 2, // Current side
                check_bound, check_steps
            );

            // If status is 1 (Non-Extendable), we PRUNE this branch.
            // If 0 (Good) or 2 (Undecided), we proceed.
            if (lookahead_status == 1) {
                // Invalid by lookahead -> treat as if aa2f check failed
                valid = false;
                // Loop continues, cleanup happens at top, next letter tried.
            } else {
                // VIABLE.
                
                // If we reached target generation depth
                if (depth >= (2 * gen_bound - 1)) {
                    // SAVE RESULT
                    unsigned long long out_idx = atomicAdd(global_counter, 1);
                    
                    if (out_idx < MAX_OUTPUT_COUNT) {
                        int final_len = end_ptr - start_ptr + 1;
                        output_lengths[out_idx] = final_len;
                        
                        // Copy to global output buffer (flattened)
                        // Output stride is assumed MAX_WORD_LEN (256)
                        long long out_offset = out_idx * MAX_WORD_LEN;
                        for(int k=0; k<final_len; k++) {
                            output_flat[out_offset + k] = buffer[start_ptr + \
k];
                        }
                    }
                    
                    // Don\[CloseCurlyQuote]t break, continue finding other \
solutions (DFS)
                    // If you only wanted ONE solution per word, we\
\[CloseCurlyQuote]d handle differently.
                    // Here we assume we want ALL valid extensions.
                } 
                else {
                    // Go Deeper
                    depth++;
                    if (depth >= MAX_GEN_DEPTH) { break; } // Safety
                    stack_val[depth] = -1; 
                }
            }
        } 
    }
}

// --- HOST HELPERS ---

std::vector<long long> stringToInts(const std::string& s) {
    std::vector<long long> out;
    for(char c : s) {
        if(c == \[OpenCurlyQuote]a\[CloseCurlyQuote]) out.push_back(VAL_A);
        else if(c == \[OpenCurlyQuote]b\[CloseCurlyQuote]) \
out.push_back(VAL_B);
        else if(c == \[OpenCurlyQuote]c\[CloseCurlyQuote]) \
out.push_back(VAL_C);
    }
    return out;
}

std::string intsToString(const long long* ints, int len) {
    std::string s = \[OpenCurlyDoubleQuote]\[CloseCurlyDoubleQuote];
    for(int i=0; i<len; i++) {
        if(ints[i] == VAL_A) s += \[OpenCurlyQuote]a\[CloseCurlyQuote];
        else if(ints[i] == VAL_B) s += \[OpenCurlyQuote]b\[CloseCurlyQuote];
        else if(ints[i] == VAL_C) s += \[OpenCurlyQuote]c\[CloseCurlyQuote];
    }
    return s;
}

int main(int argc, char* argv[]) {
    std::string filename = \[OpenCurlyDoubleQuote]input.txt\
\[CloseCurlyDoubleQuote];
    int gen_bound = 4;
    int check_bound = 10;
    long long check_steps = 50000;

    if (argc > 1) filename = argv[1];
    if (argc > 2) gen_bound = std::atoi(argv[2]);
    if (argc > 3) check_bound = std::atoi(argv[3]);
    if (argc > 4) check_steps = std::atoll(argv[4]);

    // 1. Read File
    std::vector<std::string> words;
    std::ifstream infile(filename);
    if (!infile.is_open()) {
        std::cout << \[OpenCurlyDoubleQuote]Falling back to test word...\
\[CloseCurlyDoubleQuote] << std::endl;
        words.push_back(\[OpenCurlyDoubleQuote]aaabaaacccbccaabbbaccbcc\
\[CloseCurlyDoubleQuote]);
    } else {
        std::string line;
        while (std::getline(infile, line)) {
            if (!line.empty() && line.back() == \[OpenCurlyQuote]\\r\
\[CloseCurlyQuote]) line.pop_back();
            if (!line.empty()) words.push_back(line);
        }
    }
    int num_words = words.size();
    std::cout << \[OpenCurlyDoubleQuote]Words: \[OpenCurlyDoubleQuote] << \
num_words << \[OpenCurlyDoubleQuote]\\nGen Bound: \[OpenCurlyDoubleQuote] << \
gen_bound << \[OpenCurlyDoubleQuote]\\nCheck Bound: \[OpenCurlyDoubleQuote] \
<< check_bound << std::endl;

    // 2. Prepare Input
    int stride = 0;
    for(const auto& w : words) if(w.length() > stride) stride = w.length();
    
    std::vector<long long> h_input(num_words * stride);
    std::vector<long long> h_lens(num_words);
    
    for(int i=0; i<num_words; i++) {
        auto ints = stringToInts(words[i]);
        h_lens[i] = ints.size();
        for(int j=0; j<ints.size(); j++) h_input[i*stride + j] = ints[j];
    }

    // 3. Alloc GPU
    long long *d_input, *d_out_flat, *d_word_lens, *d_out_lens;
    unsigned long long *d_counter;
    
    gpuErrchk( cudaMalloc(&d_input, h_input.size() * sizeof(long long)) );
    gpuErrchk( cudaMalloc(&d_word_lens, h_lens.size() * sizeof(long long)) );
    
    // Output buffers
    // Assume MAX_OUTPUT_COUNT max generated words
    size_t out_buf_size = (size_t)MAX_OUTPUT_COUNT * MAX_WORD_LEN * \
sizeof(long long);
    size_t out_len_size = (size_t)MAX_OUTPUT_COUNT * sizeof(long long);
    
    gpuErrchk( cudaMalloc(&d_out_flat, out_buf_size) );
    gpuErrchk( cudaMalloc(&d_out_lens, out_len_size) );
    gpuErrchk( cudaMalloc(&d_counter, sizeof(unsigned long long)) );
    
    // Init counter to 0
    gpuErrchk( cudaMemset(d_counter, 0, sizeof(unsigned long long)) );

    // Copy Input
    gpuErrchk( cudaMemcpy(d_input, h_input.data(), h_input.size()*sizeof(long \
long), cudaMemcpyHostToDevice) );
    gpuErrchk( cudaMemcpy(d_word_lens, h_lens.data(), \
h_lens.size()*sizeof(long long), cudaMemcpyHostToDevice) );

    // 4. Run
    int blockSize = 128;
    int gridSize = (num_words + blockSize - 1) / blockSize;
    
    std::cout << \[OpenCurlyDoubleQuote]Launching Generator...\
\[CloseCurlyDoubleQuote] << std::endl;
    generateKernel<<<gridSize, blockSize>>>(
        d_input, d_out_flat, d_out_lens, d_counter,
        d_word_lens, num_words, stride,
        gen_bound, check_bound, check_steps
    );
    gpuErrchk( cudaDeviceSynchronize() );

    // 5. Get Count
    unsigned long long total_generated = 0;
    gpuErrchk( cudaMemcpy(&total_generated, d_counter, sizeof(unsigned long \
long), cudaMemcpyDeviceToHost) );
    
    std::cout << \[OpenCurlyDoubleQuote]Total Generated: \
\[OpenCurlyDoubleQuote] << total_generated << std::endl;

    if (total_generated > MAX_OUTPUT_COUNT) {
        std::cerr << \[OpenCurlyDoubleQuote]Warning: Output buffer overflow! \
Results truncated.\[CloseCurlyDoubleQuote] << std::endl;
        total_generated = MAX_OUTPUT_COUNT;
    }

    // 6. Download Results (Only as much as needed)
    std::vector<long long> h_out_flat(total_generated * MAX_WORD_LEN);
    std::vector<long long> h_out_lens(total_generated);

    if (total_generated > 0) {
        gpuErrchk( cudaMemcpy(h_out_flat.data(), d_out_flat, total_generated \
* MAX_WORD_LEN * sizeof(long long), cudaMemcpyDeviceToHost) );
        gpuErrchk( cudaMemcpy(h_out_lens.data(), d_out_lens, total_generated \
* sizeof(long long), cudaMemcpyDeviceToHost) );
    }

    // 7. Write to File
    std::ofstream outfile(\[OpenCurlyDoubleQuote]generated_words.txt\
\[CloseCurlyDoubleQuote]);
    for(size_t i=0; i<total_generated; i++) {
        int len = (int)h_out_lens[i];
        long long* word_ptr = &h_out_flat[i * MAX_WORD_LEN];
        outfile << intsToString(word_ptr, len) << \[OpenCurlyDoubleQuote]\\n\
\[CloseCurlyDoubleQuote];
    }
    outfile.close();
    std::cout << \[OpenCurlyDoubleQuote]Saved to generated_words.txt\
\[CloseCurlyDoubleQuote] << std::endl;

    // Cleanup
    cudaFree(d_input); cudaFree(d_out_flat); cudaFree(d_word_lens); \
cudaFree(d_out_lens); cudaFree(d_counter);

    return 0;
}\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{3.9800928652426777`*^9, 
  3.992873054717972*^9},ExpressionUUID->"7d8f7631-bde8-fd48-8035-\
54babebc98ea"]
}, Closed]],

