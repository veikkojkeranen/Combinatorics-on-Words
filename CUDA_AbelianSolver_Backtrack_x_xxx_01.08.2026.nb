      RowBox[{"-", "STEP"}]}], " ", "5"}], ":", 
    RowBox[{
     RowBox[{"TEST", "--"}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Example", " ", "from", " ", "your", " ", "description"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"\"\<aaabaaacccbccaabbbaccbcc\>\"", " ", "is", " ", "known", " ", 
    "to", " ", "be", " ", "extendable"}], "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"testWords", "=", 
     RowBox[{"{", "\"\<aaabaaacccbccaabbbaccbcc\>\"", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nTesting on: \>\"", ",", "testWords"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Try", " ", "to", " ", "extend", " ", "20", " ", "steps", " ", "Left", " ",
      "AND", " ", "20", " ", "steps", " ", "Right"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"result", "=", 
     RowBox[{"aa2fCheckExtendability", "[", 
      RowBox[{"testWords", ",", "6", ",", "50000"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n--- RESULTS ---\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Extendable (Good): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<Extendable\>\"", "]"}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<NonExtendable (Bad): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<NonExtendable\>\"", "]"}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Undecided (Timeout): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<Undecided\>\"", "]"}], "]"}]}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"result", "[", "\"\<Extendable\>\"", "]"}], "]"}], ">", "0"}],
       ",", 
      RowBox[{
      "Print", "[", "\"\<SUCCESS: The word was correctly identified as \
extendable.\>\"", "]"}]}], "]"}], ";"}]}]}]], "Input",
