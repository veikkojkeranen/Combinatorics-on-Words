       RowBox[{"workDir", ",", "\"\<backtrack.cu\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"dllFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"workDir", ",", "\"\<backtrack.dll\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"cuFile", ",", "cudaSource", ",", "\"\<String\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Setup", " ", "Host", " ", "Compiler"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"clPath", "=", "None"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"compilers", "=", 
     RowBox[{"CCompilers", "[", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "compilers", "]"}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"vsRoot", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"compilers", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<CompilerInstallation\>\"",
           ",", 
          RowBox[{
           RowBox[{"compilers", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           "[", "\"\<CompilerInstallation\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"candidates", "=", 
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<cl.exe\>\"", ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"vsRoot", ",", "\"\<VC\>\""}], "}"}], "]"}], ",", 
          "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"selected", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"candidates", ",", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"#", ",", "\"\<Hostx64\\\\x64\>\""}], "]"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "selected", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"clPath", "=", 
           RowBox[{"DirectoryName", "[", 
            RowBox[{"First", "[", "selected", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Found 64-bit cl.exe at: \>\"", ",", "clPath"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"originalPath", "=", 
           RowBox[{"Environment", "[", "\"\<PATH\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"SetEnvironment", "[", 
           RowBox[{"\"\<PATH\>\"", "->", 
            RowBox[{"clPath", "<>", "\"\<;\>\"", "<>", "originalPath"}]}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<WARNING: Could not find Hostx64\\\\x64\\\\cl.exe \
automatically.\>\"", "]"}], ";"}]}], "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Run", " ", "Compilation"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"cmd", "=", 
     RowBox[{"{", 
      RowBox[{
      "nvccExe", ",", "\"\<-shared\>\"", ",", "\"\<-O3\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_80,code=sm_80\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_120,code=sm_120\>\"", 
       ",", "\"\<-I\>\"", ",", "mathIncPath", ",", "\"\<-o\>\"", ",", 
       "dllFile", ",", "cuFile"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Running NVCC Compilation...\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"proc", "=", 
     RowBox[{"RunProcess", "[", "cmd", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"proc", "[", "\"\<ExitCode\>\"", "]"}], "=!=", "0"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<COMPILATION FAILED!\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<STDOUT: \>\"", ",", 
         RowBox[{"proc", "[", "\"\<StandardOutput\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<STDERR: \>\"", ",", 
         RowBox[{"proc", "[", "\"\<StandardError\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<COMPILATION SUCCESSFUL! DLL: \>\"", ",", "dllFile"}], 
        "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "4"}], ":", 
     RowBox[{
      RowBox[{"MATHEMATICA", " ", 
       RowBox[{"WRAPPER", "--"}]}], "-"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Quiet", "[", 
     RowBox[{"LibraryFunctionUnload", "[", "aa2fBacktrackLib", "]"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"aa2fBacktrackLib", "=", 
     RowBox[{"LibraryFunctionLoad", "[", 
      RowBox[{"dllFile", ",", "\"\<solve_backtrack_entrypoint\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Shared\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         "Integer", ",", "Integer", ",", "Integer", ",", "Integer", ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}]}], 
        " ", 
        RowBox[{"(*", 
         RowBox[{"Perm", " ", "Tensor"}], "*)"}], "}"}], ",", "Integer"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valMap", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<b\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<c\>\"", "->", "65536"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"stringToCudaInts", "[", "str_String", "]"}], ":=", 
     RowBox[{"Replace", "[", 
      RowBox[{
       RowBox[{"Characters", "[", "str", "]"}], ",", "valMap", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fCheckExtendability", "]"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Updated", " ", "to", " ", "accept", " ", "String", " ", "OR", " ", 
     "List", " ", "for", " ", "searchOrder"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fCheckExtendability", "[", 
      RowBox[{"words_List", ",", "extBound_Integer", ",", 
       RowBox[{"maxSteps_Integer", ":", "100000"}], ",", 
       RowBox[{"searchOrder_", ":", "\"\<abc\>\""}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numWords", ",", "stride", ",", "wordLengths", ",", "flatInput", ",", 
         "flatResults", ",", "err", ",", "permInts", ",", "permList"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"numWords", "=", 
         RowBox[{"Length", "[", "words", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"stride", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"StringLength", "/@", "words"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"processedList", "=", 
         RowBox[{"stringToCudaInts", "/@", "words"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wordLengths", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Length", "/@", "processedList"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"flatInput", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"processedList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"stride", "-", 
                  RowBox[{"wordLengths", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "numWords"}], "}"}]}], "]"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"flatResults", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "numWords"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Handle", " ", "String", " ", "vs", " ", "List", " ", "for", " ", 
          "Permutation"}], "*)"}], 
        RowBox[{"permList", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringQ", "[", "searchOrder", "]"}], ",", 
           RowBox[{"Characters", "[", "searchOrder", "]"}], ",", 
           "searchOrder"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"permInts", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Replace", "[", 
           RowBox[{"permList", ",", "valMap", ",", 
            RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "permInts", "]"}], "!=", "3"}], ",", 
          RowBox[{
           RowBox[{
           "Print", 
            "[", "\"\<Error: searchOrder must have exactly 3 elements (e.g. \
\\\"abc\\\" or {\\\"a\\\",\\\"b\\\",\\\"c\\\"}).\>\"", "]"}], ";", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Pass", " ", "Permutation", " ", "to", " ", "Library"}], 
         "*)"}], 
        RowBox[{"err", "=", 
         RowBox[{"aa2fBacktrackLib", "[", 
          RowBox[{
          "flatInput", ",", "flatResults", ",", "wordLengths", ",", 
           "numWords", ",", "stride", ",", "extBound", ",", "maxSteps", ",", 
           "permInts"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"err", "=!=", "0"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<CRITICAL CUDA ERROR: \>\"", ",", "err"}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"err", ">", "30000"}], ",", 
             RowBox[{
             "Print", 
              "[", "\"\<Error type: Kernel Execution Failed (e.g. TDR/Timeout \
or Crash)\>\"", "]"}]}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Extendable\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "0"}], "]"}]}], ",", 
          RowBox[{"\"\<NonExtendable\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "1"}], "]"}]}], ",", 
          RowBox[{"\"\<Undecided\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "2"}], "]"}]}], ",", 
          RowBox[{"\"\<Error_BufferOverflow\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", 
             RowBox[{"-", "2"}]}], "]"}]}], ",", 
          RowBox[{"\"\<Error_StackOverflow\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", 
             RowBox[{"-", "3"}]}], "]"}]}], ",", 
          RowBox[{"\"\<Error_ExecutionFailed\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", 
             RowBox[{"-", "1"}]}], "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "6"}], ":", 
     RowBox[{
      RowBox[{"ROTATIONAL", " ", "AUTOMATIC", " ", "SOLVER", " ", 
       RowBox[{
        RowBox[{"(", "UPDATED", ")"}], "--"}]}], "-"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fSolveRotational", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fSolveRotational", "[", 
      RowBox[{"initialWords_List", ",", "extBound_Integer", ",", 
       RowBox[{"maxSteps_Integer", ":", "50000"}], ",", 
       RowBox[{"outputDir_String", ":", 
        RowBox[{"Directory", "[", "]"}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"currentWords", ",", "results", ",", 
         RowBox[{"totalExtendable", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"totalNonExtendable", "=", 
          RowBox[{"{", "}"}]}], ",", "permutations", ",", "pStr"}], "}"}], ",", 
       RowBox[{
        RowBox[{"currentWords", "=", "initialWords"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"permutations", "=", 
         RowBox[{"{", 
          
          RowBox[{"\"\<abc\>\"", ",", "\"\<cba\>\"", ",", "\"\<bac\>\"", 
           ",", "\"\<bca\>\"", ",", "\"\<cab\>\"", ",", "\"\<acb\>\""}], 
          "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", "\"\<\\n=== STARTING ROTATIONAL ATTACK ===\>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Total words: \>\"", ",", 
          RowBox[{"Length", "[", "currentWords", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Max Steps per Phase: \>\"", ",", "maxSteps"}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Output Directory: \>\"", ",", "outputDir"}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"pStr", "=", 
            RowBox[{"permutations", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "currentWords", "]"}], "==", "0"}], ",", 
             RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<\\n--- Phase \>\"", ",", "i", ",", "\"\<: Order \>\"",
              ",", "pStr", ",", "\"\< ---\>\""}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Processing \>\"", ",", 
             RowBox[{"Length", "[", "currentWords", "]"}], 
             ",", "\"\< Undecided words...\>\""}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Run", " ", "Core", " ", "Solver", " ", "with", " ", "current", " ",
              "permutation"}], "*)"}], 
           RowBox[{"results", "=", 
            RowBox[{"aa2fCheckExtendability", "[", 
             RowBox[{
             "currentWords", ",", "extBound", ",", "maxSteps", ",", "pStr"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Collect", " ", "Finished", " ", "Results"}], "*)"}], 
           RowBox[{"totalExtendable", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"totalExtendable", ",", 
              RowBox[{"results", "[", "\"\<Extendable\>\"", "]"}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"totalNonExtendable", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"totalNonExtendable", ",", 
              RowBox[{"results", "[", "\"\<NonExtendable\>\"", "]"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<  -> Extendable_\>\"", ",", "pStr", 
             ",", "\"\< (Good): \>\"", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"results", "[", "\"\<Extendable\>\"", "]"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<  -> NonExtendable_\>\"", ",", "pStr", 
             ",", "\"\< (Bad): \>\"", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"results", "[", "\"\<NonExtendable\>\"", "]"}], "]"}]}],
             "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<  -> Undecided_\>\"", ",", "pStr", 
             ",", "\"\< (Timeout): \>\"", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"results", "[", "\"\<Undecided\>\"", "]"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"SAVE", " ", "INTERMEDIATE", " ", "FILES"}], "*)"}], 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"results", "[", "\"\<Extendable\>\"", "]"}], "]"}], ">",
               "0"}], ",", 
             RowBox[{"Export", "[", 
              RowBox[{
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"outputDir", ",", 
                  
                  RowBox[{"\"\<Extendable_\>\"", "<>", "pStr", 
                   "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", 
               RowBox[{"results", "[", "\"\<Extendable\>\"", "]"}], 
               ",", "\"\<Table\>\""}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"results", "[", "\"\<NonExtendable\>\"", "]"}], "]"}], 
              ">", "0"}], ",", 
             RowBox[{"Export", "[", 
              RowBox[{
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"outputDir", ",", 
                  
                  RowBox[{"\"\<Non_Extendable_\>\"", "<>", "pStr", 
                   "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", 
               RowBox[{"results", "[", "\"\<NonExtendable\>\"", "]"}], 
               ",", "\"\<Table\>\""}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"results", "[", "\"\<Undecided\>\"", "]"}], "]"}], ">",
               "0"}], ",", 
             RowBox[{"Export", "[", 
              RowBox[{
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"outputDir", ",", 
                  
                  RowBox[{"\"\<Undecided_\>\"", "<>", "pStr", 
                   "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", 
               RowBox[{"results", "[", "\"\<Undecided\>\"", "]"}], 
               ",", "\"\<Table\>\""}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Prepare", " ", "for", " ", "next", " ", "pass"}], "*)"}], 
           RowBox[{"currentWords", "=", 
            RowBox[{"results", "[", "\"\<Undecided\>\"", "]"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "permutations", "]"}]}], "}"}]}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Final", " ", "Report"}], "*)"}], 
        RowBox[{
        "Print", "[", "\"\<\\n=== FINAL RESULTS AFTER 6 PHASES ===\>\"", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Total Extendable: \>\"", ",", 
          RowBox[{"Length", "[", "totalExtendable", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Total NonExtendable: \>\"", ",", 
          RowBox[{"Length", "[", "totalNonExtendable", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Remaining Undecided (Hardest): \>\"", ",", 
          RowBox[{"Length", "[", "currentWords", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Extendable\>\"", "->", "totalExtendable"}], ",", 
          RowBox[{"\"\<NonExtendable\>\"", "->", "totalNonExtendable"}], ",", 
          RowBox[{"\"\<Undecided\>\"", "->", "currentWords"}]}], "|>"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
