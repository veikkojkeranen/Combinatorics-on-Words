   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "compilers", "]"}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"vsRoot", "=", 
        RowBox[{"Lookup", "[", 
