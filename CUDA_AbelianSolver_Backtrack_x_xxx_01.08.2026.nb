   RowBox[{
   "Try", " ", "to", " ", "extend", " ", "N", " ", "steps", " ", "Left", " ", 
    "AND", " ", "N", " ", "steps", " ", "Right"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Short", "[", 
