Cell[CellGroupData[{

Cell["\<\
(* CASE OF VAL_A <---> VAL_C THE OLD VERSION *) code below ...\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.9777491242929535`*^9, 3.9777491842489395`*^9}},
 FontWeight->"Bold",
 Background->RGBColor[
  0, 0.74, 0.74, 0.33],ExpressionUUID->"2c7fed10-313e-474e-9fe6-cb9bd2a38593"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"CASE", " ", "OF", " ", "VAL_A"}], " ", "<", "--"}], "->", " ", 
    RowBox[{"VAL_C", " ", "THE", " ", "OLD", " ", "VERSION"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", "STEP"}]}], " ", "1"}], ":", "CONFIGURATION"}], "&"}], " ", 
     RowBox[{"PATHS", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- Configuring Backtracking Solver ---\>\"", "]"}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "PATHS", " ", 
     RowBox[{"(", 
      RowBox[{
      "Verify", " ", "these", " ", "match", " ", "your", " ", "system"}], 
      ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "cudaBinPath", 
     "=", "\"\<C:\\\\Program Files\\\\NVIDIA GPU Computing \
Toolkit\\\\CUDA\\\\v13.1\\\\bin\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nvccExe", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"cudaBinPath", ",", "\"\<nvcc.exe\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"mathIncPath", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "$InstallationDirectory", ",", "\"\<SystemFiles\>\"", 
        ",", "\"\<IncludeFiles\>\"", ",", "\"\<C\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "nvccExe", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<CRITICAL ERROR: nvcc.exe not found at: \>\"", ",", 
         "nvccExe"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Targeting NVCC: \>\"", ",", "nvccExe"}], "]"}], ";"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "2"}], ":", 
     RowBox[{
      RowBox[{"CUDA", " ", "BACKTRACKING", " ", 
       RowBox[{"KERNEL", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"This", " ", 
     RowBox[{"C", "++"}], " ", "code", " ", "implements", " ", "an", " ", 
     "iterative", " ", "DFS", " ", 
     RowBox[{"(", 
      RowBox[{"Depth", " ", "First", " ", "Search"}], ")"}], " ", "on", " ", 
     "the", " ", "GPU"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "cudaSource", 
     "=", "\"\<\n#include <cuda_runtime.h>\n#include <stdio.h>\n#include \
\\\"WolframLibrary.h\\\" \n\n// Value mapping for Parikh Trick: A=0, B=1, \
C=65536\n#define VAL_A 0\n#define VAL_B 1\n#define VAL_C 65536\n\n#define \
MAX_TOTAL_LEN 512 \n#define MAX_DEPTH 256\n\n__device__ bool \
check_left_edge(long long* buf, int start, int end) {\n    int len = end - \
start + 1;\n    int max_k = len / 2;\n    // FIX: Start k at 2 to allow 'aa' \
(Period 1) but forbid 'abab' (Period 2+)\n    for (int k = 2; k <= max_k; \
k++) {\n        long long sum_u = 0;\n        long long sum_v = 0;\n        \
for (int i = 0; i < k; i++) sum_u += buf[start + i];\n        for (int i = 0; \
i < k; i++) sum_v += buf[start + k + i];\n        if (sum_u == sum_v) return \
false;\n    }\n    return true;\n}\n\n__device__ bool check_right_edge(long \
long* buf, int start, int end) {\n    int len = end - start + 1;\n    int \
max_k = len / 2;\n    // FIX: Start k at 2 to allow 'aa' (Period 1) but \
forbid 'abab' (Period 2+)\n    for (int k = 2; k <= max_k; k++) {\n        \
long long sum_u = 0;\n        long long sum_v = 0;\n        for (int i = 0; i \
< k; i++) sum_v += buf[end - i];\n        for (int i = 0; i < k; i++) sum_u \
+= buf[end - k - i];\n        if (sum_u == sum_v) return false;\n    }\n    \
return true;\n}\n\n__global__ void backtrackKernel(\n    long long* \
input_flat, long long* results, long long* word_lengths, \n    int num_words, \
int stride, int extension_bound, long long max_steps\n) {\n    int idx = \
blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx >= num_words) return;\n\n \
   // 1. Setup Local Workspace\n    long long buffer[MAX_TOTAL_LEN];\n    int \
stack_val[MAX_DEPTH]; \n\n    int base_len = (int)word_lengths[idx];\n    int \
start_ptr = MAX_TOTAL_LEN / 2 - base_len / 2;\n    int end_ptr = start_ptr + \
base_len - 1;\n\n    // Safety check for bounds\n    if (start_ptr < 0 || \
end_ptr >= MAX_TOTAL_LEN) {\n        results[idx] = -2; // Error: Word too \
long for buffer\n        return;\n    }\n\n    long long input_offset = idx * \
stride;\n    for (int i = 0; i < base_len; i++) {\n        buffer[start_ptr + \
i] = input_flat[input_offset + i];\n    }\n\n    int depth = 0;\n    \
stack_val[0] = -1; \n    long long steps = 0;\n    int status = 1; // \
Default: Non-Extendable\n\n    // 3. Search Loop\n    while (depth >= 0) {\n  \
      steps++;\n        if (steps > max_steps) {\n            status = 2; // \
Timeout\n            break;\n        }\n\n        // --- CLEANUP PREVIOUS \
ATTEMPT ---\n        int current_val = stack_val[depth];\n        if \
(current_val != -1) {\n             if (depth % 2 == 0) start_ptr++; // Undo \
Left\n             else end_ptr--;              // Undo Right\n        }\n\n  \
      // --- TRY NEXT VALUE ---\n        stack_val[depth]++;\n        int \
val_code = stack_val[depth];\n\n        // Exhausted?\n        if (val_code > \
2) {\n            stack_val[depth] = -1; // Reset for next entry\n            \
depth--;\n            continue; // Go up to handle depth-1\n        }\n\n     \
   // Apply Move\n        long long actual_val = VAL_C;\n        if (val_code \
== 1) actual_val = VAL_B;\n        if (val_code == 2) actual_val = VAL_A;\n\n \
       bool valid = false;\n        \n        // Safety check for bounds \
before writing\n        if (start_ptr <= 0 || end_ptr >= MAX_TOTAL_LEN - 1) {\
\n             status = -3; // Error: Overflow\n             break;\n        \
}\n\n        if (depth % 2 == 0) {\n            start_ptr--;\n            \
buffer[start_ptr] = actual_val;\n            valid = check_left_edge(buffer, \
start_ptr, end_ptr);\n        } else {\n            end_ptr++;\n            \
buffer[end_ptr] = actual_val;\n            valid = check_right_edge(buffer, \
start_ptr, end_ptr);\n        }\n\n        if (valid) {\n            // \
Reached target?\n            if (depth >= (2 * extension_bound - 1)) {\n      \
          status = 0; // Success\n                break;\n            }\n     \
       // Go deeper\n            depth++;\n            if (depth >= \
MAX_DEPTH) { status = -4; break; } // Error: Depth limit\n            \
stack_val[depth] = -1; \n        } \n    }\n\n    results[idx] = (long \
long)status;\n}\n\nextern \\\"C\\\" DLLEXPORT int \
solve_backtrack_entrypoint(WolframLibraryData libData, mint Argc, MArgument \
*Args, MArgument Res) {\n    MTensor inputT = MArgument_getMTensor(Args[0]);\n\
    MTensor resultsT = MArgument_getMTensor(Args[1]);\n    MTensor lengthsT = \
MArgument_getMTensor(Args[2]);\n    mint num_words = \
MArgument_getInteger(Args[3]);\n    mint stride = \
MArgument_getInteger(Args[4]);\n    mint ext_bound = \
MArgument_getInteger(Args[5]);\n    mint max_steps = \
MArgument_getInteger(Args[6]);\n\n    long long *input = (long \
long*)libData->MTensor_getIntegerData(inputT);\n    long long *results = \
(long long*)libData->MTensor_getIntegerData(resultsT);\n    long long \
*lengths = (long long*)libData->MTensor_getIntegerData(lengthsT);\n\n    long \
long *d_input, *d_lengths, *d_results;\n    cudaError_t err;\n    \n    \
size_t input_size = num_words * stride * sizeof(long long);\n    size_t \
results_size = num_words * sizeof(long long); // FIXED: 64-bit integers\n    \
size_t lengths_size = num_words * sizeof(long long);\n\n    err = \
cudaMalloc(&d_input, input_size);\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n    \n    \
err = cudaMalloc(&d_results, results_size);\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n    \n    \
err = cudaMalloc(&d_lengths, lengths_size);\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n\n    // \
Initialize Result Buffer to -1 (Detect Skipped Execution)\n    \
cudaMemset(d_results, -1, results_size);\n\n    cudaMemcpy(d_input, input, \
input_size, cudaMemcpyHostToDevice);\n    cudaMemcpy(d_lengths, lengths, \
lengths_size, cudaMemcpyHostToDevice);\n    \n    int blockSize = 128;\n    \
int gridSize = (int)((num_words + blockSize - 1) / blockSize);\n    \n    \
backtrackKernel<<<gridSize, blockSize>>>(\n        d_input, d_results, \
d_lengths, \n        (int)num_words, (int)stride, (int)ext_bound, (long \
long)max_steps\n    );\n\n    // Strict Error Checking\n    err = \
cudaGetLastError();\n    if(err != cudaSuccess) { MArgument_setInteger(Res, \
20000 + (mint)err); return LIBRARY_NO_ERROR; }\n\n    err = \
cudaDeviceSynchronize(); \n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, 30000 + (mint)err); return LIBRARY_NO_ERROR; }\n\n  \
  cudaMemcpy(results, d_results, results_size, cudaMemcpyDeviceToHost);\n\n   \
 cudaFree(d_input);\n    cudaFree(d_results);\n    cudaFree(d_lengths);\n\n   \
 MArgument_setInteger(Res, 0); // Success\n    return LIBRARY_NO_ERROR;\n}\n\
\>\""}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "3"}], ":", 
     RowBox[{
      RowBox[{"COMPILE", "--"}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"workDir", "=", 
     RowBox[{"CreateDirectory", "[", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cuFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"workDir", ",", "\"\<backtrack.cu\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"dllFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"workDir", ",", "\"\<backtrack.dll\>\""}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"cuFile", ",", "cudaSource", ",", "\"\<String\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Setup", " ", "Host", " ", "Compiler"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"clPath", "=", "None"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"compilers", "=", 
     RowBox[{"CCompilers", "[", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "compilers", "]"}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"vsRoot", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"compilers", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<CompilerInstallation\>\"",
           ",", 
          RowBox[{
           RowBox[{"compilers", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           "[", "\"\<CompilerInstallation\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"candidates", "=", 
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<cl.exe\>\"", ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"vsRoot", ",", "\"\<VC\>\""}], "}"}], "]"}], ",", 
          "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"selected", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"candidates", ",", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"#", ",", "\"\<Hostx64\\\\x64\>\""}], "]"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "selected", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"clPath", "=", 
           RowBox[{"DirectoryName", "[", 
            RowBox[{"First", "[", "selected", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Found 64-bit cl.exe at: \>\"", ",", "clPath"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"originalPath", "=", 
           RowBox[{"Environment", "[", "\"\<PATH\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"SetEnvironment", "[", 
           RowBox[{"\"\<PATH\>\"", "->", 
            RowBox[{"clPath", "<>", "\"\<;\>\"", "<>", "originalPath"}]}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<WARNING: Could not find Hostx64\\\\x64\\\\cl.exe \
automatically.\>\"", "]"}], ";"}]}], "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Run", " ", "Compilation"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cmd", "=", 
     RowBox[{"{", 
      RowBox[{
      "nvccExe", ",", "\"\<-shared\>\"", ",", "\"\<-O3\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_80,code=sm_80\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_120,code=sm_120\>\"", 
       ",", "\"\<-I\>\"", ",", "mathIncPath", ",", "\"\<-o\>\"", ",", 
       "dllFile", ",", "cuFile"}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Running NVCC Compilation...\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"proc", "=", 
     RowBox[{"RunProcess", "[", "cmd", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"proc", "[", "\"\<ExitCode\>\"", "]"}], "=!=", "0"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<COMPILATION FAILED!\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<STDOUT: \>\"", ",", 
         RowBox[{"proc", "[", "\"\<StandardOutput\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<STDERR: \>\"", ",", 
         RowBox[{"proc", "[", "\"\<StandardError\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<COMPILATION SUCCESSFUL! DLL: \>\"", ",", "dllFile"}], 
        "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "4"}], ":", 
     RowBox[{
      RowBox[{"MATHEMATICA", " ", 
       RowBox[{"WRAPPER", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Quiet", "[", 
     RowBox[{"LibraryFunctionUnload", "[", "aa2fBacktrackLib", "]"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"aa2fBacktrackLib", "=", 
     RowBox[{"LibraryFunctionLoad", "[", 
      RowBox[{"dllFile", ",", "\"\<solve_backtrack_entrypoint\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Shared\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         "Integer", ",", "Integer", ",", "Integer", ",", "Integer"}], "}"}], ",",
        "Integer"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"valMap", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<b\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<c\>\"", "->", "65536"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"stringToCudaInts", "[", "str_String", "]"}], ":=", 
     RowBox[{"Replace", "[", 
      RowBox[{
       RowBox[{"Characters", "[", "str", "]"}], ",", "valMap", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fCheckExtendability", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fCheckExtendability", "[", 
      RowBox[{"words_List", ",", "extBound_Integer", ",", 
       RowBox[{"maxSteps_Integer", ":", "100000"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numWords", ",", "stride", ",", "wordLengths", ",", "flatInput", ",", 
         "flatResults", ",", "err"}], "}"}], ",", 
       RowBox[{
        RowBox[{"numWords", "=", 
         RowBox[{"Length", "[", "words", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"stride", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"StringLength", "/@", "words"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"processedList", "=", 
         RowBox[{"stringToCudaInts", "/@", "words"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wordLengths", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Length", "/@", "processedList"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"flatInput", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"processedList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"stride", "-", 
                  RowBox[{"wordLengths", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "numWords"}], "}"}]}], "]"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"flatResults", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "numWords"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"err", "=", 
         RowBox[{"aa2fBacktrackLib", "[", 
          RowBox[{
          "flatInput", ",", "flatResults", ",", "wordLengths", ",", 
           "numWords", ",", "stride", ",", "extBound", ",", "maxSteps"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"err", "=!=", "0"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<CRITICAL CUDA ERROR: \>\"", ",", "err"}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"err", ">", "30000"}], ",", 
             RowBox[{
             "Print", 
              "[", "\"\<Error type: Kernel Execution Failed (e.g. TDR/Timeout \
or Crash)\>\"", "]"}]}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"DEBUG", ":", 
          RowBox[{
          "Check", " ", "if", " ", "we", " ", "have", " ", "any", " ", 
           "unexpected", " ", "values"}]}], "*)"}], 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Debug: Results distribution: \>\"", ",", 
          RowBox[{"Tally", "[", "flatResults", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Extendable\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "0"}], "]"}]}], ",", 
          RowBox[{"\"\<NonExtendable\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "1"}], "]"}]}], ",", 
          RowBox[{"\"\<Undecided\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "2"}], "]"}]}], ",", 
          RowBox[{"\"\<Error_BufferOverflow\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", 
             RowBox[{"-", "2"}]}], "]"}]}], ",", 
          RowBox[{"\"\<Error_StackOverflow\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", 
             RowBox[{"-", "3"}]}], "]"}]}], ",", 
          RowBox[{"\"\<Error_ExecutionFailed\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", 
             RowBox[{"-", "1"}]}], "]"}]}]}], " ", 
         RowBox[{"(*", 
          RowBox[{"Initial", " ", "Value", " ", "Unchanged"}], "*)"}], 
         "|>"}]}]}], "]"}]}], ";"}]}]}]], "Input",
