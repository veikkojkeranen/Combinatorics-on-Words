Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "aa2fTestList3let", "]"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Use", " ", "this", " ", "version"}], ",", " ", 
    RowBox[{
    "if", " ", "you", " ", "wish", " ", "to", " ", "see", " ", "intermediate",
      " ", "results", " ", "consisting", " ", "of", " ", "monomials", " ", 
     "and", " ", "variable", " ", 
     RowBox[{"substitutions", "/", 
      RowBox[{"rules", ".", " ", "The"}]}], " ", "version", " ", "below", " ",
      "this", " ", "one", " ", "is", " ", "identical", " ", "but", " ", 
     "shows", " ", "only", " ", "the", " ", "final", " ", "words", " ", 
     "after", " ", 
     RowBox[{"substitutions", "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aa2fTestList3let", "[", 
    RowBox[{"linList_", ",", " ", "vars_String", ",", " ", 
     RowBox[{"outputType_Integer", ":", "1"}]}], "]"}], ":=", "\n", "\t", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"replWithList", ",", "replLinList", ",", "res", ",", "pr", ",", 
       RowBox[{"silmu", "=", "3"}]}], "}"}], ",", " ", "\n", "\t\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"replWithList", "=", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"StringTake", "[", 
                 RowBox[{"vars", ",", " ", 
                  RowBox[{"{", "1", "}"}]}], "]"}], "->", "#"}], ",", 
               RowBox[{"linList", "/.", 
                RowBox[{
                 RowBox[{"StringTake", "[", 
                  RowBox[{"vars", ",", " ", 
                   RowBox[{"{", "1", "}"}]}], "]"}], "->", "#"}]}]}], "}"}], 
             ")"}], "&"}], "/@", 
           RowBox[{"Characters", "[", "\"\<abc\>\"", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"_", ",", "0"}], "}"}]}], "]"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", "\t   ", 
     RowBox[{
      RowBox[{"replWithList", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"StringTake", "[", 
                RowBox[{"vars", ",", " ", 
                 RowBox[{"{", "1", "}"}]}], "]"}], "->", "#"}], ",", 
              RowBox[{"Catch", "[", 
               RowBox[{
                RowBox[{"Do", "[", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"substLinList", "=", 
                    RowBox[{"(", 
                    RowBox[{"linList", "/.", 
                    RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"vars", ",", " ", 
                    RowBox[{"{", "1", "}"}]}], "]"}], "->", "#"}]}], ")"}]}], 
                    ")"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "==", "0"}], ",", 
                    RowBox[{"Throw", "[", "0", "]"}]}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", " ", "[", "linList", "]"}]}], "}"}]}], 
                 "]"}], ";", "substLinList"}], "]"}]}], "}"}], ")"}], "&"}], 
          " ", "/@", " ", 
          RowBox[{"Characters", "[", "\"\<abc\>\"", "]"}]}], " ", ",", 
         RowBox[{"{", 
          RowBox[{"_", ",", "0"}], "}"}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<replWithList = \>\"", ",", "replWithList"}], "]"}], ";", 
      "    ", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Catch", "[", 
            RowBox[{
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"replLinList", "=", 
                    RowBox[{"linList", "/.", 
                    RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"vars", ",", " ", 
                    RowBox[{"{", "1", "}"}]}], "]"}], "->", "#"}]}]}], ")"}], 
                   "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "==", "0"}], ",", 
                 RowBox[{"Throw", "[", "0", "]"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", " ", "[", "linList", "]"}]}], "}"}]}], 
              "]"}], ";", "replLinList"}], "]"}], "&"}], " ", "/@", " ", 
          RowBox[{"Characters", "[", "\"\<abc\>\"", "]"}]}], " ", "//", 
         "Flatten"}], ";"}], "*)"}], "\n", "\t\t", 
      RowBox[{"(*", 
       RowBox[{"polyListWithoutDeleteCases", ";", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<polyList =\>\"", ",", "polyList"}], "]"}], ";"}], 
       "*)"}], "\n", "\t\t", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<polyListWithoutDeleteCases =\>\"", ",", 
          "polyListWithoutDeleteCases"}], "]"}], ";"}], "*)"}], " ", 
      "\[IndentingNewLine]", "\t\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"StringLength", "[", "vars", "]"}], "==", "1"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Take", "[", 
            RowBox[{"#", ",", "1"}], "]"}], "&"}], "/@", "replWithList"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", "\t\t", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"replWithList", "==", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}], ",", 
          RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "*)"}], " ", "\n", 
      "\t\t", 
      RowBox[{"res", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", 
             RowBox[{"aa2fSolveList3let", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"StringTake", "[", 
                RowBox[{"vars", ",", 
                 RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], "}"}], "&"}], "/@",
           "replWithList"}], ",", 
         RowBox[{"{", 
          RowBox[{"_", ",", 
           RowBox[{"{", "}"}]}], "}"}]}], "]"}]}], ";", "\n", "\t\t", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<res1 =\>\"", ",", "res"}], "]"}], ";"}], "*)"}], " ", 
      "\n", "\t\t", 
      RowBox[{"pr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Outer", "[", 
           RowBox[{"List", ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", "res"}], "//", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";", "\n", "\t\t", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<pr1 = \>\"", ",", "pr"}], "]"}], ";"}], "*)"}], " ", 
      "\n", "\t\t", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"silmu", "<=", 
         RowBox[{"StringLength", "[", "vars", "]"}]}], ",", "\n", "\t\t\t", 
        RowBox[{
         RowBox[{"replWithList", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", 
              RowBox[{"linList", "/.", "#"}]}], "}"}], "&"}], "/@", "pr"}]}], 
         ";", "\n", "\t\t\t", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", "polyList", "]"}], ";"}], "*)"}], " ", "\n", 
         "\t\t\t", 
         RowBox[{"res", "=", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", 
                RowBox[{"aa2fSolveList3let", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"StringTake", "[", 
                   RowBox[{"vars", ",", " ", 
                    RowBox[{"{", "silmu", "}"}]}], "]"}]}], "]"}]}], "}"}], 
              "&"}], "/@", "replWithList"}], ",", 
            RowBox[{"{", 
             RowBox[{"_", ",", 
              RowBox[{"{", "}"}]}], "}"}]}], "]"}]}], ";", "\n", "\t\t\t", 
         RowBox[{"pr", "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Outer", "[", 
              RowBox[{"List", ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", "1", ",", "1"}], "]"}], 
             "&"}], "/@", "res"}], "//", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";", "\n", "\t\t\t", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<pr = \>\"", ",", "pr"}], "]"}], ";"}], "*)"}], " ", 
         "\n", "\t\t\t", 
         RowBox[{"pr", "=", 
