 Background->RGBColor[
  0.95, 0.43, 0.96, 
   0.33],ExpressionUUID->"006d49a4-ebb5-b343-bb17-3a54cdb7d9e7"],

Cell["\<\
#include <iostream>
#include <fstream>
#include <vector>
#include <string>
#include <algorithm>
#include <cuda_runtime.h>

// --- CONFIGURATION ---
// Value mapping: A=0, B=1, C=65536
#define VAL_A 0
#define VAL_B 1
#define VAL_C 65536

#define MAX_TOTAL_LEN 512 
#define MAX_DEPTH 256

// Error Check Macro
#define gpuErrchk(ans) { gpuAssert((ans), __FILE__, __LINE__); }
inline void gpuAssert(cudaError_t code, const char *file, int line, bool \
abort=true) {
   if (code != cudaSuccess) {
      fprintf(stderr,\[CloseCurlyDoubleQuote]GPUassert: %s %s %d\\n\
\[CloseCurlyDoubleQuote], cudaGetErrorString(code), file, line);
      if (abort) exit(code);
   }
}

// --- DEVICE KERNELS ---

__device__ bool check_left_edge(long long* buf, int start, int end) {
    int len = end - start + 1;
    int max_k = len / 2;
    for (int k = 2; k <= max_k; k++) {
        long long sum_u = 0;
        long long sum_v = 0;
        for (int i = 0; i < k; i++) sum_u += buf[start + i];
        for (int i = 0; i < k; i++) sum_v += buf[start + k + i];
        if (sum_u == sum_v) return false;
    }
    return true;
}

__device__ bool check_right_edge(long long* buf, int start, int end) {
    int len = end - start + 1;
    int max_k = len / 2;
    for (int k = 2; k <= max_k; k++) {
        long long sum_u = 0;
        long long sum_v = 0;
        for (int i = 0; i < k; i++) sum_v += buf[end - i];
        for (int i = 0; i < k; i++) sum_u += buf[end - k - i];
        if (sum_u == sum_v) return false;
    }
    return true;
}

__global__ void backtrackKernel(
    long long* input_flat, long long* results, long long* word_lengths, 
    int num_words, int stride, int extension_bound, long long max_steps,
    long long p0, long long p1, long long p2 // Search Order
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= num_words) return;

    // Local Workspace
    long long buffer[MAX_TOTAL_LEN];
    int stack_val[MAX_DEPTH]; 

    int base_len = (int)word_lengths[idx];
    int start_ptr = MAX_TOTAL_LEN / 2 - base_len / 2;
    int end_ptr = start_ptr + base_len - 1;

    // Safety
    if (start_ptr < 0 || end_ptr >= MAX_TOTAL_LEN) {
        results[idx] = -2; // Error: Buffer too small
        return;
    }

    // Load Input
    long long input_offset = (long long)idx * stride;
    for (int i = 0; i < base_len; i++) {
        buffer[start_ptr + i] = input_flat[input_offset + i];
    }

    int depth = 0;
    stack_val[0] = -1; 
    long long steps = 0;
    int status = 1; // Default: 1 = Non-Extendable (Bad)

    // DFS Loop
    while (depth >= 0) {
        steps++;
        if (steps > max_steps) {
            status = 2; // 2 = Undecided (Timeout)
            break;
        }

        // Cleanup previous attempt at this depth
        int current_val = stack_val[depth];
        if (current_val != -1) {
             if (depth % 2 == 0) start_ptr++; // Undo Left
             else end_ptr--;              // Undo Right
        }

        // Try next value
        stack_val[depth]++;
        int val_code = stack_val[depth];

        // Exhausted options at this depth?
        if (val_code > 2) {
            stack_val[depth] = -1; 
            depth--;
            continue; 
        }

        // Apply Move (Using Permutation p0, p1, p2)
        long long actual_val = p0;
        if (val_code == 1) actual_val = p1;
        if (val_code == 2) actual_val = p2;

        bool valid = false;
        
        // Bounds Check
        if (start_ptr <= 0 || end_ptr >= MAX_TOTAL_LEN - 1) {
             status = -3; // Stack Overflow
             break;
        }

        if (depth % 2 == 0) {
            start_ptr--;
            buffer[start_ptr] = actual_val;
            valid = check_left_edge(buffer, start_ptr, end_ptr);
        } else {
            end_ptr++;
            buffer[end_ptr] = actual_val;
            valid = check_right_edge(buffer, start_ptr, end_ptr);
        }

        if (valid) {
            // Check Success
            if (depth >= (2 * extension_bound - 1)) {
                status = 0; // 0 = Extendable (Good)
                break;
            }
            // Go Deeper
            depth++;
            if (depth >= MAX_DEPTH) { status = -4; break; }
            stack_val[depth] = -1; 
        } 
    }

    results[idx] = (long long)status;
}

// --- HOST HELPERS ---

// Convert string \[OpenCurlyDoubleQuote]abc...\[CloseCurlyDoubleQuote] to \
integer vector
std::vector<long long> stringToInts(const std::string& s) {
    std::vector<long long> out;
    for(char c : s) {
        if(c == \[OpenCurlyQuote]a\[CloseCurlyQuote]) out.push_back(VAL_A);
        else if(c == \[OpenCurlyQuote]b\[CloseCurlyQuote]) \
out.push_back(VAL_B);
        else if(c == \[OpenCurlyQuote]c\[CloseCurlyQuote]) \
out.push_back(VAL_C);
    }
    return out;
}

// Helper to map \[OpenCurlyQuote]a\[CloseCurlyQuote],\[CloseCurlyQuote]b\
\[CloseCurlyQuote],\[CloseCurlyQuote]c\[CloseCurlyQuote] chars to their \
values for the permutation
long long charToVal(char c) {
    if (c == \[OpenCurlyQuote]a\[CloseCurlyQuote]) return VAL_A;
    if (c == \[OpenCurlyQuote]b\[CloseCurlyQuote]) return VAL_B;
    if (c == \[OpenCurlyQuote]c\[CloseCurlyQuote]) return VAL_C;
    return VAL_A; // Default
}

int main(int argc, char* argv[]) {
    // --- 1. SETUP DATA ---
    std::vector<std::string> words;
    std::string filename = \[OpenCurlyDoubleQuote]input.txt\
\[CloseCurlyDoubleQuote];
    
    // Config Defaults
    int ext_bound = 6;          
    long long max_steps = 50000; 

    // Parse Command Line Arguments
    // Usage: ./solver [filename] [ext_bound] [max_steps]
    if (argc > 1) { filename = argv[1]; }
    if (argc > 2) { ext_bound = std::atoi(argv[2]); }
    if (argc > 3) { max_steps = std::atoll(argv[3]); }

    std::cout << \[OpenCurlyDoubleQuote]Reading from file: \
\[OpenCurlyDoubleQuote] << filename << std::endl;
    std::ifstream infile(filename);

    if (!infile.is_open()) {
        std::cerr << \[OpenCurlyDoubleQuote]Error: Could not open file \
\[OpenCurlyDoubleQuote] << filename << std::endl;
        std::cout << \[OpenCurlyDoubleQuote]Usage: ./solver [filename] \
[ext_bound] [max_steps]\[CloseCurlyDoubleQuote] << std::endl;
        // Fallback test
        words.push_back(\[OpenCurlyDoubleQuote]aaabaaacccbccaabbbaccbcc\
\[CloseCurlyDoubleQuote]);
    } else {
        std::string line;
        while (std::getline(infile, line)) {
            if (!line.empty() && line.back() == \[OpenCurlyQuote]\\r\
\[CloseCurlyQuote]) {
                line.pop_back();
            }
            if (!line.empty()) {
                words.push_back(line);
            }
        }
        infile.close();
    }

    if (words.empty()) {
        std::cerr << \[OpenCurlyDoubleQuote]Error: No words found to process.\
\[CloseCurlyDoubleQuote] << std::endl;
        return 1;
    }

    // --- AUTOMATIC ROTATIONAL ATTACK ---
    std::vector<std::string> perms = {\[OpenCurlyDoubleQuote]abc\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]cba\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]bac\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]bca\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]cab\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]acb\[CloseCurlyDoubleQuote]};
    std::vector<std::string> current_batch = words;
    
    std::cout << \[OpenCurlyDoubleQuote]Starting Rotational Attack with \
\[OpenCurlyDoubleQuote] << current_batch.size() << \[OpenCurlyDoubleQuote] \
initial words.\[CloseCurlyDoubleQuote] << std::endl;
    std::cout << \[OpenCurlyDoubleQuote]Extension: \[OpenCurlyDoubleQuote] << \
ext_bound << \[OpenCurlyDoubleQuote] (Total added: \[OpenCurlyDoubleQuote] << \
ext_bound*2 << \[OpenCurlyDoubleQuote])\[CloseCurlyDoubleQuote] << std::endl;
    std::cout << \[OpenCurlyDoubleQuote]Max Steps per Phase: \
\[OpenCurlyDoubleQuote] << max_steps << std::endl;

    for (const std::string& orderStr : perms) {
        int num_words = current_batch.size();
        if (num_words == 0) {
            std::cout << \[OpenCurlyDoubleQuote]\\nNo more undecided words. \
Stopping early.\[CloseCurlyDoubleQuote] << std::endl;
            break;
        }

        std::cout << \[OpenCurlyDoubleQuote]\\n--- Phase Order: \
\[OpenCurlyDoubleQuote] << orderStr << \[OpenCurlyDoubleQuote] ---\
\[OpenCurlyDoubleQuote] << std::endl;
        std::cout << \[OpenCurlyDoubleQuote]Processing \
\[OpenCurlyDoubleQuote] << num_words << \[OpenCurlyDoubleQuote] words...\
\[CloseCurlyDoubleQuote] << std::endl;

        // Prepare Search Order
        long long p0 = charToVal(orderStr[0]);
        long long p1 = charToVal(orderStr[1]);
        long long p2 = charToVal(orderStr[2]);

        // --- 2. PREPARE BUFFERS ---
        int max_len = 0;
        for(const auto& w : current_batch) if(w.length() > max_len) max_len = \
w.length();
        int stride = max_len;

        std::vector<long long> h_input_flat(num_words * stride, 0);
        std::vector<long long> h_lengths(num_words);
        std::vector<long long> h_results(num_words, -1);

        for(int i=0; i<num_words; i++) {
            std::vector<long long> w_ints = stringToInts(current_batch[i]);
            h_lengths[i] = w_ints.size();
            for(int j=0; j<w_ints.size(); j++) {
                h_input_flat[i * stride + j] = w_ints[j];
            }
        }

        // --- 3. GPU ALLOCATION & EXECUTION ---
        long long *d_input, *d_results, *d_lengths;
        size_t size_input = h_input_flat.size() * sizeof(long long);
        size_t size_results = num_words * sizeof(long long);
        size_t size_lengths = num_words * sizeof(long long);

        gpuErrchk( cudaMalloc(&d_input, size_input) );
        gpuErrchk( cudaMalloc(&d_results, size_results) );
        gpuErrchk( cudaMalloc(&d_lengths, size_lengths) );

        gpuErrchk( cudaMemcpy(d_input, h_input_flat.data(), size_input, \
cudaMemcpyHostToDevice) );
        gpuErrchk( cudaMemcpy(d_lengths, h_lengths.data(), size_lengths, \
cudaMemcpyHostToDevice) );

        int blockSize = 128;
        int gridSize = (num_words + blockSize - 1) / blockSize;

        backtrackKernel<<<gridSize, blockSize>>>(
            d_input, d_results, d_lengths, 
            num_words, stride, ext_bound, max_steps,
            p0, p1, p2
        );
        gpuErrchk( cudaPeekAtLastError() );
        gpuErrchk( cudaDeviceSynchronize() );

        gpuErrchk( cudaMemcpy(h_results.data(), d_results, size_results, \
cudaMemcpyDeviceToHost) );

        // --- 4. PROCESS RESULTS & FILES ---
        std::vector<std::string> next_undecided;
        
        std::string fname_ext = \[OpenCurlyDoubleQuote]Extendable_\
\[CloseCurlyDoubleQuote] + orderStr + \[OpenCurlyDoubleQuote].txt\
\[CloseCurlyDoubleQuote];
        std::string fname_non = \[OpenCurlyDoubleQuote]Non_Extendable_\
\[CloseCurlyDoubleQuote] + orderStr + \[OpenCurlyDoubleQuote].txt\
\[CloseCurlyDoubleQuote];
        std::string fname_und = \[OpenCurlyDoubleQuote]Undecided_\
\[CloseCurlyDoubleQuote] + orderStr + \[OpenCurlyDoubleQuote].txt\
\[CloseCurlyDoubleQuote];

        std::ofstream out_ext(fname_ext);
        std::ofstream out_non(fname_non);
        std::ofstream out_und(fname_und);

        int count_ext = 0, count_non = 0, count_und = 0;

        for(int i=0; i<num_words; i++) {
            int res = (int)h_results[i];
            if(res == 0) {
                count_ext++;
                out_ext << current_batch[i] << \[OpenCurlyDoubleQuote]\\n\
\[CloseCurlyDoubleQuote];
            }
            else if(res == 1) {
                count_non++;
                out_non << current_batch[i] << \[OpenCurlyDoubleQuote]\\n\
\[CloseCurlyDoubleQuote];
            }
            else { // Timeout/Undecided
                count_und++;
                out_und << current_batch[i] << \[OpenCurlyDoubleQuote]\\n\
\[CloseCurlyDoubleQuote];
                next_undecided.push_back(current_batch[i]);
            }
        }

        out_ext.close();
        out_non.close();
        out_und.close();

        std::cout << \[OpenCurlyDoubleQuote]Extendable_\
\[CloseCurlyDoubleQuote] << orderStr << \[OpenCurlyDoubleQuote] (Good): \
\[OpenCurlyDoubleQuote] << count_ext << std::endl;
        std::cout << \[OpenCurlyDoubleQuote]NonExtendable_\
\[CloseCurlyDoubleQuote] << orderStr << \[OpenCurlyDoubleQuote] (Bad): \
\[OpenCurlyDoubleQuote] << count_non << std::endl;
        std::cout << \
\[OpenCurlyDoubleQuote]Undecided_\[CloseCurlyDoubleQuote] << orderStr << \
\[OpenCurlyDoubleQuote] (Timeout): \[OpenCurlyDoubleQuote] << count_und << \
std::endl;

        // Cleanup GPU memory for this pass
        cudaFree(d_input);
        cudaFree(d_results);
        cudaFree(d_lengths);

        // Prepare for next pass
        current_batch = next_undecided;
    }

    std::cout << \[OpenCurlyDoubleQuote]\\n=== FINAL SUMMARY ===\
\[CloseCurlyDoubleQuote] << std::endl;
    std::cout << \[OpenCurlyDoubleQuote]Remaining Undecided: \
\[OpenCurlyDoubleQuote] << current_batch.size() << std::endl;

    return 0;
}\
