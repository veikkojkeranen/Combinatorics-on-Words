Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "STEP"}]}], " ", "5"}], ":", 
    RowBox[{
     RowBox[{"TEST", "--"}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Example", ":", 
    RowBox[{
    "You", " ", "can", " ", "replace", " ", "this", " ", "with", " ", "your", 
     " ", "actual", " ", "data"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"testWords", "=", "testList24RED100001to150000"}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "testWords", "=", "testList24RED100001to150000takenAway153extendable"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nTesting on \>\"", ",", 
      RowBox[{"Length", "[", "testWords", "]"}], ",", "\"\< words.\>\"", 
      ",", "\"\<\\nmaxSteps = 1000000\>\""}], " ", "]"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Safe", " ", "printing", " ", "for", " ", "large", " ", "lists"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "testWords", "]"}], "<", "20"}], ",", 
      RowBox[{"Print", "[", "testWords", "]"}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"Short", "[", 
        RowBox[{"testWords", ",", "2"}], "]"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Try", " ", "to", " ", "extend", " ", "20", " ", "steps", " ", "Left", " ",
      "AND", " ", "20", " ", "steps", " ", "Right"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"result", "=", 
      RowBox[{"aa2fCheckExtendability", "[", 
       RowBox[{"testWords", ",", "80", ",", "1000000"}], "]"}]}], ")"}], "//",
     "AbsoluteTiming"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n--- RESULTS ---\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Extendable (Good): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<Extendable\>\"", "]"}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<NonExtendable (Bad): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<NonExtendable\>\"", "]"}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Undecided (Timeout): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<Undecided\>\"", "]"}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Errors (Exec Failed): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<Error_ExecutionFailed\>\"", "]"}], "]"}]}],
      "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"result", "[", "\"\<Extendable\>\"", "]"}], "]"}], ">", "0"}],
       ",", 
      RowBox[{
      "Print", "[", "\"\<SUCCESS: Some words could be extended.\>\"", "]"}]}],
      "]"}], ";"}]}]}]], "Input",
