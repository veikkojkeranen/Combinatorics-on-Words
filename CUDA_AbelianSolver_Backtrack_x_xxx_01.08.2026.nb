Cell[BoxData[{
 RowBox[{"#include", "<", "iostream", ">", "#include", "<", "fstream", ">", 
  "#include", "<", "vector", ">", "#include", "<", "string", ">", "#include", 
  "<", "algorithm", ">", "#include", "<", 
  RowBox[{"cuda_runtime", ".", "h"}], ">"}], "\[IndentingNewLine]", 
 RowBox[{"//", 
  RowBox[{
   RowBox[{"--", 
    RowBox[{"-", 
     RowBox[{"CONFIGURATION", "--"}]}]}], "-"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"//", 
    RowBox[{"Value", " ", 
     RowBox[{"mapping", ":", "A"}]}]}], "=", "0"}], ",", 
  RowBox[{"B", "=", "1"}], ",", 
  RowBox[{"C", "=", "65536"}]}], "\n", 
 RowBox[{"#define", " ", "VAL_A", " ", "0"}], "\n", 
 RowBox[{"#define", " ", "VAL_B", " ", "1"}], "\n", 
 RowBox[{
  RowBox[{"#define", " ", "VAL_C", " ", "65536"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"#define", " ", "MAX_TOTAL", "_LEN", " ", "512"}], "\n", 
 RowBox[{
  RowBox[{"#define", " ", "MAX_DEPTH", " ", "256"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"//", 
  RowBox[{"Error", " ", "Check", " ", "Macro"}]}], "\n", 
 RowBox[{"#define", " ", "gpuErrchk", 
  RowBox[{"(", "ans", ")"}], " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"gpuAssert", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", "ans", ")"}], ",", 
       RowBox[{"__FILE", "__"}], ",", 
       RowBox[{"__LINE", "__"}]}], ")"}]}], ";"}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{"inline", " ", "void", " ", "gpuAssert", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"cudaError_t", " ", "code"}], ",", 
     RowBox[{"const", " ", "char", "*", "file"}], ",", 
     RowBox[{"int", " ", "line"}], ",", 
     RowBox[{
      RowBox[{"bool", " ", "abort"}], "=", "true"}]}], ")"}], " ", 
   RowBox[{"{", 
    RowBox[{"if", " ", 
     RowBox[{"(", 
      RowBox[{"code", "!=", "cudaSuccess"}], ")"}], " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fprintf", 
        RowBox[{"(", 
         RowBox[{"stderr", ",", "\"\<GPUassert: %s %s %d\\n\>\"", ",", 
          RowBox[{"cudaGetErrorString", 
           RowBox[{"(", "code", ")"}]}], ",", "file", ",", "line"}], ")"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"if", " ", 
        RowBox[{"(", "abort", ")"}], " ", "exit", 
        RowBox[{"(", "code", ")"}]}], ";"}], "}"}]}], "}"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"//", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "DEVICE"}]}], " ", 
     RowBox[{"KERNELS", "--"}]}], "-", 
    RowBox[{"__device", "__", " ", "bool", " ", "check_left", "_edge", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"long", " ", "long", "*", "buf"}], ",", 
       RowBox[{"int", " ", "start"}], ",", 
       RowBox[{"int", " ", "end"}]}], ")"}], " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"int", " ", "len"}], "=", 
        RowBox[{"end", "-", "start", "+", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"int", " ", "max_k"}], "=", 
        RowBox[{"len", "/", "2"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"for", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"int", " ", "k"}], "=", "2"}], ";", 
          RowBox[{"k", "<=", "max_k"}], ";", 
          RowBox[{"k", "++"}]}], ")"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"long", " ", "long", " ", "sum_u"}], "=", "0"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"long", " ", "long", " ", "sum_v"}], "=", "0"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"for", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"int", " ", "i"}], "=", "0"}], ";", 
              RowBox[{"i", "<", "k"}], ";", 
              RowBox[{"i", "++"}]}], ")"}], " ", "sum_u"}], "+=", 
           RowBox[{"buf", "[", 
            RowBox[{"start", "+", "i"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"for", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"int", " ", "i"}], "=", "0"}], ";", 
              RowBox[{"i", "<", "k"}], ";", 
              RowBox[{"i", "++"}]}], ")"}], " ", "sum_v"}], "+=", 
           RowBox[{"buf", "[", 
            RowBox[{"start", "+", "k", "+", "i"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"if", " ", 
           RowBox[{"(", 
            RowBox[{"sum_u", "==", "sum_v"}], ")"}], " ", "return", " ", 
           "false"}], ";"}], "}"}], " ", "return", " ", "true"}], ";"}], 
      "}"}]}]}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"__device", "__", " ", "bool", " ", "check_right", "_edge", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"long", " ", "long", "*", "buf"}], ",", 
     RowBox[{"int", " ", "start"}], ",", 
     RowBox[{"int", " ", "end"}]}], ")"}], " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"int", " ", "len"}], "=", 
