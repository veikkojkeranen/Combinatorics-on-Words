Cell["\<\
This computation took about 50 seconds. Maybe some 6 seconds less than just \
above (because of testList24RED1to10000MINUSp6s6 instead of \
testList24RED1to10000).\
\>", "Text",
 CellChangeTimes->{{3.975930121827759*^9, 3.975930146344988*^9}, {
  3.9759310364453926`*^9, 
  3.975931113391613*^9}},ExpressionUUID->"3725672f-409e-fd45-955a-\
54adaf1733ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "STEP"}]}], " ", "8"}], ":", 
    RowBox[{
     RowBox[{"TEST", " ", 
      RowBox[{"EXTENSION", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Test", " ", "with", " ", "the", " ", 
    RowBox[{"user", "'"}], "s", " ", "known", " ", "case"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"testWord", "=", "\"\<aaabaaacccbccaabbbaccbcc\>\""}], ";"}], 
   "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nTesting Extension Logic on word list ...\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"failedWords88", "=", 
     RowBox[{"aa2fFindNonExtendableWords", "[", 
      RowBox[{"testList24RED1to10000MINUSp7s7", ",", "8", ",", "8"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"FIX", ":", 
     RowBox[{"Correctly", " ", "interpret", " ", "return", " ", "values"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"failedWords88", "===", "$Failed"}], ",", 
      RowBox[{
      "Print", "[", "\"\<Extension Test FAILED (CUDA Error).\>\"", "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "failedWords88", "]"}], "==", "0"}], ",", 
        RowBox[{
        "Print", 
         "[", "\"\<Result: All the words WERE successfully extended (Solver \
found solutions to all).\>\"", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
        "Print", 
         "[", "\"\<Result: The words in failedWords88 could NOT be extended \
(Solver returned $FAILED for all of them).\>\"", "]"}]}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9759215320485115`*^9, 3.9759215489556255`*^9}, {
