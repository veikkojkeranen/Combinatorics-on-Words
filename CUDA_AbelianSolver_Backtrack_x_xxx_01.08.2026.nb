    "stubborn", " ", "words", " ", "from", " ", "the", " ", "production", " ",
      "run"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"bossLevelWords", "=", 
     RowBox[{"productionReport", "[", "\"\<GlobalUndecided\>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Set", " ", "up", " ", "the", " ", "directory", " ", "for", " ",
      "this", " ", "final", " ", "heavy", " ", "computation"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "bossOutputDir", 
     "=", "\"\<D:\\\\ExtremeMathMmaComputations\\\\aa2fr_3let_len40_ex60ms10M_\
Extendable_Nex_Und\\\\aa2fr_3let_len40_ex60_FINAL_BOSS\>\""}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<  LAUNCHING FINAL BOSS LEVEL TEST\>\"", "]"}], 
    ";"}], "\n", 
