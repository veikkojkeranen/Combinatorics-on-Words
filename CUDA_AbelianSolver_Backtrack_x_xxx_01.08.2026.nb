Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "1.", " ", "Define", " ", "a", " ", "small", " ", "batch", " ", "of", " ",
      "your", " ", "actual", " ", "length"}], "-", 
    RowBox[{"40", " ", "words"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"testWords", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<aaabaaacaaabbbaaacccaaabacbcccaaacbbbaaa\>\"", 
        ",", "\"\<aaabaaacaaabbbaaacccaaabacbcccaaacbbbabb\>\""}], "}"}]}], 
     ";"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
