Notebook[{
Cell["\<\
(*(*1. Define the CUDA Kernel C++ Code*)cudaCode=\"
#include <cuda_runtime.h>

#define VAL_A 0
#define VAL_B 1
#define VAL_C 65536

// Adjust these limits based on your expected word size
#define MAX_WORD_LEN 128
#define MAX_VARS 10

// Helper to check validity (Abelian square free check)
// Returns 1 if valid, 0 if invalid (contains abelian square)
__device__ int is_valid_word(int* word, int len, int startOfInfix) {
    // startOfInfix in Mathematica is 1-based. In C (0-based), we start at \
startOfInfix - 1.
    int start_idx = startOfInfix - 1;

    // Loop 'e' from start index to end of string
    for (int e = start_idx; e < len; e++) {
        int m = e - 1;
        int b = m - 2;
        
        // Check all pattern lengths ending at e
        while (b >= 0) {
            // Calculate Parikh vector sums
            // v is substring {m, e} (indices m to e inclusive)
            // u is substring {b, m-1} (indices b to m-1 inclusive)
            
            int sum_v = 0;
            // Unrolling or optimization possible here, but simple loop is \
robust
            for(int k=m; k<=e; k++) sum_v += word[k];
            
            int sum_u = 0;
            for(int k=b; k<=m-1; k++) sum_u += word[k];
            
            // The constraint: pv - pu == 0 means we found an Abelian Square.
            if ((sum_v - sum_u) == 0) {
                return 0; // Invalid
            }
            
            m = m - 1;
            b = b - 2;
        }
    }
    return 1; // Valid
}

extern \\\"C\\\" __global__ void solveWordsKernel(
    int* input_flat,      // Flattened input array of words
    int* output_flat,     // Flattened output array (to write solutions)
    int* word_lengths,    // Array containing length of each word
    int num_words,        // Total number of words
    int stride,           // Max length allocation per word in flat array
    int startOfInfix      // Default 4
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (idx >= num_words) return;

    // Calculate position in flat arrays
    int offset = idx * stride;
    int len = word_lengths[idx];
    
    // Local buffers
    int local_word[MAX_WORD_LEN];
    
    // Track variables. 
    // unique_vars stores the negative IDs found (e.g. -1, -2)
    // var_map stores which variable index (0..MAX_VARS) corresponds to word[i]
    int unique_vars[MAX_VARS]; 
    int var_map[MAX_WORD_LEN]; 
    int var_count = 0;
    
    // Initialize var_map
    for(int i=0; i<MAX_WORD_LEN; i++) var_map[i] = -1;

    // 1. Load word and identify variables
    for (int i = 0; i < len; i++) {
        int val = input_flat[offset + i];
        local_word[i] = val;
        
        if (val < 0) {
            // Check if we've seen this variable ID before
            int found_idx = -1;
            for(int v=0; v<var_count; v++) {
                if(unique_vars[v] == val) {
                    found_idx = v;
                    break;
                }
            }
            
            // If new variable, register it
            if(found_idx == -1) {
                if(var_count < MAX_VARS) {
                    unique_vars[var_count] = val;
                    found_idx = var_count;
                    var_count++;
                }
            }
            
            // Map this position to the variable index
            if(found_idx != -1) {
                var_map[i] = found_idx;
            }
        }
    }

    // 2. Brute force solver (Base-3 counter)
    // We try all combinations of a,b,c for the unique variables found.
    int total_combinations = 1;
    for(int i=0; i<var_count; i++) total_combinations *= 3;
    
    int solved = 0;
    
    for (int comb = 0; comb < total_combinations; comb++) {
        int temp_comb = comb;
        
        // Reconstruct word for this combination
        for (int i = 0; i < len; i++) {
            if (var_map[i] != -1) {
                // This is a variable position
                int var_idx = var_map[i];
                
                // Extract base-3 digit for this specific variable
                // We must extract the digit corresponding to var_idx
                // Math: digit = (comb / 3^var_idx) % 3
                
                int divisor = 1;
                for(int p=0; p<var_idx; p++) divisor *= 3;
                int digit = (comb / divisor) % 3;
                
                int assigned_val = VAL_A;
                if (digit == 1) assigned_val = VAL_B;
                if (digit == 2) assigned_val = VAL_C;
                
                local_word[i] = assigned_val;
            }
        }
        
        // Check validity
        if (is_valid_word(local_word, len, startOfInfix)) {
            solved = 1;
            break; // Found a solution!
        }
    }

    // 3. Write result back to global memory
    for (int i = 0; i < len; i++) {
        if (solved) {
            output_flat[offset + i] = local_word[i];
        } else {
            // If unsolved, leave the variables (negative numbers) in the \
output
            // so Mathematica knows it failed.
            output_flat[offset + i] = input_flat[offset + i];
        }
    }
}
\";
*)\
\>", "Text",
