Cell["\<\
A CUDA Error Code: 209 was generated by the last version.

STEPs 2 - 7 generate the following comments: 

--- Generatiing and Compiling CUDA DLL (Bypassing CUDALink) ---
Targeting NVCC: C:\\Program Files\\NVIDIA GPU Computing \
Toolkit\\CUDA\\v13.1\\bin\\nvcc.exe
Mathematica Includes: C:\\Program Files\\Wolfram \
Research\\Wolfram\\14.3\\SystemFiles\\IncludeFiles\\C
Found 64-bit cl.exe at: C:\\Program Files\\Microsoft Visual \
Studio\\2022\\Community\\VC\\Tools\\MSVC\\14.41.34120\\bin\\Hostx64\\x64\\
Running NVCC...
COMPILATION SUCCESSFUL! DLL created at: \
C:\\Users\\Veikko\\AppData\\Local\\Temp\\m-0317ae4e-bb2b-4c25-99f0-\
48d5812139a2\\solveAbelian.dll

However, the final (*---STEP 8:TEST EXTENSION---*) part shows a \
\[OpenCurlyDoubleQuote]CUDA Error Code: 209\[CloseCurlyDoubleQuote] as shown \
below.
 
Testing Extension Logic on single word...
Processing 1 words. Extensions: Left=6, Right=6
Solver Error: CUDA Error Code: 209
Result: The word WAS successfully extended (Solver found a solution).\
\>", "Text",
 CellChangeTimes->{{3.975913083347534*^9, 3.975913122154375*^9}, 
   3.975913332315918*^9},ExpressionUUID->"f1956ff4-2d39-c247-9835-\
163e3ad6e840"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["(*---STEP 2:COMPILE (MANUAL DLL \
GENERATION)---*)Print[\[OpenCurlyDoubleQuote]\\n--- Generatiing and Compiling \
CUDA DLL (Bypassing CUDALink) ---\[OpenCurlyDoubleQuote]]; and the rest of \
the code ... ",
 FontWeight->"Bold"]], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.9777483593086586`*^9, 3.9777483876599655`*^9}},
 Background->RGBColor[
  1, 0.75, 0, 0.33],ExpressionUUID->"9d0e6560-9187-3a42-bcf2-87d375da7b92"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "STEP"}]}], " ", "2"}], ":", 
    RowBox[{
     RowBox[{"COMPILE", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"MANUAL", " ", "DLL", " ", "GENERATION"}], ")"}], "--"}]}], 
     "-"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- Generatiing and Compiling CUDA DLL (Bypassing \
CUDALink) ---\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"0.", " ", "FIX", " ", "NVCC", " ", "PATH", " ", 
     RowBox[{"(", 
      RowBox[{"CRITICAL", " ", "STEP"}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "cudaBinPath", 
     "=", "\"\<C:\\\\Program Files\\\\NVIDIA GPU Computing \
Toolkit\\\\CUDA\\\\v13.1\\\\bin\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nvccExe", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"cudaBinPath", ",", "\"\<nvcc.exe\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"mathIncPath", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "$InstallationDirectory", ",", "\"\<SystemFiles\>\"", 
        ",", "\"\<IncludeFiles\>\"", ",", "\"\<C\>\""}], "}"}], "]"}]}], 
    ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Need", " ", "this", " ", "for", " ", 
     RowBox[{"WolframLibrary", ".", "h"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "nvccExe", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<CRITICAL ERROR: nvcc.exe not found at: \>\"", ",", 
         "nvccExe"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Targeting NVCC: \>\"", ",", "nvccExe"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Mathematica Includes: \>\"", ",", "mathIncPath"}], "]"}],
        ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "UPDATED", " ", "CUDA", " ", "SOURCE", " ", 
     RowBox[{"(", 
      RowBox[{"KERNEL", "+", 
       RowBox[{"LIBRARY", " ", "LINK", " ", "WRAPPER"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Now", " ", "includes", " ", "comprehensive", " ", "Error", " ", 
     "Checking"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "cudaSource", 
     "=", "\"\<\n#include <cuda_runtime.h>\n#include <stdio.h>\n#include \
\\\"WolframLibrary.h\\\" \n\n// Use long long to match Mathematica 64-bit \
Integers (mint)\n#define VAL_A 0\n#define VAL_B 1\n#define VAL_C 65536\n\n\
#define MAX_WORD_LEN 128\n#define MAX_VARS 24\n\n__device__ int \
is_valid_word(long long* word, long long len, long long startOfInfix) {\n    \
long long start_idx = startOfInfix - 1;\n    // Optimization: If startOfInfix \
is < 1, sanitize it\n    if (start_idx < 0) start_idx = 0;\n\n    for (long \
long e = start_idx; e < len; e++) {\n        long long m = e - 1;\n        \
long long b = m - 2;\n        while (b >= 0) {\n            long long sum_v = \
0;\n            for(long long k=m; k<=e; k++) sum_v += word[k];\n            \
long long sum_u = 0;\n            for(long long k=b; k<=m-1; k++) sum_u += \
word[k];\n            \n            if ((sum_v - sum_u) == 0) return 0;\n     \
       m = m - 1;\n            b = b - 2;\n        }\n    }\n    return 1;\n}\
\n\n__global__ void solveWordsKernel(\n    long long* input_flat, long long* \
output_flat, long long* word_lengths, \n    long long num_words, long long \
stride, long long startOfInfix\n) {\n    long long idx = blockIdx.x * \
blockDim.x + threadIdx.x;\n    if (idx >= num_words) return;\n\n    long long \
offset = idx * stride;\n    long long len = word_lengths[idx];\n    \n    // \
Local buffers\n    long long local_word[MAX_WORD_LEN];\n    long long \
unique_vars[MAX_VARS]; \n    long long var_map[MAX_WORD_LEN]; \n    long long \
var_count = 0;\n    \n    for(int i=0; i<MAX_WORD_LEN; i++) var_map[i] = -1;\n\
\n    // Load and Identify Vars\n    for (int i = 0; i < len; i++) {\n        \
long long val = input_flat[offset + i];\n        local_word[i] = val;\n       \
 if (val < 0) {\n            int found_idx = -1;\n            for(int v=0; \
v<var_count; v++) {\n                if(unique_vars[v] == val) { found_idx = \
v; break; }\n            }\n            if(found_idx == -1 && var_count < \
MAX_VARS) {\n                unique_vars[var_count] = val;\n                \
found_idx = var_count;\n                var_count++;\n            }\n         \
   if(found_idx != -1) var_map[i] = found_idx;\n        }\n    }\n\n    // \
Solve\n    long long total_combinations = 1;\n    for(int i=0; i<var_count; \
i++) total_combinations *= 3;\n    \n    int solved = 0;\n    for (long long \
comb = 0; comb < total_combinations; comb++) {\n        long long temp_comb = \
comb;\n        for (int i = 0; i < len; i++) {\n            if (var_map[i] != \
-1) {\n                int var_idx = var_map[i];\n                // Extract \
digit: (comb / 3^var_idx) % 3\n                long long divisor = 1;\n       \
         for(int p=0; p<var_idx; p++) divisor *= 3;\n                int \
digit = (temp_comb / divisor) % 3;\n                \n                long \
long assigned_val = VAL_A;\n                if (digit == 1) assigned_val = \
VAL_B;\n                if (digit == 2) assigned_val = VAL_C;\n               \
 local_word[i] = assigned_val;\n            }\n        }\n        if \
(is_valid_word(local_word, len, startOfInfix)) {\n            solved = 1;\n   \
         break; // Found FIRST valid extension\n        }\n    }\n\n    // \
Write Output\n    for (int i = 0; i < len; i++) {\n        if (solved) \
output_flat[offset + i] = local_word[i];\n        else output_flat[offset + \
i] = input_flat[offset + i]; // Return input (with vars) if failed\n    }\n}\n\
\n// WRAPPER FUNCTION with Error Codes\nextern \\\"C\\\" DLLEXPORT int \
solve_entrypoint(WolframLibraryData libData, mint Argc, MArgument *Args, \
MArgument Res) {\n    MTensor inputT = MArgument_getMTensor(Args[0]);\n    \
MTensor outputT = MArgument_getMTensor(Args[1]);\n    MTensor lengthsT = \
MArgument_getMTensor(Args[2]);\n    mint num_words = \
MArgument_getInteger(Args[3]);\n    mint stride = \
MArgument_getInteger(Args[4]);\n    mint startOfInfix = \
MArgument_getInteger(Args[5]);\n\n    long long *input = (long \
long*)libData->MTensor_getIntegerData(inputT);\n    long long *output = (long \
long*)libData->MTensor_getIntegerData(outputT);\n    long long *lengths = \
(long long*)libData->MTensor_getIntegerData(lengthsT);\n\n    size_t \
total_ints = num_words * stride;\n    \n    long long *d_input, *d_output, \
*d_lengths;\n    cudaError_t err;\n    \n    err = cudaMalloc(&d_input, \
total_ints * sizeof(long long));\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n\n    err = \
cudaMalloc(&d_output, total_ints * sizeof(long long));\n    if(err != \
cudaSuccess) { cudaFree(d_input); MArgument_setInteger(Res, (mint)err); \
return LIBRARY_NO_ERROR; }\n\n    err = cudaMalloc(&d_lengths, num_words * \
sizeof(long long));\n    if(err != cudaSuccess) { cudaFree(d_input); \
cudaFree(d_output); MArgument_setInteger(Res, (mint)err); return \
LIBRARY_NO_ERROR; }\n    \n    err = cudaMemset(d_output, -1, total_ints * \
sizeof(long long));\n    if(err != cudaSuccess) { MArgument_setInteger(Res, \
(mint)err); return LIBRARY_NO_ERROR; }\n\n    err = cudaMemcpy(d_input, \
input, total_ints * sizeof(long long), cudaMemcpyHostToDevice);\n    if(err \
!= cudaSuccess) { MArgument_setInteger(Res, (mint)err); return \
LIBRARY_NO_ERROR; }\n\n    err = cudaMemcpy(d_lengths, lengths, num_words * \
sizeof(long long), cudaMemcpyHostToDevice);\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n    \n    \
// Launch Kernel\n    int blockSize = 256;\n    int gridSize = \
(int)((num_words + blockSize - 1) / blockSize);\n    \
solveWordsKernel<<<gridSize, blockSize>>>(d_input, d_output, d_lengths, \
num_words, stride, startOfInfix);\n    \n    err = cudaGetLastError();\n    \
if(err != cudaSuccess) { MArgument_setInteger(Res, (mint)err); return \
LIBRARY_NO_ERROR; }\n    \n    err = cudaDeviceSynchronize();\n    if(err != \
cudaSuccess) { MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; \
}\n\n    err = cudaMemcpy(output, d_output, total_ints * sizeof(long long), \
cudaMemcpyDeviceToHost);\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n    \n    \
cudaFree(d_input);\n    cudaFree(d_output);\n    cudaFree(d_lengths);\n    \n \
   MArgument_setInteger(Res, 0); \n    return LIBRARY_NO_ERROR;\n}\n\>\""}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "PREPARE", " ", "COMPILATION", " ", "ENVIRONMENT"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"clPath", "=", "None"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"compilers", "=", 
     RowBox[{"CCompilers", "[", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "compilers", "]"}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"vsRoot", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"compilers", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<CompilerInstallation\>\"",
           ",", 
          RowBox[{
           RowBox[{"compilers", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           "[", "\"\<CompilerInstallation\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"candidates", "=", 
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<cl.exe\>\"", ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"vsRoot", ",", "\"\<VC\>\""}], "}"}], "]"}], ",", 
          "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"selected", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"candidates", ",", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"#", ",", "\"\<Hostx64\\\\x64\>\""}], "]"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "selected", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"clPath", "=", 
           RowBox[{"DirectoryName", "[", 
            RowBox[{"First", "[", "selected", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Found 64-bit cl.exe at: \>\"", ",", "clPath"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"originalPath", "=", 
           RowBox[{"Environment", "[", "\"\<PATH\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"SetEnvironment", "[", 
           RowBox[{"\"\<PATH\>\"", "->", 
            RowBox[{"clPath", "<>", "\"\<;\>\"", "<>", "originalPath"}]}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<WARNING: Could not automatically find \
Hostx64\\\\x64\\\\cl.exe.\>\"", "]"}], ";"}]}], "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "file", " ", "paths"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"workDir", "=", 
     RowBox[{"CreateDirectory", "[", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cuFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"workDir", ",", "\"\<solveAbelian.cu\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"dllFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"workDir", ",", "\"\<solveAbelian.dll\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"cuFile", ",", "cudaSource", ",", "\"\<String\>\""}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "RUN", " ", "NVCC", " ", "COMPILER", " ", "DIRECTLY"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"UPDATED", ":", 
     RowBox[{"Added", " ", "sm_", "100", " ", "and", " ", "sm_", "120", " ", 
      RowBox[{"(", "Blackwell", ")"}], " ", "targets"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cmd", "=", 
     RowBox[{"{", 
      RowBox[{
      "nvccExe", ",", "\"\<-shared\>\"", ",", "\"\<-O3\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_80,code=sm_80\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_89,code=sm_89\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_90,code=sm_90\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_100,code=sm_100\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_120,code=sm_120\>\"", 
       ",", "\"\<-I\>\"", ",", "mathIncPath", ",", "\"\<-o\>\"", ",", 
       "dllFile", ",", "cuFile"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Running NVCC...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"proc", "=", 
     RowBox[{"RunProcess", "[", "cmd", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"proc", "[", "\"\<ExitCode\>\"", "]"}], "=!=", "0"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<COMPILATION FAILED!\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"proc", "[", "\"\<StandardError\>\"", "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<COMPILATION SUCCESSFUL! DLL created at: \>\"", ",", 
         "dllFile"}], "]"}], ";"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", "STEP"}]}], " ", "4"}], "-", "6"}], ":", "LOAD"}], ",", 
     RowBox[{"DEFINE", " ", "WRAPPERS"}], ",", 
     RowBox[{
      RowBox[{"AND", " ", 
       RowBox[{"TEST", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "LOAD", " ", "LIBRARY"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ValueQ", "[", "dllFile", "]"}]}], "||", 
       RowBox[{"!", 
        RowBox[{"FileExistsQ", "[", "dllFile", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{
       "Print", 
        "[", "\"\<ERROR: 'dllFile' is not defined. Run Step 2 first.\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Quiet", "[", 
     RowBox[{"LibraryFunctionUnload", "[", "cudaLibFun", "]"}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"cudaLibFun", "=", 
     RowBox[{"LibraryFunctionLoad", "[", 
      RowBox[{"dllFile", ",", "\"\<solve_entrypoint\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Shared\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         "Integer", ",", "Integer", ",", "Integer"}], "}"}], ",", "Integer"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "HELPER", " ", "FUNCTIONS"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valMap", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<b\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<c\>\"", "->", "65536"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"reverseValMap", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0", "->", "\"\<a\>\""}], ",", 
       RowBox[{"1", "->", "\"\<b\>\""}], ",", 
       RowBox[{"65536", "->", "\"\<c\>\""}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"stringToCudaInts", "[", "str_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"chars", ",", "vars", ",", "varRules"}], "}"}], ",", 
       RowBox[{
        RowBox[{"chars", "=", 
         RowBox[{"Characters", "[", "str", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vars", "=", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"chars", ",", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], 
                 "}"}], ",", "#"}], "]"}]}], "&"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"varRules", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{"vars", "->", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", 
              RowBox[{"Length", "[", "vars", "]"}]}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Replace", "[", 
         RowBox[{"chars", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{"valMap", ",", "varRules", ",", 
             RowBox[{"_", "->", 
              RowBox[{"-", "99"}]}]}], "}"}], "]"}], ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "MAIN", " ", "EXECUTION", " ", "FUNCTION"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fInt32MakeFreeWordCUDA", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fInt32MakeFreeWordCUDA", "[", 
      RowBox[{"strList_List", ",", 
       RowBox[{"startOfInfix_Integer", ":", "4"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numWords", ",", "stride", ",", "wordLengths", ",", "flatInput", ",", 
         "flatOutput", ",", "processedList", ",", "partitionedRes", ",", 
         "solvedStrings", ",", "wordInts", ",", "errCode"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "cudaLibFun", "]"}], "=!=", 
           "LibraryFunction"}], ",", 
          RowBox[{
          "Return", "[", "\"\<Error: CUDA Library function not loaded.\>\"", 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"numWords", "=", 
         RowBox[{"Length", "[", "strList", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numWords", "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"stride", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"StringLength", "/@", "strList"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"processedList", "=", 
         RowBox[{"stringToCudaInts", "/@", "strList"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wordLengths", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Length", "/@", "processedList"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"flatInput", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"processedList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"stride", "-", 
                  RowBox[{"wordLengths", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "numWords"}], "}"}]}], "]"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"flatOutput", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"Length", "[", "flatInput", "]"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"errCode", "=", 
         RowBox[{"cudaLibFun", "[", 
          RowBox[{
          "flatInput", ",", "flatOutput", ",", "wordLengths", ",", "numWords",
            ",", "stride", ",", "startOfInfix"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"errCode", "=!=", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"StringForm", "[", 
            RowBox[{"\"\<CUDA Error Code: ``\>\"", ",", "errCode"}], "]"}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"partitionedRes", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"flatOutput", ",", "stride"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"solvedStrings", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"wordInts", "=", 
             RowBox[{"partitionedRes", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", 
                RowBox[{"1", ";;", 
                 RowBox[{"wordLengths", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"AnyTrue", "[", 
               RowBox[{"wordInts", ",", "Negative"}], "]"}], 
              ",", "\"\<$FAILED\>\"", ",", 
              RowBox[{"StringJoin", "[", 
               RowBox[{"wordInts", "/.", " ", "reverseValMap"}], "]"}]}], 
             "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "numWords"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "solvedStrings"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "7"}], ":", 
     RowBox[{
      RowBox[{"EXTENSION", " ", "SEARCH", " ", "UTILITIES", " ", 
       RowBox[{
        RowBox[{"(", "NEW", ")"}], "--"}]}], "-"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "aa2fFindNonExtendableWords", " ", "Takes", " ", "a", " ", "list", " ", 
      "of", " ", "base", " ", "words"}], ",", 
     RowBox[{
     "adds", " ", "variables", " ", "to", " ", "left", " ", "and", " ", 
      "right"}], ",", 
     RowBox[{"runs", " ", "the", " ", "solver"}], ",", 
     RowBox[{
     "and", " ", "returns", " ", "ONLY", " ", "the", " ", "original", " ", 
      "words", " ", "that", " ", "FAILED", " ", "to", " ", 
      RowBox[{"extend", "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fFindNonExtendableWords", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fFindNonExtendableWords", "[", 
      RowBox[{"words_List", ",", "leftLen_Integer", ",", "rightLen_Integer"}],
       "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "leftVars", ",", "rightVars", ",", "templateStrings", ",", "results", 
         ",", "nonExtendableIndices", ",", "nonExtendableWords"}], "}"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Processing \>\"", ",", 
          RowBox[{"Length", "[", "words", "]"}], 
          ",", "\"\< words. Extensions: Left=\>\"", ",", "leftLen", 
          ",", "\"\<, Right=\>\"", ",", "rightLen"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"1.", " ", "Generate", " ", "Template", " ", "Strings"}], 
         "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
            "We", " ", "use", " ", "unique", " ", "variables", " ", "chars", " ",
              "D"}], ".."}], "Z", " ", "to", " ", "avoid", " ", "clashing", " ",
            "with", " ", "a"}], ",", "b", ",", "c"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"varChars", "=", 
         RowBox[{"CharacterRange", "[", 
          RowBox[{"\"\<D\>\"", ",", "\"\<Z\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"leftVars", "=", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"Take", "[", 
           RowBox[{"varChars", ",", "leftLen"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rightVars", "=", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"Take", "[", 
           RowBox[{"varChars", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"leftLen", "+", "1"}], ",", 
              RowBox[{"leftLen", "+", "rightLen"}]}], "}"}]}], "]"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"templateStrings", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"leftVars", "<>", "w", "<>", "rightVars"}], ",", 
           RowBox[{"{", 
            RowBox[{"w", ",", "words"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"2.", " ", "Run", " ", "CUDA", " ", "Solver"}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"We", " ", "use", " ", "startOfInfix"}], "=", 
          RowBox[{
          "1", " ", "because", " ", "we", " ", "added", " ", "new", " ", 
           "variables", " ", "at", " ", "the", " ", "start", " ", 
           RowBox[{"(", 
            RowBox[{"Index", " ", "0"}], ")"}]}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"results", "=", 
         RowBox[{"aa2fInt32MakeFreeWordCUDA", "[", 
          RowBox[{"templateStrings", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Check", " ", "for", " ", "Execution", " ", "Errors", " ", 
          RowBox[{"(", 
           RowBox[{
           "Modified", " ", "to", " ", "catch", " ", "Error", " ", "209", " ",
             "etc"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"ListQ", "[", "results", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Solver Error: \>\"", ",", "results"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"3.", " ", "Filter", " ", "Results"}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"If", " ", "result", " ", "is", " ", "\"\<$FAILED\>\""}], ",", 
          RowBox[{
           RowBox[{
           "it", " ", "means", " ", "no", " ", "solution", " ", "was", " ", 
            "found"}], "->", 
           RowBox[{"Non", "-", "Extendable"}]}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
         "We", " ", "return", " ", "the", " ", "ORIGINAL", " ", "base", " ", 
          "words", " ", "corresponding", " ", "to", " ", "these", " ", 
          "failures"}], "*)"}], 
        RowBox[{"nonExtendableIndices", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{"results", ",", "\"\<$FAILED\>\""}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nonExtendableWords", "=", 
         RowBox[{"words", "[", 
          RowBox[{"[", "nonExtendableIndices", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Found \>\"", ",", 
          RowBox[{"Length", "[", "nonExtendableWords", "]"}], 
          ",", "\"\< non-extendable words.\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", "nonExtendableWords"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
