Cell["This works:", "Text",
 CellChangeTimes->{{3.9758449805927715`*^9, 
  3.9758449894134216`*^9}},ExpressionUUID->"938148d9-b045-a140-99df-\
cc50bbd62b70"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["(*---STEP 2:COMPILE (MANUAL DLL \
GENERATION)---*)Print[\[OpenCurlyDoubleQuote]\\n--- Generatiing and Compiling \
CUDA DLL (Bypassing CUDALink) ---\[OpenCurlyDoubleQuote]]; and the rest of \
the code ... ",
 FontWeight->"Bold"]], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.9777482848910103`*^9, 3.977748320913084*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"18c18f8d-922f-8041-954f-ad4916ffa14a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "STEP"}]}], " ", "2"}], ":", 
    RowBox[{
     RowBox[{"COMPILE", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"MANUAL", " ", "DLL", " ", "GENERATION"}], ")"}], "--"}]}], 
     "-"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- Generatiing and Compiling CUDA DLL (Bypassing \
CUDALink) ---\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"0.", " ", "FIX", " ", "NVCC", " ", "PATH", " ", 
     RowBox[{"(", 
      RowBox[{"CRITICAL", " ", "STEP"}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "cudaBinPath", 
     "=", "\"\<C:\\\\Program Files\\\\NVIDIA GPU Computing \
Toolkit\\\\CUDA\\\\v13.1\\\\bin\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nvccExe", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"cudaBinPath", ",", "\"\<nvcc.exe\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"mathIncPath", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "$InstallationDirectory", ",", "\"\<SystemFiles\>\"", 
        ",", "\"\<IncludeFiles\>\"", ",", "\"\<C\>\""}], "}"}], "]"}]}], 
    ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Need", " ", "this", " ", "for", " ", 
     RowBox[{"WolframLibrary", ".", "h"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "nvccExe", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<CRITICAL ERROR: nvcc.exe not found at: \>\"", ",", 
         "nvccExe"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Targeting NVCC: \>\"", ",", "nvccExe"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Mathematica Includes: \>\"", ",", "mathIncPath"}], "]"}],
        ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "UPDATED", " ", "CUDA", " ", "SOURCE", " ", 
     RowBox[{"(", 
      RowBox[{"KERNEL", "+", 
       RowBox[{"LIBRARY", " ", "LINK", " ", "WRAPPER"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Now", " ", "includes", " ", "comprehensive", " ", "Error", " ", 
     "Checking"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "cudaSource", 
     "=", "\"\<\n#include <cuda_runtime.h>\n#include <stdio.h>\n#include \
\\\"WolframLibrary.h\\\" \n\n// Use long long to match Mathematica 64-bit \
Integers (mint)\n#define VAL_A 0\n#define VAL_B 1\n#define VAL_C 65536\n\n\
#define MAX_WORD_LEN 128\n#define MAX_VARS 10\n\n__device__ int \
is_valid_word(long long* word, long long len, long long startOfInfix) {\n    \
long long start_idx = startOfInfix - 1;\n    for (long long e = start_idx; e \
< len; e++) {\n        long long m = e - 1;\n        long long b = m - 2;\n   \
     while (b >= 0) {\n            long long sum_v = 0;\n            for(long \
long k=m; k<=e; k++) sum_v += word[k];\n            long long sum_u = 0;\n    \
        for(long long k=b; k<=m-1; k++) sum_u += word[k];\n            \n     \
       if ((sum_v - sum_u) == 0) return 0;\n            m = m - 1;\n          \
  b = b - 2;\n        }\n    }\n    return 1;\n}\n\n__global__ void \
solveWordsKernel(\n    long long* input_flat, long long* output_flat, long \
long* word_lengths, \n    long long num_words, long long stride, long long \
startOfInfix\n) {\n    long long idx = blockIdx.x * blockDim.x + threadIdx.x;\
\n    if (idx >= num_words) return;\n\n    long long offset = idx * stride;\n \
   long long len = word_lengths[idx];\n    \n    // Local buffers\n    long \
long local_word[MAX_WORD_LEN];\n    long long unique_vars[MAX_VARS]; \n    \
long long var_map[MAX_WORD_LEN]; \n    long long var_count = 0;\n    \n    \
for(int i=0; i<MAX_WORD_LEN; i++) var_map[i] = -1;\n\n    // Load and \
Identify Vars\n    for (int i = 0; i < len; i++) {\n        long long val = \
input_flat[offset + i];\n        local_word[i] = val;\n        if (val < 0) {\
\n            int found_idx = -1;\n            for(int v=0; v<var_count; v++) \
{\n                if(unique_vars[v] == val) { found_idx = v; break; }\n      \
      }\n            if(found_idx == -1 && var_count < MAX_VARS) {\n          \
      unique_vars[var_count] = val;\n                found_idx = var_count;\n \
               var_count++;\n            }\n            if(found_idx != -1) \
var_map[i] = found_idx;\n        }\n    }\n\n    // Solve\n    long long \
total_combinations = 1;\n    for(int i=0; i<var_count; i++) \
total_combinations *= 3;\n    \n    int solved = 0;\n    for (long long comb \
= 0; comb < total_combinations; comb++) {\n        long long temp_comb = \
comb;\n        for (int i = 0; i < len; i++) {\n            if (var_map[i] != \
-1) {\n                int var_idx = var_map[i];\n                long long \
divisor = 1;\n                for(int p=0; p<var_idx; p++) divisor *= 3;\n    \
            int digit = (temp_comb / divisor) % 3;\n                \n        \
        long long assigned_val = VAL_A;\n                if (digit == 1) \
assigned_val = VAL_B;\n                if (digit == 2) assigned_val = VAL_C;\n\
                local_word[i] = assigned_val;\n            }\n        }\n     \
   if (is_valid_word(local_word, len, startOfInfix)) {\n            solved = \
1;\n            break;\n        }\n    }\n\n    // Write Output\n    for (int \
i = 0; i < len; i++) {\n        if (solved) output_flat[offset + i] = \
local_word[i];\n        else output_flat[offset + i] = input_flat[offset + \
i];\n    }\n}\n\n// WRAPPER FUNCTION with Error Codes\n// Returns: 0 \
(Success), >0 (CUDA Error ID)\nextern \\\"C\\\" DLLEXPORT int \
solve_entrypoint(WolframLibraryData libData, mint Argc, MArgument *Args, \
MArgument Res) {\n    MTensor inputT = MArgument_getMTensor(Args[0]);\n    \
MTensor outputT = MArgument_getMTensor(Args[1]);\n    MTensor lengthsT = \
MArgument_getMTensor(Args[2]);\n    mint num_words = \
MArgument_getInteger(Args[3]);\n    mint stride = \
MArgument_getInteger(Args[4]);\n    mint startOfInfix = \
MArgument_getInteger(Args[5]);\n\n    long long *input = (long \
long*)libData->MTensor_getIntegerData(inputT);\n    long long *output = (long \
long*)libData->MTensor_getIntegerData(outputT);\n    long long *lengths = \
(long long*)libData->MTensor_getIntegerData(lengthsT);\n\n    size_t \
total_ints = num_words * stride;\n    \n    long long *d_input, *d_output, \
*d_lengths;\n    cudaError_t err;\n    \n    // 3. Allocate GPU Memory\n    \
err = cudaMalloc(&d_input, total_ints * sizeof(long long));\n    if(err != \
cudaSuccess) { MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; \
}\n\n    err = cudaMalloc(&d_output, total_ints * sizeof(long long));\n    \
if(err != cudaSuccess) { cudaFree(d_input); MArgument_setInteger(Res, \
(mint)err); return LIBRARY_NO_ERROR; }\n\n    err = cudaMalloc(&d_lengths, \
num_words * sizeof(long long));\n    if(err != cudaSuccess) { \
cudaFree(d_input); cudaFree(d_output); MArgument_setInteger(Res, (mint)err); \
return LIBRARY_NO_ERROR; }\n    \n    // 3.5 Initialize Output to -1 (to \
detect if kernel didn't run)\n    err = cudaMemset(d_output, -1, total_ints * \
sizeof(long long));\n    if(err != cudaSuccess) { MArgument_setInteger(Res, \
(mint)err); return LIBRARY_NO_ERROR; }\n\n    // 4. Copy Host -> Device\n    \
err = cudaMemcpy(d_input, input, total_ints * sizeof(long long), \
cudaMemcpyHostToDevice);\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n\n    err = \
cudaMemcpy(d_lengths, lengths, num_words * sizeof(long long), \
cudaMemcpyHostToDevice);\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n    \n    \
// 5. Launch Kernel\n    int blockSize = 256;\n    int gridSize = \
(int)((num_words + blockSize - 1) / blockSize);\n    \
solveWordsKernel<<<gridSize, blockSize>>>(d_input, d_output, d_lengths, \
num_words, stride, startOfInfix);\n    \n    // 5.5 Check Launch Errors \
(CRITICAL)\n    err = cudaGetLastError();\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n    \n    \
err = cudaDeviceSynchronize();\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n\n    // 6. \
Copy Device -> Host\n    err = cudaMemcpy(output, d_output, total_ints * \
sizeof(long long), cudaMemcpyDeviceToHost);\n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, (mint)err); return LIBRARY_NO_ERROR; }\n    \n    \
// 7. Clean up\n    cudaFree(d_input);\n    cudaFree(d_output);\n    \
cudaFree(d_lengths);\n    \n    MArgument_setInteger(Res, 0); // SUCCESS\n    \
return LIBRARY_NO_ERROR;\n}\n\>\""}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "PREPARE", " ", "COMPILATION", " ", "ENVIRONMENT"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"clPath", "=", "None"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"compilers", "=", 
     RowBox[{"CCompilers", "[", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "compilers", "]"}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"vsRoot", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"compilers", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<CompilerInstallation\>\"",
           ",", 
          RowBox[{
           RowBox[{"compilers", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           "[", "\"\<CompilerInstallation\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"candidates", "=", 
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<cl.exe\>\"", ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"vsRoot", ",", "\"\<VC\>\""}], "}"}], "]"}], ",", 
          "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"selected", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"candidates", ",", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"#", ",", "\"\<Hostx64\\\\x64\>\""}], "]"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "selected", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"clPath", "=", 
           RowBox[{"DirectoryName", "[", 
            RowBox[{"First", "[", "selected", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Found 64-bit cl.exe at: \>\"", ",", "clPath"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"originalPath", "=", 
           RowBox[{"Environment", "[", "\"\<PATH\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"SetEnvironment", "[", 
           RowBox[{"\"\<PATH\>\"", "->", 
            RowBox[{"clPath", "<>", "\"\<;\>\"", "<>", "originalPath"}]}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<WARNING: Could not automatically find \
Hostx64\\\\x64\\\\cl.exe.\>\"", "]"}], ";"}]}], "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "file", " ", "paths"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"workDir", "=", 
     RowBox[{"CreateDirectory", "[", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cuFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"workDir", ",", "\"\<solveAbelian.cu\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"dllFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"workDir", ",", "\"\<solveAbelian.dll\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"cuFile", ",", "cudaSource", ",", "\"\<String\>\""}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "RUN", " ", "NVCC", " ", "COMPILER", " ", "DIRECTLY"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"UPDATED", " ", 
      RowBox[{"CMD", ":", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "TARGETING"}], " ", "BLACKWELL", " ", "NATIVE", " ", 
         "BINARY", " ", 
         RowBox[{"(", 
          RowBox[{"sm_", "120"}], ")"}]}], "-", 
        RowBox[{
        "Removed", " ", "PTX", " ", "generation", " ", "to", " ", "prevent", " ",
          "Error", " ", "222", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Driver", "/", "Toolkit"}], " ", "Version", " ", 
            "Mismatch"}], ")"}], ".", 
          RowBox[{"-", "If"}]}], " ", "this", " ", "compiles"}]}]}]}], ",", 
     RowBox[{
     "it", " ", "guarantees", " ", "a", " ", "compatible", " ", "binary", " ",
       "for", " ", "your", " ", 
      RowBox[{"card", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cmd", "=", 
     RowBox[{"{", 
      RowBox[{
      "nvccExe", ",", "\"\<-shared\>\"", ",", "\"\<-O3\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_120,code=sm_120\>\"", ",", 
       RowBox[{"(*", 
        RowBox[{"Native", " ", "Blackwell", " ", "Binary"}], 
        "*)"}], "\"\<-I\>\"", ",", "mathIncPath", ",", "\"\<-o\>\"", ",", 
       "dllFile", ",", "cuFile"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Running NVCC...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"proc", "=", 
     RowBox[{"RunProcess", "[", "cmd", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"proc", "[", "\"\<ExitCode\>\"", "]"}], "=!=", "0"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<COMPILATION FAILED!\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"proc", "[", "\"\<StandardError\>\"", "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<COMPILATION SUCCESSFUL! DLL created at: \>\"", ",", 
         "dllFile"}], "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", "STEP"}]}], " ", "4"}], "-", "6"}], ":", "LOAD"}], ",", 
     RowBox[{"DEFINE", " ", "WRAPPERS"}], ",", 
     RowBox[{
      RowBox[{"AND", " ", "TEST", " ", 
       RowBox[{
        RowBox[{"(", "CONSOLIDATED", ")"}], "--"}]}], "-"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "LOAD", " ", "LIBRARY"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ValueQ", "[", "dllFile", "]"}]}], "||", 
       RowBox[{"!", 
        RowBox[{"FileExistsQ", "[", "dllFile", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{
       "Print", 
        "[", "\"\<ERROR: 'dllFile' is not defined. Run Step 2 first.\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Quiet", "[", 
     RowBox[{"LibraryFunctionUnload", "[", "cudaLibFun", "]"}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"cudaLibFun", "=", 
     RowBox[{"LibraryFunctionLoad", "[", 
      RowBox[{"dllFile", ",", "\"\<solve_entrypoint\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"(*", "input", "*)"}], 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Shared\>\""}], "}"}], ",", 
         RowBox[{"(*", "output", "*)"}], 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"(*", "lengths", "*)"}], "Integer", ",", 
         RowBox[{"(*", "num_words", "*)"}], "Integer", ",", 
         RowBox[{"(*", "stride", "*)"}], "Integer"}], "                   ", 
        RowBox[{"(*", "startOfInfix", "*)"}], "}"}], ",", "Integer"}], " ", 
      RowBox[{"(*", 
       RowBox[{"Returns", " ", "Error", " ", "Code", " ", "now"}], "*)"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "DEFINE", " ", "HELPER", " ", "FUNCTIONS"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valMap", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<b\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<c\>\"", "->", "65536"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"reverseValMap", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0", "->", "\"\<a\>\""}], ",", 
       RowBox[{"1", "->", "\"\<b\>\""}], ",", 
       RowBox[{"65536", "->", "\"\<c\>\""}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"stringToCudaInts", "[", "str_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"chars", ",", "vars", ",", "varRules"}], "}"}], ",", 
       RowBox[{
        RowBox[{"chars", "=", 
         RowBox[{"Characters", "[", "str", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vars", "=", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"chars", ",", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], 
                 "}"}], ",", "#"}], "]"}]}], "&"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"varRules", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{"vars", "->", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", 
              RowBox[{"Length", "[", "vars", "]"}]}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Replace", "[", 
         RowBox[{"chars", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{"valMap", ",", "varRules", ",", 
             RowBox[{"_", "->", 
              RowBox[{"-", "99"}]}]}], "}"}], "]"}], ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "DEFINE", " ", "MAIN", " ", "EXECUTION", " ", "FUNCTION"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fInt32MakeFreeWordCUDA", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fInt32MakeFreeWordCUDA", "[", 
      RowBox[{"strList_List", ",", 
       RowBox[{"startOfInfix_Integer", ":", "4"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numWords", ",", "stride", ",", "wordLengths", ",", "flatInput", ",", 
         "flatOutput", ",", "processedList", ",", "partitionedRes", ",", 
         "solvedStrings", ",", "wordInts", ",", "errCode"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "cudaLibFun", "]"}], "=!=", 
           "LibraryFunction"}], ",", 
          RowBox[{
          "Return", 
           "[", "\"\<Error: CUDA Library function not loaded. Re-run Step \
4.\>\"", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"numWords", "=", 
         RowBox[{"Length", "[", "strList", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numWords", "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"stride", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"StringLength", "/@", "strList"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"processedList", "=", 
         RowBox[{"stringToCudaInts", "/@", "strList"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wordLengths", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Length", "/@", "processedList"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Flatten", " ", "and", " ", "Pad", " ", "inputs"}], "-", 
          RowBox[{"Ensure", " ", "Packed", " ", "Array"}]}], "*)"}], 
        RowBox[{"flatInput", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"processedList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"stride", "-", 
                  RowBox[{"wordLengths", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "numWords"}], "}"}]}], "]"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Initialize", " ", "Output", " ", "Array"}], "*)"}], 
        RowBox[{"flatOutput", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"Length", "[", "flatInput", "]"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"CALL", " ", "GPU", " ", "FUNCTION"}], "*)"}], 
        RowBox[{"errCode", "=", 
         RowBox[{"cudaLibFun", "[", 
          RowBox[{
          "flatInput", ",", "flatOutput", ",", "wordLengths", ",", "numWords",
            ",", "stride", ",", "startOfInfix"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"errCode", "=!=", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"StringForm", "[", 
            
            RowBox[{"\"\<CUDA Error Code: `` (209=NoBinary, 222=BadPTX)\>\"", 
             ",", "errCode"}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Decode", " ", "Results"}], "*)"}], 
        RowBox[{"partitionedRes", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"flatOutput", ",", "stride"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"solvedStrings", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"wordInts", "=", 
             RowBox[{"partitionedRes", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", 
                RowBox[{"1", ";;", 
                 RowBox[{"wordLengths", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"AnyTrue", "[", 
               RowBox[{"wordInts", ",", "Negative"}], "]"}], 
              ",", "\"\<$FAILED\>\"", ",", 
              RowBox[{"StringJoin", "[", 
               RowBox[{"wordInts", "/.", " ", "reverseValMap"}], "]"}]}], 
             "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "numWords"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "solvedStrings"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "TEST", " ", "EXECUTION"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nonCharVars", "=", 
     RowBox[{"{", 
      RowBox[{"X", ",", "Y", ",", "Z", ",", "T"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"charVars", "=", 
     RowBox[{"ToString", "/@", "nonCharVars"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Generate", " ", "20", " ", "random", " ", "test", " ", "cases", "\[IndentingNewLine]",
        "testData"}], "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"StringJoin", "[", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}],
             ",", "5"}], "]"}], ",", "\"\<X\>\"", ",", 
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}],
             ",", "5"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", "20", "}"}]}], "]"}]}], ";"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"testData", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<aaabaaaXYZT\>\"", ",", "\"\<aaabaaacXYZT\>\"", 
       ",", "\"\<aaabaaacaXYZT\>\"", ",", "\"\<aaabaaacaaXYZT\>\"", 
       ",", "\"\<aaabaaacaaaXYZT\>\"", ",", "\"\<aaabaaacaaabXYZT\>\"", 
       ",", "\"\<aaabaaacaaabaXYZT\>\"", ",", "\"\<aaabaaacaaabaaXYZT\>\"", 
       ",", "\"\<aaabaaacaaabaaaXYZT\>\""}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\nRunning on GPU...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"aa2fInt32MakeFreeWordCUDA", "[", "testData", "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\nResults:\>\"", "]"}], ";"}], "\n", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"ListQ", "[", "results", "]"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Semicolon", " ", "removed", " ", "as", " ", "requested", " ", "so", " ",
        "Grid", " ", "displays"}], "*)"}], 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"testData", ",", "results"}], "}"}], "]"}], ",", 
       RowBox[{"Frame", "->", "All"}]}], "]"}], ",", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<FAILED: \>\"", ",", "results"}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
