Cell[TextData[{
 "In the ",
 StyleBox["4th",
  FontWeight->"Bold"],
 " case, we used Complement[...]. Indeed, the 4th case was the first one to \
deal with all the length 40 extension reductions. There it reads as follows :"
}], "Text",
 CellChangeTimes->{{3.9805658099314785`*^9, 3.980565842929302*^9}, {
  3.9805658760878334`*^9, 3.980565956286932*^9}, {3.9805660301576195`*^9, 
  3.980566033667465*^9}, {3.9805660887970295`*^9, 
  3.9805661889773026`*^9}},ExpressionUUID->"da669a0b-0579-2048-ac79-\
ef4230638afe"],

Cell[TextData[{
 "In spite of \[OpenCurlyQuote]Und\[CloseCurlyQuote] in \
\[OpenCurlyQuote]AllxyzUndEX50MS1M\[CloseCurlyQuote] suffix of the variable \
name, the following Complement[...] contains all the possible 3-let SFSG aa2f \
RED words  (in the ",
 StyleBox["4th",
  FontWeight->"Bold"],
 " case) of length ",
 StyleBox["32",
  FontWeight->"Bold"],
 " :\n(Well, the suffix should actually read UndEX50MS1MUndEX50MS100MNonExt.)"
}], "Text",
 CellChangeTimes->{{3.9805644301175156`*^9, 3.980564563400839*^9}, {
  3.9805645979637375`*^9, 3.980564692916197*^9}, {3.9805647378567715`*^9, 
  3.98056476303232*^9}, {3.9805651936033344`*^9, 3.9805652192535686`*^9}, {
  3.9805892677395897`*^9, 3.980589268277527*^9}},
 Background->RGBColor[
  0.98, 0.56, 0.17, 
   0.33],ExpressionUUID->"dd725dae-01bf-0341-b52d-0dbe2e2784b6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "aa2fSFSG3letWL32EXTp4s4wl24RED300001to418464FL5181759cudaEX20MS1MabcSFSGn21\
31342EX80MS50kAllxyzUndEX50MS1M", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{
    "aa2f3letWL32EXTp4s4wl24RED300001to418464FL5181759cudaEX20MS1MabcSFSGn2131\
342", ",", 
     "resultOfEXPORTaa2f3letWL32EXTp4s4wl24RED300001to418464FL5181759cudaEX20M\
S1MabcSFSGn2131342EX80MS50kallxyzNonExt", ",", 
     "resultOFaa2f3letWL32EXTp4s4wl24RED300001to418464FL5181759cudaEX20MS1Mabc\
SFSGn2131342EX80MS50kAllxyzUndEX50MS1MNonExt", ",", 
     "reSaa2f3letWL32EXTp4s4wl24RED200001to418464cudaEX20MS1MabcSfsgEX80MS50kA\
llxyzUndEX50MS1MUndEX50MS100MNonExt"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"aa2fSFSG3letWL32EXTp4s4wl24RED300001to418464FL5181759cudaEX20MS1Mabc\
