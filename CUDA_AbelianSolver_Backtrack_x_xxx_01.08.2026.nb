Cell[TextData[{
 "On M\[ADoubleDot]kel\[ADoubleDot]' s Conjectures : deciding if a morphic \
word avoids long abelian - powers\nM . Rao, M . Rosenfeld, September 15, 2015\
\n\nM\[ADoubleDot]kel\[ADoubleDot]' s Problem 1. g3 : \n",
 StyleBox["a -> bbbaabaaac (5, 4, 1)\nb -> bccacccbcc (1, 2, 7)\nc -> \
ccccbbbcbc (0, 4, 6)\nd -> ccccccccaa (2, 0, 8)\ne -> bbbbbcabaa (3, 6, 1)\nf \
-> aaaaaaabaa (9, 1, 0)",
  FontFamily->"Courier New",
  FontWeight->"Normal"],
 "\n\nTheorem 6. The word obtained by applying g_ 3 to the fixed - point of \
h6, that is g_ 3 ((h_ 6)^inf (a)), does not contain any square of period more \
than 5.\n\nCorollary 4. There is an infinite word over 3 letters avoiding \
abelian - square of period more than 5."
}], "Text",
 CellChangeTimes->{{3.9765318068539658`*^9, 
  3.9765318552483788`*^9}},ExpressionUUID->"ea56a07f-b9ee-bc49-aa33-\
7b72d5dd6685"],

Cell[BoxData[
 RowBox[{
  RowBox[{"alph6", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\"", ",", "\"\<d\>\"",
      ",", "\"\<e\>\"", ",", "\"\<f\>\""}], "}"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[20]:=",ExpressionUUID->"fc5791b9-d9bf-434f-9c76-82398f3d0dcb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"h6", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<a\>\"", "\[Rule]", "\"\<ace\>\""}], ",", 
    RowBox[{"\"\<b\>\"", "\[Rule]", "\"\<adf\>\""}], ",", 
    RowBox[{"\"\<c\>\"", "\[Rule]", "\"\<bdf\>\""}], ",", 
    RowBox[{"\"\<d\>\"", "\[Rule]", "\"\<bdc\>\""}], ",", 
    RowBox[{"\"\<e\>\"", "\[Rule]", "\"\<afe\>\""}], ",", 
    RowBox[{"\"\<f\>\"", "\[Rule]", "\"\<bce\>\""}]}], "}"}]}]], "Input",
 InitializationCell->True,
 CellLabel->"In[21]:=",ExpressionUUID->"33d69342-5aee-7f4d-b907-3cf857a88194"],

