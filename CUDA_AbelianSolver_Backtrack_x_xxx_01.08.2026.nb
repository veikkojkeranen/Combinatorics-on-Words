Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "testSuff", "]"}], ";"}], "  "}], "\n", 
 RowBox[{
  RowBox[{"testSuff", "[", "x_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sl", "=", 
       RowBox[{"StringLength", "[", "x", "]"}]}], ",", 
      RowBox[{"i", "=", "0"}], ",", 
      RowBox[{"res", "=", "True"}]}], "}"}], ",", "\n", "\t\t", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"i", "<", 
         RowBox[{"Floor", "[", 
          RowBox[{"sl", "/", "2"}], "]"}]}], " ", "&&", 
        RowBox[{"(", "\n", "\t\t", 
         RowBox[{"res", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "[", 
             RowBox[{"StringTake", "[", 
              RowBox[{"x", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"sl", "-", "1", "-", 
                  RowBox[{"2", "i"}]}], ",", 
                 RowBox[{"sl", "-", "1", "-", "i"}]}], "}"}]}], "]"}], " ", 
             "]"}], "===", 
            RowBox[{"s", "[", 
             RowBox[{"StringTake", "[", 
              RowBox[{"x", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"sl", "-", "i"}], ",", "sl"}], "}"}]}], "]"}], " ", 
             "]"}]}], "//", "Not"}]}], ")"}]}], ",", 
       RowBox[{"i", "++"}]}], "]"}], ";", "\n", "\t", "res"}]}], 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellLabel->
  "In[102]:=",ExpressionUUID->"faacb790-cf57-dc49-9979-90a30c2c31b5"],

