Cell[" ", "Text",
 CellChangeTimes->{{3.9757664030557384`*^9, 3.975766406458332*^9}},
 Background->RGBColor[
  0.4, 0.6, 1, 0.33],ExpressionUUID->"539cb46d-35ab-1444-82fc-8a99049bd904"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"4.", " ", "LOAD", " ", "THE", " ", "LIBRARY"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Unload", " ", "if", " ", "exists", " ", 
    RowBox[{"(", 
     RowBox[{"recompilation", " ", "support"}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Quiet", "[", 
     RowBox[{"LibraryFunctionUnload", "[", "cudaLibFun", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Load", " ", 
     RowBox[{"the", "'"}], 
     RowBox[{"solve_entrypoint", "'"}], " ", "function", " ", "Arg", " ", 
     RowBox[{"Types", ":", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "InputArray", ",", "OutputArray", ",", "LenArray", ",", "NumWords", ",",
          "Stride", ",", "StartInfix"}], "}"}], " ", "Note"}], ":", 
      RowBox[{
       RowBox[{"'", 
        RowBox[{"OutputArray", "'"}], " ", "is", " ", "passed", " ", "as", " ", 
        RowBox[{"{", 
         RowBox[{"Integer", ",", "1", ",", "\"\<Shared\>\""}], "}"}], " ", 
        "so", " ", "we", " ", "can", " ", "modify", " ", "it", " ", "in"}], "-", 
       RowBox[{"place", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cudaLibFun", "=", 
     RowBox[{"LibraryFunctionLoad", "[", 
      RowBox[{"dllFile", ",", "\"\<solve_entrypoint\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"(*", "input", "*)"}], 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Shared\>\""}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{"output", " ", 
           RowBox[{"(", 
            RowBox[{"Shared", " ", "allows", " ", "writing"}], ")"}]}], 
          "*)"}], 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"(*", "lengths", "*)"}], "Integer", ",", 
         RowBox[{"(*", "num_words", "*)"}], "Integer", ",", 
         RowBox[{"(*", "stride", "*)"}], "Integer"}], "                   ", 
        RowBox[{"(*", "startOfInfix", "*)"}], "}"}], ",", "\"\<Void\>\""}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Library Loaded. Function 'cudaLibFun' is ready.\>\"", 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{3.97575447556056*^9, 3.975755542132372*^9},
 CellLabel->
  "In[101]:=",ExpressionUUID->"f43a1c9a-b768-594d-80b7-4fa84f26a650"],

Cell[BoxData["\<\"Library Loaded. Function 'cudaLibFun' is ready.\"\>"], \
"Print",
