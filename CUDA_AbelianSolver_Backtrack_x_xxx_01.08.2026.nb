Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Load", " ", "the", " ", "CUDALink", " ", "Library", " ", "and",
     " ", "Compile"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Needs", "[", "\"\<CUDALink`\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"We", " ", "skip", " ", "the", " ", 
      RowBox[{"If", "[", 
       RowBox[{"Not", "@", 
        RowBox[{"CUDAQ", "[", "]"}]}], "]"}], " ", "check", " ", "because", " ",
       "it", " ", "gives", " ", "false", " ", "negatives", " ", "on", " ", 
      "bleeding"}], "-", 
     RowBox[{"edge", " ", 
      RowBox[{"hardware", "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Attempting to compile CUDA kernel...\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"NOTE", ":", 
      RowBox[{"If", " ", "this", " ", "fails", " ", 
       RowBox[{"with", "'"}], "nvcc", " ", "fatal"}], ":", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Value", "'"}], "sm_", 
         RowBox[{"120", "'"}], " ", "is", " ", "not", " ", "defined"}], 
        "..."}], "'"}]}], ",", 
     RowBox[{
      RowBox[{"you", " ", "may", " ", "need", " ", "to", " ", 
       RowBox[{"add", ":", "\"\<CompilerOptions\>\""}]}], "->", 
      RowBox[{
       RowBox[{"{", "\"\<-arch=sm_90\>\"", "}"}], " ", "to", " ", "the", " ", 
       "options", " ", "below", " ", "to", " ", "target", " ", "a", " ", 
       "supported", " ", 
       RowBox[{"architecture", "."}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"cudaFun", "=", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"CUDAFunctionLoad", "[", 
        RowBox[{"cudaCode", ",", "\"\<solveWordsKernel\>\"", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"_Integer", ",", "_", ",", "\"\<Input\>\""}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"_Integer", ",", "_", ",", "\"\<Output\>\""}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"_Integer", ",", "_", ",", "\"\<Input\>\""}], "}"}], ",", 
           "_Integer", ",", "_Integer", ",", "_Integer"}], "}"}], ",", 
         RowBox[{"\"\<CompileOptions\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<-arch=sm_80\>\"", ",", "\"\<-m64\>\""}], "}"}]}], ",", 
         RowBox[{"\"\<TargetPrecision\>\"", "->", "\"\<Int32\>\""}], ",", 
         RowBox[{"\"\<ShellOutputFunction\>\"", "->", "Print"}]}], " ", 
        RowBox[{"(*", 
         RowBox[{
         "This", " ", "prints", " ", "the", " ", "actual", " ", "compiler", " ",
           "errors"}], "*)"}], "]"}], ",", "$Failed"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"cudaFun", "===", "$Failed"}], ",", 
      RowBox[{
      "Print", "[", "\"\<\\nCOMPILATION FAILED. See output above.\>\"", "]"}],
       ",", 
      RowBox[{
      "Print", "[", "\"\<\\nCOMPILATION SUCCESSFUL. Kernel loaded.\>\"", 
       "]"}]}], "]"}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.975376647783348*^9, 3.9753766856036835`*^9}, {
