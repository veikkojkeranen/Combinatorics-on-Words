    RowBox[{
    "mainProductionOutputDir", 
     "=", "\"\<D:\\\\ExtremeMathMmaComputations\\\\aa2fr_3let_len40_ex60_\
PRODUCTION_RUN\>\""}], ";"}], "\n", "\[IndentingNewLine]", 
