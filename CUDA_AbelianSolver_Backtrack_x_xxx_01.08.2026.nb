Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "input", " ", "dataset", " ", "and", 
    " ", "output", " ", "directory"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Ensure", " ", "masterListLength60", " ", "contains", " ", "the", " ", 
     "206"}], ",", 
    RowBox[{"974", " ", "verified", " ", "words"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "mainOutputDir80", 
     "=", "\"\<D:\\\\ExtremeMathMmaComputations\\\\aa2fr_3let_len40_ex60ms10M_\
Extendable_Nex_Und\\\\aa2fr_3let_len160_ex80_PRODUCTION\>\""}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  LAUNCHING DEPTH 80 EXPANSION (TOTAL LENGTH 320)\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Total Words: \>\"", ",", 
      RowBox[{"Length", "[", "masterListLength60", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Max Steps: 200,000,000 | Batch Size: 10,000\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Execute", " ", "the", " ", "robust", " ", "batch", " ", 
     "orchestrator"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"time80", ",", "report80"}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"aa2fSolveInBatches", "[", 
       RowBox[{"masterListLength60", ",", "80", ",", 
        RowBox[{"(*", 
         RowBox[{"Target", " ", "Extension", " ", "Bound", " ", 
          RowBox[{"(", 
           RowBox[{"80", " ", "per", " ", "side"}], ")"}]}], "*)"}], 
        "200000000", ",", 
        RowBox[{"(*", 
         RowBox[{"200", "-", 
          RowBox[{"Million", " ", "step", " ", "limit"}]}], "*)"}], "10000", ",", 
        RowBox[{"(*", 
         RowBox[{
         "Hardware", " ", "saturation", " ", "batch", " ", "size", " ", "for",
           " ", "frequent", " ", "saves"}], "*)"}], "mainOutputDir80"}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nDepth 80 Master Run completed in \>\"", ",", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"time80", "/", "3600.0"}], ",", "0.01"}], "]"}], 
      ",", "\"\< hours.\>\""}], "]"}], ";"}]}]}]], "Input",
