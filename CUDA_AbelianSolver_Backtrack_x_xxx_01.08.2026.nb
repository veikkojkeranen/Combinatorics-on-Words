Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"testWords", "=", 
    RowBox[{"result", "[", "\"\<Undecided\>\"", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<\\nTesting on \>\"", ",", 
     RowBox[{"Length", "[", "testWords", "]"}], ",", "\"\< words.\>\"", 
     ",", "\"\<\\nmaxSteps = 8000000\>\""}], " ", "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Safe", " ", "printing", " ", "for", " ", "large", " ", "lists"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "testWords", "]"}], "<", "20"}], ",", 
     RowBox[{"Print", "[", "testWords", "]"}], ",", 
     RowBox[{"Print", "[", 
      RowBox[{"Short", "[", 
       RowBox[{"testWords", ",", "2"}], "]"}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Try", " ", "to", " ", "extend", " ", "20", " ", "steps", " ", "Left", " ",
     "AND", " ", "20", " ", "steps", " ", "Right"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"result", "=", 
     RowBox[{"aa2fCheckExtendability", "[", 
      RowBox[{"testWords", ",", "40", ",", "8000000"}], "]"}]}], ")"}], "//", 
   "AbsoluteTiming"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
