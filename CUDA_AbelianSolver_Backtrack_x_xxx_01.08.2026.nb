Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "STEP"}]}], " ", "8"}], ":", 
    RowBox[{
     RowBox[{"TEST", " ", 
      RowBox[{"EXTENSION", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Test", " ", "with", " ", "the", " ", 
    RowBox[{"user", "'"}], "s", " ", "known", " ", "case"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"testWord", "=", "\"\<aaabaaacccbccaabbbaccbcc\>\""}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nTesting Extension Logic on single word...\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"failedWords", "=", 
     RowBox[{"aa2fFindNonExtendableWords", "[", 
      RowBox[{
       RowBox[{"{", "testWord", "}"}], ",", "6", ",", "6"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"FIX", ":", 
     RowBox[{"Correctly", " ", "interpret", " ", "return", " ", "values"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"failedWords", "===", "$Failed"}], ",", 
      RowBox[{
      "Print", "[", "\"\<Extension Test FAILED (CUDA Error).\>\"", "]"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
