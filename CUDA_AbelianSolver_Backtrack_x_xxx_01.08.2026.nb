Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"CASE", " ", "OF", " ", "VAL_A"}], " ", "<", "--"}], "->", " ", 
    "VAL_C"}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"testWords", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<aabaaacabcbbaaacabacccab\>\"", 
       ",", "\"\<aabaaacabcbbaaacbaacccab\>\""}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nTesting on \>\"", ",", 
      RowBox[{"Length", "[", "testWords", "]"}], ",", "\"\< words.\>\"", ",", 
      " ", "\"\<\\nextBound = 100\>\"", 
      ",", "\"\<\\nmaxSteps = 10000000\>\""}], " ", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Safe", " ", "printing", " ", "for", " ", "large", " ", "lists"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "testWords", "]"}], "<", "20"}], ",", 
      RowBox[{"Print", "[", "testWords", "]"}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"Short", "[", 
        RowBox[{"testWords", ",", "2"}], "]"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Try", " ", "to", " ", "extend", " ", "20", " ", "steps", " ", "Left", " ",
      "AND", " ", "20", " ", "steps", " ", "Right"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"result", "=", 
      RowBox[{"aa2fCheckExtendability", "[", 
       RowBox[{"testWords", ",", "100", ",", "10000000"}], "]"}]}], ")"}], "//",
     "AbsoluteTiming"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n--- RESULTS ---\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Extendable (Good): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<Extendable\>\"", "]"}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<NonExtendable (Bad): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<NonExtendable\>\"", "]"}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Undecided (Timeout): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<Undecided\>\"", "]"}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Errors (Exec Failed): \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"result", "[", "\"\<Error_ExecutionFailed\>\"", "]"}], "]"}]}],
      "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
