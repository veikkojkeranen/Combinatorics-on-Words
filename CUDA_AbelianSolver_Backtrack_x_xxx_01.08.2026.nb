Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "STEP"}]}], " ", "4"}], ":", 
    RowBox[{
     RowBox[{"MATHEMATICA", " ", 
      RowBox[{"WRAPPER", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Unload", " ", "if", " ", "exists"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Quiet", "[", 
     RowBox[{"LibraryFunctionUnload", "[", "aa2fBacktrackLib", "]"}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aa2fBacktrackLib", "=", 
     RowBox[{"LibraryFunctionLoad", "[", 
      RowBox[{"dllFile", ",", "\"\<solve_backtrack_entrypoint\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"(*", "input", "*)"}], 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Shared\>\""}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{"results", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"0", "=", "Good"}], ",", 
             RowBox[{"1", "=", "Bad"}], ",", 
             RowBox[{"2", "=", "Timeout"}]}], ")"}]}], "*)"}], 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"(*", "lengths", "*)"}], "Integer", ",", 
         RowBox[{"(*", "num_words", "*)"}], "Integer", ",", 
         RowBox[{"(*", "stride", "*)"}], "Integer", ",", 
         RowBox[{"(*", "extension_bound", "*)"}], "Integer"}], 
        "                   ", 
        RowBox[{"(*", "max_steps", "*)"}], "}"}], ",", "Integer"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Helper", ":", 
     RowBox[{"String", " ", "to", " ", "Ints"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valMap", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<b\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<c\>\"", "->", "65536"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"stringToCudaInts", "[", "str_String", "]"}], ":=", 
     RowBox[{"Replace", "[", 
      RowBox[{
       RowBox[{"Characters", "[", "str", "]"}], ",", "valMap", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"MAIN", " ", 
      RowBox[{"FUNCTION", ":", 
       RowBox[{"aa2fCheckExtendability", " ", "Input"}], ":", 
       RowBox[{"List", " ", "of", " ", "strings", " ", 
        RowBox[{"Params", ":", "extBound", ":", 
         RowBox[{"How", " ", "many", " ", "pairs", " ", "to", " ", "add", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"e", ".", "g", ".", "50"}], " ", "means", " ", "50", " ",
              "Left"}], "+", 
            RowBox[{"50", " ", "Right"}]}], ")"}], " ", 
          RowBox[{"maxSteps", ":", 
           RowBox[{
           "Calculation", " ", "limit", " ", "per", " ", "word", " ", 
            "Output"}], ":", 
           RowBox[{
           "Association", " ", "with", " ", "keys", 
            " ", "\"\<Extendable\>\""}]}]}]}]}]}]}], 
     ",", "\"\<NonExtendable\>\"", ",", "\"\<Undecided\>\""}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fCheckExtendability", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fCheckExtendability", "[", 
      RowBox[{"words_List", ",", "extBound_Integer", ",", 
       RowBox[{"maxSteps_Integer", ":", "100000"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numWords", ",", "stride", ",", "wordLengths", ",", "flatInput", ",", 
         "flatResults", ",", "err"}], "}"}], ",", 
       RowBox[{
        RowBox[{"numWords", "=", 
         RowBox[{"Length", "[", "words", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"stride", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"StringLength", "/@", "words"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Prepare", " ", "Data"}], "*)"}], 
        RowBox[{"Print", "[", "\"\<Preparing data for GPU...\>\"", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"processedList", "=", 
         RowBox[{"stringToCudaInts", "/@", "words"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wordLengths", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Length", "/@", "processedList"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"flatInput", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"processedList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"stride", "-", 
                  RowBox[{"wordLengths", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "numWords"}], "}"}]}], "]"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"flatResults", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "numWords"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Run", " ", "GPU"}], "*)"}], 
        RowBox[{
        "Print", "[", "\"\<Running Backtracking Solver on GPU...\>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"err", "=", 
         RowBox[{"aa2fBacktrackLib", "[", 
          RowBox[{
          "flatInput", ",", "flatResults", ",", "wordLengths", ",", 
           "numWords", ",", "stride", ",", "extBound", ",", "maxSteps"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Sort", " ", "Results"}], "*)"}], 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Extendable\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "0"}], "]"}]}], ",", 
          RowBox[{"(*", 
           RowBox[{"Status", " ", "0"}], "*)"}], 
          RowBox[{"\"\<NonExtendable\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "1"}], "]"}]}], ",", 
          RowBox[{"(*", 
           RowBox[{"Status", " ", "1"}], "*)"}], 
          RowBox[{"\"\<Undecided\>\"", "->", 
