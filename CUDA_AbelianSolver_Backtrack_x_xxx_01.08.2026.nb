Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", "STEP"}]}], " ", "1"}], ":", "CONFIGURATION"}], "&"}], " ", 
     RowBox[{"PATHS", "--"}]}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- Configuring Backtracking Solver ---\>\"", "]"}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "PATHS", " ", 
     RowBox[{"(", 
      RowBox[{
      "Verify", " ", "these", " ", "match", " ", "your", " ", "system"}], 
      ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "cudaBinPath", 
     "=", "\"\<C:\\\\Program Files\\\\NVIDIA GPU Computing \
Toolkit\\\\CUDA\\\\v13.1\\\\bin\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nvccExe", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"cudaBinPath", ",", "\"\<nvcc.exe\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"mathIncPath", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "$InstallationDirectory", ",", "\"\<SystemFiles\>\"", 
        ",", "\"\<IncludeFiles\>\"", ",", "\"\<C\>\""}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "nvccExe", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<CRITICAL ERROR: nvcc.exe not found at: \>\"", ",", 
         "nvccExe"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Targeting NVCC: \>\"", ",", "nvccExe"}], "]"}], ";"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "2"}], ":", 
     RowBox[{
      RowBox[{"CUDA", " ", "BACKTRACKING", " ", 
       RowBox[{"KERNEL", "--"}]}], "-"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"This", " ", 
     RowBox[{"C", "++"}], " ", "code", " ", "implements", " ", "an", " ", 
     "iterative", " ", "DFS", " ", 
     RowBox[{"(", 
      RowBox[{"Depth", " ", "First", " ", "Search"}], ")"}], " ", "on", " ", 
     "the", " ", "GPU"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "cudaSource", 
     "=", "\"\<\n#include <cuda_runtime.h>\n#include <stdio.h>\n#include \
\\\"WolframLibrary.h\\\" \n\n// Value mapping for Parikh Trick: A=0, B=1, \
C=65536\n#define VAL_A 0\n#define VAL_B 1\n#define VAL_C 65536\n\n#define \
MAX_TOTAL_LEN 512 \n#define MAX_DEPTH 256\n\n__device__ bool \
check_left_edge(long long* buf, int start, int end) {\n    int len = end - \
start + 1;\n    int max_k = len / 2;\n    // FIX: Start k at 2 to allow 'aa' \
(Period 1) but forbid 'abab' (Period 2+)\n    for (int k = 2; k <= max_k; \
k++) {\n        long long sum_u = 0;\n        long long sum_v = 0;\n        \
for (int i = 0; i < k; i++) sum_u += buf[start + i];\n        for (int i = 0; \
i < k; i++) sum_v += buf[start + k + i];\n        if (sum_u == sum_v) return \
false;\n    }\n    return true;\n}\n\n__device__ bool check_right_edge(long \
long* buf, int start, int end) {\n    int len = end - start + 1;\n    int \
max_k = len / 2;\n    // FIX: Start k at 2 to allow 'aa' (Period 1) but \
forbid 'abab' (Period 2+)\n    for (int k = 2; k <= max_k; k++) {\n        \
long long sum_u = 0;\n        long long sum_v = 0;\n        for (int i = 0; i \
< k; i++) sum_v += buf[end - i];\n        for (int i = 0; i < k; i++) sum_u \
+= buf[end - k - i];\n        if (sum_u == sum_v) return false;\n    }\n    \
return true;\n}\n\n__global__ void backtrackKernel(\n    long long* \
input_flat, long long* results, long long* word_lengths, \n    int num_words, \
int stride, int extension_bound, long long max_steps,\n    long long p0, long \
long p1, long long p2 // Search Order Values\n) {\n    int idx = blockIdx.x * \
blockDim.x + threadIdx.x;\n    if (idx >= num_words) return;\n\n    // 1. \
Setup Local Workspace\n    long long buffer[MAX_TOTAL_LEN];\n    int \
stack_val[MAX_DEPTH]; \n\n    int base_len = (int)word_lengths[idx];\n    int \
start_ptr = MAX_TOTAL_LEN / 2 - base_len / 2;\n    int end_ptr = start_ptr + \
base_len - 1;\n\n    // Safety check for bounds\n    if (start_ptr < 0 || \
end_ptr >= MAX_TOTAL_LEN) {\n        results[idx] = -2; // Error: Word too \
long for buffer\n        return;\n    }\n\n    long long input_offset = idx * \
stride;\n    for (int i = 0; i < base_len; i++) {\n        buffer[start_ptr + \
i] = input_flat[input_offset + i];\n    }\n\n    int depth = 0;\n    \
stack_val[0] = -1; \n    long long steps = 0;\n    int status = 1; // \
Default: Non-Extendable\n\n    // 3. Search Loop\n    while (depth >= 0) {\n  \
      steps++;\n        if (steps > max_steps) {\n            status = 2; // \
Timeout\n            break;\n        }\n\n        // --- CLEANUP PREVIOUS \
ATTEMPT ---\n        int current_val = stack_val[depth];\n        if \
(current_val != -1) {\n             if (depth % 2 == 0) start_ptr++; // Undo \
Left\n             else end_ptr--;              // Undo Right\n        }\n\n  \
      // --- TRY NEXT VALUE ---\n        stack_val[depth]++;\n        int \
val_code = stack_val[depth];\n\n        // Exhausted?\n        if (val_code > \
2) {\n            stack_val[depth] = -1; // Reset for next entry\n            \
depth--;\n            continue; // Go up to handle depth-1\n        }\n\n     \
   // Apply Move based on Permutation Order\n        long long actual_val = \
p0;\n        if (val_code == 1) actual_val = p1;\n        if (val_code == 2) \
actual_val = p2;\n\n        bool valid = false;\n        \n        // Safety \
check for bounds before writing\n        if (start_ptr <= 0 || end_ptr >= \
MAX_TOTAL_LEN - 1) {\n             status = -3; // Error: Overflow\n          \
   break;\n        }\n\n        if (depth % 2 == 0) {\n            \
start_ptr--;\n            buffer[start_ptr] = actual_val;\n            valid \
= check_left_edge(buffer, start_ptr, end_ptr);\n        } else {\n            \
end_ptr++;\n            buffer[end_ptr] = actual_val;\n            valid = \
check_right_edge(buffer, start_ptr, end_ptr);\n        }\n\n        if \
(valid) {\n            // Reached target?\n            if (depth >= (2 * \
extension_bound - 1)) {\n                status = 0; // Success\n             \
   break;\n            }\n            // Go deeper\n            depth++;\n    \
        if (depth >= MAX_DEPTH) { status = -4; break; } // Error: Depth limit\
\n            stack_val[depth] = -1; \n        } \n    }\n\n    results[idx] \
= (long long)status;\n}\n\nextern \\\"C\\\" DLLEXPORT int \
solve_backtrack_entrypoint(WolframLibraryData libData, mint Argc, MArgument \
*Args, MArgument Res) {\n    MTensor inputT = MArgument_getMTensor(Args[0]);\n\
    MTensor resultsT = MArgument_getMTensor(Args[1]);\n    MTensor lengthsT = \
MArgument_getMTensor(Args[2]);\n    mint num_words = \
MArgument_getInteger(Args[3]);\n    mint stride = \
MArgument_getInteger(Args[4]);\n    mint ext_bound = \
MArgument_getInteger(Args[5]);\n    mint max_steps = \
MArgument_getInteger(Args[6]);\n    MTensor permT = \
MArgument_getMTensor(Args[7]); // Permutation Tensor\n\n    long long *input \
= (long long*)libData->MTensor_getIntegerData(inputT);\n    long long \
*results = (long long*)libData->MTensor_getIntegerData(resultsT);\n    long \
long *lengths = (long long*)libData->MTensor_getIntegerData(lengthsT);\n    \
long long *perm = (long long*)libData->MTensor_getIntegerData(permT);\n\n    \
long long *d_input, *d_lengths, *d_results;\n    cudaError_t err;\n    \n    \
size_t input_size = num_words * stride * sizeof(long long);\n    size_t \
results_size = num_words * sizeof(long long); \n    size_t lengths_size = \
num_words * sizeof(long long);\n\n    err = cudaMalloc(&d_input, input_size);\
\n    if(err != cudaSuccess) { MArgument_setInteger(Res, (mint)err); return \
LIBRARY_NO_ERROR; }\n    \n    err = cudaMalloc(&d_results, results_size);\n  \
  if(err != cudaSuccess) { MArgument_setInteger(Res, (mint)err); return \
LIBRARY_NO_ERROR; }\n    \n    err = cudaMalloc(&d_lengths, lengths_size);\n  \
  if(err != cudaSuccess) { MArgument_setInteger(Res, (mint)err); return \
LIBRARY_NO_ERROR; }\n\n    // Initialize Result Buffer to -1 (Detect Skipped \
Execution)\n    cudaMemset(d_results, -1, results_size);\n\n    \
cudaMemcpy(d_input, input, input_size, cudaMemcpyHostToDevice);\n    \
cudaMemcpy(d_lengths, lengths, lengths_size, cudaMemcpyHostToDevice);\n    \n \
   int blockSize = 128;\n    int gridSize = (int)((num_words + blockSize - 1) \
/ blockSize);\n    \n    backtrackKernel<<<gridSize, blockSize>>>(\n        \
d_input, d_results, d_lengths, \n        (int)num_words, (int)stride, \
(int)ext_bound, (long long)max_steps,\n        perm[0], perm[1], perm[2] // \
Pass Permutation\n    );\n\n    // Strict Error Checking\n    err = \
cudaGetLastError();\n    if(err != cudaSuccess) { MArgument_setInteger(Res, \
20000 + (mint)err); return LIBRARY_NO_ERROR; }\n\n    err = \
cudaDeviceSynchronize(); \n    if(err != cudaSuccess) { \
MArgument_setInteger(Res, 30000 + (mint)err); return LIBRARY_NO_ERROR; }\n\n  \
  cudaMemcpy(results, d_results, results_size, cudaMemcpyDeviceToHost);\n\n   \
 cudaFree(d_input);\n    cudaFree(d_results);\n    cudaFree(d_lengths);\n\n   \
 MArgument_setInteger(Res, 0); // Success\n    return LIBRARY_NO_ERROR;\n}\n\
\>\""}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "3"}], ":", 
     RowBox[{
      RowBox[{"COMPILE", "--"}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"workDir", "=", 
     RowBox[{"CreateDirectory", "[", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cuFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"workDir", ",", "\"\<backtrack.cu\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"dllFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"workDir", ",", "\"\<backtrack.dll\>\""}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"cuFile", ",", "cudaSource", ",", "\"\<String\>\""}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Setup", " ", "Host", " ", "Compiler"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"clPath", "=", "None"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"compilers", "=", 
     RowBox[{"CCompilers", "[", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "compilers", "]"}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"vsRoot", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"compilers", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<CompilerInstallation\>\"",
           ",", 
          RowBox[{
           RowBox[{"compilers", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           "[", "\"\<CompilerInstallation\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"candidates", "=", 
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<cl.exe\>\"", ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"vsRoot", ",", "\"\<VC\>\""}], "}"}], "]"}], ",", 
          "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"selected", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"candidates", ",", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"#", ",", "\"\<Hostx64\\\\x64\>\""}], "]"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "selected", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"clPath", "=", 
           RowBox[{"DirectoryName", "[", 
            RowBox[{"First", "[", "selected", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Found 64-bit cl.exe at: \>\"", ",", "clPath"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"originalPath", "=", 
           RowBox[{"Environment", "[", "\"\<PATH\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"SetEnvironment", "[", 
           RowBox[{"\"\<PATH\>\"", "->", 
            RowBox[{"clPath", "<>", "\"\<;\>\"", "<>", "originalPath"}]}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<WARNING: Could not find Hostx64\\\\x64\\\\cl.exe \
automatically.\>\"", "]"}], ";"}]}], "]"}]}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Run", " ", "Compilation"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cmd", "=", 
     RowBox[{"{", 
      RowBox[{
      "nvccExe", ",", "\"\<-shared\>\"", ",", "\"\<-O3\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_80,code=sm_80\>\"", 
       ",", "\"\<-gencode\>\"", ",", "\"\<arch=compute_120,code=sm_120\>\"", 
       ",", "\"\<-I\>\"", ",", "mathIncPath", ",", "\"\<-o\>\"", ",", 
       "dllFile", ",", "cuFile"}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Running NVCC Compilation...\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"proc", "=", 
     RowBox[{"RunProcess", "[", "cmd", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"proc", "[", "\"\<ExitCode\>\"", "]"}], "=!=", "0"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<COMPILATION FAILED!\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<STDOUT: \>\"", ",", 
         RowBox[{"proc", "[", "\"\<StandardOutput\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<STDERR: \>\"", ",", 
         RowBox[{"proc", "[", "\"\<StandardError\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<COMPILATION SUCCESSFUL! DLL: \>\"", ",", "dllFile"}], 
        "]"}], ";"}]}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "4"}], ":", 
     RowBox[{
      RowBox[{"MATHEMATICA", " ", 
       RowBox[{"WRAPPER", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Quiet", "[", 
     RowBox[{"LibraryFunctionUnload", "[", "aa2fBacktrackLib", "]"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"aa2fBacktrackLib", "=", 
     RowBox[{"LibraryFunctionLoad", "[", 
      RowBox[{"dllFile", ",", "\"\<solve_backtrack_entrypoint\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Shared\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}], ",", 
         "Integer", ",", "Integer", ",", "Integer", ",", "Integer", ",", 
         RowBox[{"{", 
          RowBox[{"Integer", ",", "1", ",", "\"\<Constant\>\""}], "}"}]}], 
        " ", 
        RowBox[{"(*", 
         RowBox[{"Perm", " ", "Tensor"}], "*)"}], "}"}], ",", "Integer"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"valMap", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<b\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<c\>\"", "->", "65536"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"stringToCudaInts", "[", "str_String", "]"}], ":=", 
     RowBox[{"Replace", "[", 
      RowBox[{
       RowBox[{"Characters", "[", "str", "]"}], ",", "valMap", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fCheckExtendability", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fCheckExtendability", "[", 
      RowBox[{"words_List", ",", "extBound_Integer", ",", 
       RowBox[{"maxSteps_Integer", ":", "100000"}], ",", 
       RowBox[{"searchOrder_List", ":", 
        RowBox[{"{", 
         RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}]}]}],
       "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numWords", ",", "stride", ",", "wordLengths", ",", "flatInput", ",", 
         "flatResults", ",", "err", ",", "permInts"}], "}"}], ",", 
       RowBox[{
        RowBox[{"numWords", "=", 
         RowBox[{"Length", "[", "words", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"stride", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"StringLength", "/@", "words"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"processedList", "=", 
         RowBox[{"stringToCudaInts", "/@", "words"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wordLengths", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Length", "/@", "processedList"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"flatInput", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"processedList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"stride", "-", 
                  RowBox[{"wordLengths", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "numWords"}], "}"}]}], "]"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"flatResults", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "numWords"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"permInts", "=", 
         RowBox[{"Developer`ToPackedArray", "[", 
          RowBox[{"Replace", "[", 
           RowBox[{"searchOrder", ",", "valMap", ",", 
            RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"err", "=", 
         RowBox[{"aa2fBacktrackLib", "[", 
          RowBox[{
          "flatInput", ",", "flatResults", ",", "wordLengths", ",", 
           "numWords", ",", "stride", ",", "extBound", ",", "maxSteps", ",", 
           "permInts"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"err", "=!=", "0"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<CRITICAL CUDA ERROR: \>\"", ",", "err"}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"err", ">", "30000"}], ",", 
             RowBox[{
             "Print", 
              "[", "\"\<Error type: Kernel Execution Failed (e.g. TDR/Timeout \
or Crash)\>\"", "]"}]}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Extendable\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "0"}], "]"}]}], ",", 
          RowBox[{"\"\<NonExtendable\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "1"}], "]"}]}], ",", 
          RowBox[{"\"\<Undecided\>\"", "->", 
           RowBox[{"Pick", "[", 
            RowBox[{"words", ",", "flatResults", ",", "2"}], "]"}]}]}], 
         "|>"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "6"}], ":", 
     RowBox[{
      RowBox[{"ITERATIVE", " ", "\"\<SIEVE\>\"", " ", 
       RowBox[{"SOLVER", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "aa2fSolveIterative", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"aa2fSolveIterative", "[", 
      RowBox[{
      "initialWords_List", ",", "extBound_Integer", ",", "stepSchedule_List", 
       ",", 
       RowBox[{"searchOrder_List", ":", 
        RowBox[{"{", 
         RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}]}]}],
       "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"currentWords", ",", "results", ",", 
         RowBox[{"totalExtendable", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"totalNonExtendable", "=", 
          RowBox[{"{", "}"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"currentWords", "=", "initialWords"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "currentWords", "]"}], "==", "0"}], ",", 
             RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<\\n--- Pass with MaxSteps = \>\"", ",", "stepLimit", 
             ",", "\"\< ---\>\""}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Processing \>\"", ",", 
             RowBox[{"Length", "[", "currentWords", "]"}], 
             ",", "\"\< words...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Run", " ", "Core", " ", "Solver"}], "*)"}], 
           RowBox[{"results", "=", 
            RowBox[{"aa2fCheckExtendability", "[", 
             RowBox[{
             "currentWords", ",", "extBound", ",", "stepLimit", ",", 
              "searchOrder"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Collect", " ", "Finished", " ", "Results"}], "*)"}], 
           RowBox[{"totalExtendable", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"totalExtendable", ",", 
              RowBox[{"results", "[", "\"\<Extendable\>\"", "]"}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"totalNonExtendable", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"totalNonExtendable", ",", 
              RowBox[{"results", "[", "\"\<NonExtendable\>\"", "]"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<  -> Extendable: \>\"", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"results", "[", "\"\<Extendable\>\"", "]"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<  -> NonExtendable: \>\"", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"results", "[", "\"\<NonExtendable\>\"", "]"}], "]"}]}],
             "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<  -> Undecided (Passed to next round): \>\"", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"results", "[", "\"\<Undecided\>\"", "]"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Prepare", " ", "for", " ", "next", " ", "pass"}], "*)"}], 
           RowBox[{"currentWords", "=", 
            RowBox[{"results", "[", "\"\<Undecided\>\"", "]"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"stepLimit", ",", "stepSchedule"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Final", " ", "Report"}], "*)"}], 
        RowBox[{
        "Print", "[", "\"\<\\n=== FINAL ITERATIVE RESULTS ===\>\"", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Total Extendable: \>\"", ",", 
          RowBox[{"Length", "[", "totalExtendable", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Total NonExtendable: \>\"", ",", 
          RowBox[{"Length", "[", "totalNonExtendable", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Remaining Undecided (Hardest): \>\"", ",", 
          RowBox[{"Length", "[", "currentWords", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Extendable\>\"", "->", "totalExtendable"}], ",", 
          RowBox[{"\"\<NonExtendable\>\"", "->", "totalNonExtendable"}], ",", 
          RowBox[{"\"\<Undecided\>\"", "->", "currentWords"}]}], "|>"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "STEP"}]}], " ", "7"}], ":", 
     RowBox[{
      RowBox[{"TEST", " ", "ITERATIVE", " ", 
       RowBox[{"SOLVER", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testWords", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<aaabaaacccbccaabbbaccbcc\>\"", 
       ",", "\"\<aabaaacabbbaacccbabbbcba\>\""}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"2", "nd", " ", "is", " ", "the", " ", "hard", " ", "one"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\nTesting Iterative Solver...\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Schedule", ":", 
      RowBox[{"First", " ", "try", " ", "fast", " ", 
       RowBox[{"(", 
        RowBox[{"100", "k"}], ")"}]}]}], ",", 
     RowBox[{"then", " ", "deep", " ", 
      RowBox[{"(", 
       RowBox[{"20", "M"}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"iterResult", "=", 
     RowBox[{"aa2fSolveIterative", "[", 
      RowBox[{"testWords", ",", "20", ",", 
       RowBox[{"{", 
        RowBox[{"100000", ",", "20000000"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.978778605636856*^9, 3.9787786056373596`*^9}, 
   3.992873182393896*^9},
 Background->RGBColor[
  0.14, 0.8, 0.14, 
   0.33],ExpressionUUID->"e0ec688e-6a65-6840-89bd-36ed2fad916f"]
}, Closed]],

Cell["\<\
You are very welcome! I am glad the file I/O and separate output logging look \
good to you.

You are now fully equipped to run this on the remote Linux machine. Here is a \
quick \[OpenCurlyDoubleQuote]Cheat Sheet\[CloseCurlyDoubleQuote] for when you \
switch to your terminal:

1. Create the file:

Bash
nano solve_abelian.cu
# Paste the code, then: Enter (confirm name) -> Ctrl+O (Save) -> Ctrl+X (Exit)
2. Compile (targeting Hopper/Blackwell):

Bash
nvcc -O3 -arch=sm_90 -o solver solve_abelian.cu
3. Run:

Bash
./solver my_words.txt
4. Check Results:

Bash
wc -l extendable.txt       # Count lines
head non_extendable.txt    # See first few bad words
5. Copy results back to Windows (run this in Windows CMD):

DOS
scp username@remote_host:~/non_extendable.txt C:\\Users\\Veikko\\Desktop\\
Good luck with the B200! Processing 500,000 words on that hardware should be \
incredibly fast. Let me know if you discover anything interesting in the \
results!\
\>", "Text",
 CellChangeTimes->{
  3.9787862205218773`*^9},ExpressionUUID->"7780eb34-c8b0-8a43-9a2e-\
1c04e5917d62"],

