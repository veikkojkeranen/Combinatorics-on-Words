9c644500127c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<CUDALink`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], ";"}]}], "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"701c639c-d5d6-5f46-adec-45067494994b"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"2.", " ", "PREPARE", " ", "COMPILATION", " ", "ENVIRONMENT"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NVCC", " ", 
    RowBox[{"needs", "'"}], 
    RowBox[{"cl", ".", 
     RowBox[{"exe", "'"}]}], " ", 
    RowBox[{"(", 
     RowBox[{"Visual", " ", "Studio"}], ")"}], " ", "in", " ", "the", " ", 
    RowBox[{"path", "."}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"We", " ", "specifically", " ", "want", " ", "the", " ", "64"}], 
     "-", 
     RowBox[{"bit", " ", "host"}]}], ",", 
    RowBox[{"64", "-", 
     RowBox[{"bit", " ", "target", " ", 
      RowBox[{"compiler", ":", 
       RowBox[{"Hostx64", "\\", "x64"}]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clPath", "=", "None"}], ";", "\n", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "compilers", "]"}], ">", "0"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Get", " ", "VS", " ", "Root"}], ",", 
        RowBox[{"e", ".", "g", ".", 
         RowBox[{"C", ":", 
          RowBox[{
           RowBox[{"\\", "Program"}], " ", 
           RowBox[{"Files", "\\", "Microsoft"}], " ", "Visual", " ", 
           RowBox[{"Studio\\2022", "\\", "Community"}]}]}]}]}], "*)"}], 
      RowBox[{
       RowBox[{"vsRoot", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"compilers", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<CompilerInstallation\>\"",
           ",", 
          RowBox[{
           RowBox[{"compilers", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           "[", "\"\<CompilerInstallation\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Manually", " ", "construct", " ", "the", " ", "path", " ", "to", " ", 
         RowBox[{"Hostx64", "\\", "x64"}], " ", "to", " ", "ensure", " ", 
         "we", " ", "get", " ", "the", " ", "right", " ", "one"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"We", " ", "search", " ", "for", " ", 
         RowBox[{"cl", ".", "exe"}], " ", "inside", " ", "the", " ", "VC", " ",
          "folder"}], "*)"}], 
       RowBox[{"candidates", "=", 
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<cl.exe\>\"", ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"vsRoot", ",", "\"\<VC\>\""}], "}"}], "]"}], ",", 
          "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Filter", " ", "for", " ", "the", " ", "specific", " ", 
         "architecture", " ", "path"}], "*)"}], 
       RowBox[{"selected", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"candidates", ",", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"#", ",", "\"\<Hostx64\\\\x64\>\""}], "]"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "selected", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"clPath", "=", 
           RowBox[{"DirectoryName", "[", 
            RowBox[{"First", "[", "selected", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Found 64-bit cl.exe at: \>\"", ",", "clPath"}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"originalPath", "=", 
           RowBox[{"Environment", "[", "\"\<PATH\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"SetEnvironment", "[", 
           RowBox[{"\"\<PATH\>\"", "->", 
            RowBox[{"clPath", "<>", "\"\<;\>\"", "<>", "originalPath"}]}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<WARNING: Could not automatically find \
Hostx64\\\\x64\\\\cl.exe.\>\"", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
          "Print", 
           "[", "\"\<Please manually set 'clPath' to the directory containing \
the 64-bit cl.exe.\>\"", "]"}], ";"}]}], "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "*)"}]}]], "Input",
 CellChangeTimes->{
