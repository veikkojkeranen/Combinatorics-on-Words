  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nInput Examples: \>\"", ",", 
      RowBox[{"Take", "[", 
       RowBox[{"testData", ",", 
        RowBox[{"UpTo", "[", "3", "]"}]}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
