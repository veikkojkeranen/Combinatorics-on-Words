Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{"{", 
   RowBox[{"0.0735359`", ",", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\"\<Extendable\>\"", "\[Rule]", 
       RowBox[{"{", "}"}]}], ",", 
